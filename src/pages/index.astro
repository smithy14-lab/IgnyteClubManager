---
import AppLayout from '../layouts/AppLayout.astro';
import IgnyteMark from '../components/IgnyteMark.astro';
---

<AppLayout title="Sign in" chrome={false}>
  <div class="max-w-sm mx-auto mt-10">
    <div class="text-center mb-6">
      <IgnyteMark size={52} />
      <h1 class="text-2xl mt-3">Ignyte <span class="ignite-text">1-2-1</span></h1>
      <p class="text-sm text-mist-400 mt-1">Private lessons, booked in seconds.</p>
    </div>
    <form id="login" class="surface-card p-6 flex flex-col gap-4">
      <div>
        <label class="form-label" for="email">Email</label>
        <input class="field" id="email" type="email" autocomplete="email" required />
      </div>
      <div>
        <label class="form-label" for="pw">Password</label>
        <input class="field" id="pw" type="password" autocomplete="current-password" required />
      </div>
      <button class="btn btn-primary" type="submit" id="go">Sign in</button>
      <button class="text-xs text-mist-500 hover:text-ignite-400" type="button" id="forgot">Forgotten your password?</button>
    </form>
    <p class="text-sm text-center text-mist-400 mt-5">New here? <a href="/signup" class="text-ignite-400 font-semibold">Create an account</a></p>
  </div>

  <script>
    import { supabase } from '../lib/supabase';
    import { toast, errMsg } from '../lib/app';

    const next = new URLSearchParams(location.search).get('next') || '/dashboard';
    const email = document.getElementById('email') as HTMLInputElement;
    const pw = document.getElementById('pw') as HTMLInputElement;

    supabase.auth.getSession().then(({ data }) => {
      if (data.session) location.href = next;
    });

    (document.getElementById('login') as HTMLFormElement).addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('go') as HTMLButtonElement;
      btn.disabled = true;
      const { error } = await supabase.auth.signInWithPassword({ email: email.value.trim(), password: pw.value });
      btn.disabled = false;
      if (error) return toast(errMsg(error), 'err');
      location.href = next;
    });

    document.getElementById('forgot')!.addEventListener('click', async () => {
      if (!email.value) return toast('Type your email first, then tap this again.', 'err');
      const { error } = await supabase.auth.resetPasswordForEmail(email.value.trim(), { redirectTo: location.origin + '/dashboard' });
      toast(error ? errMsg(error) : 'Check your email for a reset link.', error ? 'err' : 'ok');
    });
  </script>
</AppLayout>
