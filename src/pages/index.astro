---
import AppLayout from '../layouts/AppLayout.astro';
import IgnyteMark from '../components/IgnyteMark.astro';
---

<AppLayout title="Welcome" chrome={false}>
  <section class="min-h-[80dvh] flex flex-col items-center justify-center text-center animate-rise">
    <IgnyteMark size={72} />
    <h1 class="mt-6 text-headline">
      Ignyte <span class="ignite-text">Club Manager</span>
    </h1>
    <p class="mt-4 max-w-md text-mist-400">
      Book 1-2-1 private lessons, track tumble &amp; all-star dance skill progression, and manage
      your club — all in one place.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/login" class="btn btn-primary">Sign in</a>
      <a href="/signup" class="btn btn-ghost">Create an account</a>
    </div>
    <p class="mt-10 text-xs text-mist-500">
      Works offline · Installable from your browser · Free
    </p>
  </section>

  <script>
    import { supabase, supabaseConfigured } from '../lib/supabase';
    // Signed-in visitors land straight on their dashboard.
    if (supabaseConfigured) {
      supabase.auth.getSession().then(({ data }) => {
        if (data.session) location.href = '/dashboard';
      });
    }
  </script>
</AppLayout>
