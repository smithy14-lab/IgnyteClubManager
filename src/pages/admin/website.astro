---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Website · Admin">
  <p class="eyebrow">Club admin</p>
  <div class="flex items-center justify-between gap-2 mt-1 mb-1">
    <h1 class="text-2xl">Your club website</h1>
    <a href="/admin" class="btn btn-ghost btn-sm">← Admin</a>
  </div>
  <p class="text-sm text-mist-400 mb-5 max-w-2xl">
    A real website at your club link — your pages plus the live class timetable, coach list
    and an enquiry form that lands right here. Write pages in simple text:
    <code># heading</code>, <code>**bold**</code>, <code>- lists</code>.
  </p>

  <div id="content"><p class="text-mist-500 text-sm">Loading…</p></div>

  <script>
    import { supabase } from '../../lib/supabase';
    import { requireAuth, esc, toast, errMsg, fmtDateTime, type AuthCtx } from '../../lib/app';

    const content = document.getElementById('content')!;
    let ctx: AuthCtx;

    async function render() {
      const club = ctx.club!;
      const [{ data: pages }, { data: enquiries }, { data: clubRow }, { data: waiverSettings }, { data: sigs }] = await Promise.all([
        supabase.from('club_pages').select('*').eq('club_id', club.id).order('sort').order('title'),
        supabase.from('club_enquiries').select('*').eq('club_id', club.id).order('created_at', { ascending: false }).limit(40),
        supabase.from('clubs').select('custom_domain, custom_domain_status, mailbox_alias, starter_status').eq('id', club.id).single(),
        supabase.from('club_settings').select('waiver_text, waiver_updated_at, open_join').eq('club_id', club.id).single(),
        supabase.from('waiver_signatures').select('signed_name, signed_at, waiver_version').eq('club_id', club.id).order('signed_at', { ascending: false }).limit(200),
      ]);
      const currentSigs = (sigs ?? []).filter((s) => s.waiver_version === waiverSettings?.waiver_updated_at);

      type Blk = Record<string, unknown> & { type: string };
      const BLOCK_TYPES: [string, string][] = [
        ['hero', '🎯 Hero (headline + photo + button)'],
        ['text', '📝 Text'],
        ['image', '🖼️ Photo'],
        ['image_text', '🖼️📝 Photo + text'],
        ['gallery', '🎞️ Gallery'],
        ['cta', '🔘 Button'],
        ['timetable', '🤸 Live class timetable'],
        ['coaches', '👥 Live coach list'],
        ['events', '🎪 Live events'],
        ['shop', '🛍️ Live shop'],
        ['contact', '📬 Enquiry form'],
      ];
      const LIVE = ['timetable', 'coaches', 'events', 'shop', 'contact'];
      const blockFields = (b: Blk) => {
        const v = (k: string) => esc(String(b[k] ?? ''));
        if (LIVE.includes(b.type)) return '<p class="text-xs text-mist-500">Live section — always shows your current club data. Nothing to edit.</p>';
        switch (b.type) {
          case 'hero':
            return `<input class="field mb-1.5" data-bf="heading" value="${v('heading')}" placeholder="Big headline" />
              <input class="field mb-1.5" data-bf="sub" value="${v('sub')}" placeholder="Supporting line" />
              <input class="field mb-1.5" data-bf="url" value="${v('url')}" placeholder="https:// photo (upload above, paste link)" />
              <div class="grid grid-cols-2 gap-1.5">
                <input class="field" data-bf="cta_label" value="${v('cta_label')}" placeholder="Button text e.g. Join us" />
                <input class="field" data-bf="cta_page" value="${v('cta_page')}" placeholder="goes to: join / classes / contact" />
              </div>`;
          case 'text':
            return `<textarea class="field" data-bf="md" rows="4" placeholder="# Heading&#10;Your text — **bold**, - lists, ![photo](link)">${v('md')}</textarea>`;
          case 'image':
            return `<input class="field mb-1.5" data-bf="url" value="${v('url')}" placeholder="https:// photo link" />
              <input class="field" data-bf="caption" value="${v('caption')}" placeholder="Caption (optional)" />`;
          case 'image_text':
            return `<input class="field mb-1.5" data-bf="url" value="${v('url')}" placeholder="https:// photo link" />
              <textarea class="field mb-1.5" data-bf="md" rows="3" placeholder="Text beside the photo">${v('md')}</textarea>
              <label class="text-xs text-mist-300 flex gap-1.5"><input type="checkbox" data-bf="side" ${b.side === 'right' ? 'checked' : ''} /> photo on the right</label>`;
          case 'gallery':
            return `<textarea class="field" data-bf="images" rows="3" placeholder="One https:// photo link per line">${esc(((b.images as string[]) ?? []).join('\n'))}</textarea>`;
          case 'cta':
            return `<div class="grid grid-cols-2 gap-1.5">
              <input class="field" data-bf="label" value="${v('label')}" placeholder="Button text" />
              <input class="field" data-bf="page" value="${v('page')}" placeholder="goes to: join / classes / shop" />
            </div>`;
          default:
            return '';
        }
      };
      const blockCard = (b: Blk, i: number) => `
        <div class="border border-ink-700 rounded-lg p-3 mb-2" data-block="${i}">
          <div class="flex items-center justify-between gap-2 mb-2">
            <p class="text-xs font-semibold text-mist-300">${esc(BLOCK_TYPES.find(([t]) => t === b.type)?.[1] ?? b.type)}</p>
            <div class="flex gap-1">
              <button class="btn btn-ghost btn-sm" data-bmove="${i}:-1" title="Move up">↑</button>
              <button class="btn btn-ghost btn-sm" data-bmove="${i}:1" title="Move down">↓</button>
              <button class="btn btn-ghost btn-sm" data-bdel="${i}" title="Remove">✕</button>
            </div>
          </div>
          ${blockFields(b)}
        </div>`;

      const pageCard = (p?: { id?: string; slug?: string; title?: string; body?: string; sort?: number; published?: boolean; blocks?: Blk[] | null }) => {
        const blocks: Blk[] = (p?.blocks as Blk[]) ?? (p?.body ? [{ type: 'text', md: p.body }] : []);
        return `
        <div class="surface-card p-5 mb-4" data-pagecard="${p?.slug ?? ''}" data-blocks='${esc(JSON.stringify(blocks))}'>
          <div class="grid gap-2 sm:grid-cols-3">
            <input class="field" data-f="title" value="${esc(p?.title ?? '')}" placeholder="Page title e.g. About us" />
            <input class="field" data-f="slug" value="${esc(p?.slug ?? '')}" placeholder="address: about, teams… or home" ${p ? 'disabled' : ''} />
            <div class="flex gap-2 items-center">
              <input class="field !w-20" data-f="sort" type="number" value="${p?.sort ?? 0}" title="order" />
              <label class="text-xs text-mist-300 flex gap-1.5 items-center"><input type="checkbox" data-f="published" ${p?.published !== false ? 'checked' : ''} /> live</label>
            </div>
          </div>
          <div class="mt-3" data-blockhost></div>
          <div class="flex flex-wrap gap-1.5 mt-2 items-center">
            <select class="field !w-auto !py-1 !text-xs" data-f="newblock">
              ${BLOCK_TYPES.map(([t, l]) => `<option value="${t}">${l}</option>`).join('')}
            </select>
            <button class="btn btn-ghost btn-sm" data-badd>+ Add section</button>
          </div>
          <div class="flex gap-2 mt-3 pt-3 border-t border-ink-700">
            <button class="btn btn-primary btn-sm" data-save="${p?.slug ?? ''}">${p ? 'Save page' : 'Add page'}</button>
            ${p ? `<button class="btn btn-danger btn-sm" data-del="${p.slug}">Delete</button>` : ''}
          </div>
          <p class="text-xs text-mist-500 mt-2">Tip: name a page <b>home</b> to design your site's front page yourself.</p>
        </div>`;
      };

      content.innerHTML = `
        <div class="surface-card p-5 mb-5 flex flex-wrap items-center justify-between gap-2">
          <div>
            <p class="text-sm font-semibold">Your site is at <a class="text-ignite-400 underline" target="_blank" rel="noopener" href="/c/${esc(club.slug)}">/c/${esc(club.slug)}</a></p>
            <p class="text-xs text-mist-500 mt-1">Home, Classes, Contact and coach list are built in — your pages appear in the menu automatically. Branding colours come from Admin → Branding.</p>
          </div>
          <a class="btn btn-ghost btn-sm" target="_blank" rel="noopener" href="/c/${esc(club.slug)}">Preview ↗</a>
        </div>

        <div class="surface-card p-5 mb-5">
          <p class="text-sm font-semibold">🌐 Your own domain &amp; mailbox
            ${clubRow?.custom_domain ? `<span class="pill ${clubRow.custom_domain_status === 'live' ? 'pill-success' : 'pill-warn'}">${esc(clubRow.custom_domain)} · ${clubRow.custom_domain_status}</span>` : '<span class="pill">Website Pro / Club plan</span>'}</p>
          ${
            clubRow?.custom_domain
              ? `<p class="text-xs text-mist-500 mt-1.5">${clubRow.custom_domain_status === 'live' ? `Your site answers at <b>https://${esc(clubRow.custom_domain)}</b>${clubRow.mailbox_alias ? ` and mail to <b>${esc(clubRow.mailbox_alias)}@${esc(clubRow.custom_domain)}</b> reaches you` : ''}. 🎉` : 'Requested — Ignyte is wiring it up. You\'ll be told the DNS records to set at your registrar.'}</p>`
              : `<p class="text-xs text-mist-500 mt-1.5 mb-2">Run this site at your own address (e.g. <b>yourclub.co.uk</b>) with a club mailbox (e.g. <b>hello@yourclub.co.uk</b>). You buy the domain (~£10/yr at any registrar); we do the rest.</p>
                <div class="flex flex-wrap gap-2">
                  <input class="field !w-auto flex-1" id="dom-name" placeholder="yourclub.co.uk" />
                  <input class="field !w-32" id="dom-mail" placeholder="hello" title="mailbox name" />
                  <button class="btn btn-primary btn-sm" id="dom-go">Request domain</button>
                </div>`
          }
        </div>

        <div class="surface-card p-5 mb-5">
          <p class="text-sm font-semibold">🚀 Starter Package — £299 one-off
            ${clubRow?.starter_status ? `<span class="pill ${clubRow.starter_status === 'done' ? 'pill-success' : 'pill-accent'}">${clubRow.starter_status.replace('_', ' ')}</span>` : ''}</p>
          ${
            clubRow?.starter_status
              ? `<p class="text-xs text-mist-500 mt-1.5">${clubRow.starter_status === 'done' ? 'All set up — website, payments and people are live. 🎉' : 'Ignyte is building your setup — we\'ll be in touch at your club contact email.'}</p>`
              : `<p class="text-xs text-mist-500 mt-1.5 mb-2">We do the whole setup with you: website built, domain & mailbox wired, Stripe connected, and your coaches, families & sessions migrated from your old system.</p>
                 <button class="btn btn-primary btn-sm" id="starter-go">Request the Starter Package</button>`
          }
        </div>

        <div class="surface-card p-5 mb-5">
          <p class="text-sm font-semibold mb-1">🚪 Your front door</p>
          <p class="text-xs text-mist-500 mb-2">
            Families join at <b>/c/${esc(club.slug)}/join</b> and sign in at <b>/c/${esc(club.slug)}/login</b> —
            both carry your branding (and work on your own domain as /join and /login).
            The club code${(ctx.club as unknown as { join_code?: string }).join_code ? '' : ''} still works as a fallback for posters.
          </p>
          <label class="text-xs text-mist-300 flex gap-2 items-center">
            <input type="checkbox" id="oj-toggle" ${waiverSettings?.open_join !== false ? 'checked' : ''} />
            Instant joining — link sign-ups are members immediately (untick to approve each one in People)
          </label>
        </div>

        <div class="surface-card p-5 mb-5">
          <p class="text-sm font-semibold mb-1">📜 Waiver &amp; consent
            ${waiverSettings?.waiver_updated_at ? `<span class="pill pill-success">${currentSigs.length} signed this version</span>` : '<span class="pill">not set</span>'}</p>
          <p class="text-xs text-mist-500 mb-2">Members sign by typing their name. Changing the text asks everyone to re-sign (they're notified).</p>
          <textarea class="field" id="wv-text" rows="4" placeholder="Your terms, photo consent, code of conduct…">${esc(waiverSettings?.waiver_text ?? '')}</textarea>
          <div class="flex items-center gap-2 mt-2 flex-wrap">
            <button class="btn btn-primary btn-sm" id="wv-save">Publish waiver</button>
            ${currentSigs.length ? `<span class="text-xs text-mist-500">Latest: ${currentSigs.slice(0, 5).map((s) => esc(s.signed_name)).join(', ')}${currentSigs.length > 5 ? '…' : ''}</span>` : ''}
          </div>
        </div>

        <div class="surface-card p-5 mb-5">
          <p class="text-sm font-semibold mb-1">🖼️ Images</p>
          <p class="text-xs text-mist-500 mb-2">Upload a photo, get a link — paste it into pages as <code>![photo](link)</code> or into shop items.</p>
          <div class="flex items-center gap-2 flex-wrap">
            <input type="file" id="img-file" accept="image/*" class="text-xs text-mist-400" />
            <button class="btn btn-ghost btn-sm" id="img-up">Upload</button>
            <input class="field flex-1" id="img-url" readonly placeholder="Your image link appears here" />
          </div>
        </div>

        <div class="grid gap-5 lg:grid-cols-2 items-start">
          <div>
            <h2 class="text-base font-semibold mb-3">📄 Pages</h2>
            ${(pages ?? []).map((p) => pageCard(p)).join('')}
            <h3 class="text-sm font-semibold mb-2 mt-5 text-mist-300">Add a page</h3>
            ${pageCard()}
          </div>
          <div>
            <h2 class="text-base font-semibold mb-3">📬 Enquiries</h2>
            ${
              (enquiries ?? []).length
                ? (enquiries ?? [])
                    .map(
                      (e) => `
                <div class="surface-card p-4 mb-3">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <p class="text-sm font-semibold">${esc(e.name)} <a class="text-xs text-ignite-400" href="mailto:${esc(e.email)}">${esc(e.email)}</a></p>
                    <span class="pill ${e.status === 'new' ? 'pill-accent' : e.status === 'contacted' ? 'pill-warn' : ''}">${e.status}</span>
                  </div>
                  ${e.message ? `<p class="text-xs text-mist-400 mt-1.5">${esc(e.message)}</p>` : ''}
                  <p class="text-xs text-mist-500 mt-1">${fmtDateTime(e.created_at)}</p>
                  ${
                    e.status !== 'closed'
                      ? `<div class="mt-2 flex gap-1.5">
                          ${e.status === 'new' ? `<button class="btn btn-ghost btn-sm" data-enq="contacted:${e.id}">Mark contacted</button>` : ''}
                          <button class="btn btn-ghost btn-sm" data-enq="closed:${e.id}">Close</button>
                        </div>`
                      : ''
                  }
                </div>`
                    )
                    .join('')
                : '<p class="text-sm text-mist-500">No enquiries yet — they arrive from the Contact page on your site.</p>'
            }
          </div>
        </div>`;

      document.getElementById('oj-toggle')?.addEventListener('change', async (ev) => {
        const on = (ev.target as HTMLInputElement).checked;
        const { error } = await supabase.rpc('set_open_join', { p_club: club.id, p_open: on });
        if (error) return toast(errMsg(error), 'err');
        toast(on ? 'Instant joining on.' : 'Approval mode on — new sign-ups wait in Admin → People.');
      });
      document.getElementById('wv-save')?.addEventListener('click', async () => {
        const text = (document.getElementById('wv-text') as HTMLTextAreaElement).value;
        if (text.trim() && !confirm('Publish this waiver? Every family will be asked to sign it.')) return;
        const { error } = await supabase.rpc('update_club_waiver', { p_club: club.id, p_text: text });
        if (error) return toast(errMsg(error), 'err');
        toast(text.trim() ? 'Waiver published — members notified to sign.' : 'Waiver removed.');
        render();
      });
      document.getElementById('img-up')?.addEventListener('click', async () => {
        const file = (document.getElementById('img-file') as HTMLInputElement).files?.[0];
        if (!file) return toast('Pick an image first.', 'err');
        if (file.size > 4 * 1024 * 1024) return toast('Keep images under 4MB.', 'err');
        const path = `${club.id}/site/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.-]/g, '_')}`;
        const { error } = await supabase.storage.from('club-media').upload(path, file, { upsert: false });
        if (error) return toast(errMsg(error), 'err');
        const { data: pub } = supabase.storage.from('club-media').getPublicUrl(path);
        (document.getElementById('img-url') as HTMLInputElement).value = pub.publicUrl;
        toast('Uploaded — link ready to copy. 🖼️');
      });
      document.getElementById('starter-go')?.addEventListener('click', async () => {
        if (!confirm('Request the £299 Starter Package? Ignyte will contact you to kick off — payment is arranged directly, nothing is charged here.')) return;
        const { error } = await supabase.rpc('request_starter_package', { p_club: club.id });
        if (error) return toast(errMsg(error), 'err');
        toast('Requested! Ignyte will be in touch. 🚀');
        render();
      });
      document.getElementById('dom-go')?.addEventListener('click', async () => {
        const domain = (document.getElementById('dom-name') as HTMLInputElement).value.trim();
        const mail = (document.getElementById('dom-mail') as HTMLInputElement).value.trim();
        if (!domain) return toast('Enter your domain first.', 'err');
        const { error } = await supabase.rpc('admin_request_domain', { p_club: club.id, p_domain: domain, p_mailbox: mail || null });
        if (error) return toast(errMsg(error), 'err');
        toast('Requested — Ignyte will wire it up and let you know the DNS records. 🌐');
        render();
      });
      // ---- section builder wiring ----
      const cardState = new Map<Element, Blk[]>();
      const readBlocksFromDom = (card: Element): Blk[] => {
        const state = cardState.get(card) ?? [];
        return [...card.querySelectorAll('[data-block]')].map((el, i) => {
          const b: Blk = { type: state[i]?.type ?? 'text' };
          el.querySelectorAll<HTMLInputElement>('[data-bf]').forEach((inp) => {
            const k = inp.dataset.bf!;
            if (k === 'side') b.side = inp.checked ? 'right' : 'left';
            else if (k === 'images') b.images = inp.value.split('\n').map((s) => s.trim()).filter(Boolean);
            else b[k] = inp.value;
          });
          return b;
        });
      };
      const renderHost = (card: Element) => {
        const host = card.querySelector('[data-blockhost]')!;
        const blocks = cardState.get(card) ?? [];
        host.innerHTML = blocks.length
          ? blocks.map((b, i) => blockCard(b, i)).join('')
          : '<p class="text-xs text-mist-500">No sections yet — add your first one below.</p>';
        host.querySelectorAll<HTMLButtonElement>('[data-bmove]').forEach((mb) =>
          mb.addEventListener('click', () => {
            const [i, d] = mb.dataset.bmove!.split(':').map(Number);
            const bl = readBlocksFromDom(card);
            const j = i + d;
            if (j < 0 || j >= bl.length) return;
            [bl[i], bl[j]] = [bl[j], bl[i]];
            cardState.set(card, bl);
            renderHost(card);
          })
        );
        host.querySelectorAll<HTMLButtonElement>('[data-bdel]').forEach((db) =>
          db.addEventListener('click', () => {
            const bl = readBlocksFromDom(card);
            bl.splice(Number(db.dataset.bdel), 1);
            cardState.set(card, bl);
            renderHost(card);
          })
        );
      };
      content.querySelectorAll('[data-pagecard]').forEach((card) => {
        try {
          cardState.set(card, JSON.parse((card as HTMLElement).dataset.blocks || '[]'));
        } catch {
          cardState.set(card, []);
        }
        renderHost(card);
        card.querySelector('[data-badd]')?.addEventListener('click', () => {
          const bl = readBlocksFromDom(card);
          bl.push({ type: (card.querySelector('[data-f="newblock"]') as HTMLSelectElement).value } as Blk);
          cardState.set(card, bl);
          renderHost(card);
        });
      });

      content.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((b) =>
        b.addEventListener('click', async () => {
          const card = b.closest('[data-pagecard]')!;
          const f = (n: string) => card.querySelector(`[data-f="${n}"]`) as HTMLInputElement;
          const blocks = readBlocksFromDom(card);
          const { error } = await supabase.rpc('save_club_page', {
            p_club: club.id,
            p_slug: b.dataset.save || f('slug').value.trim().toLowerCase(),
            p_title: f('title').value.trim(),
            p_body: '',
            p_sort: Number(f('sort').value || 0),
            p_published: f('published').checked,
            p_blocks: blocks,
          });
          if (error) return toast(errMsg(error), 'err');
          toast("Page saved — it's live on your site.");
          render();
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-del]').forEach((b) =>
        b.addEventListener('click', async () => {
          if (!confirm('Delete this page from your site?')) return;
          const { error } = await supabase.rpc('delete_club_page', { p_club: club.id, p_slug: b.dataset.del });
          if (error) return toast(errMsg(error), 'err');
          render();
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-enq]').forEach((b) =>
        b.addEventListener('click', async () => {
          const [status, id] = b.dataset.enq!.split(':');
          const { error } = await supabase.from('club_enquiries').update({ status }).eq('id', id);
          if (error) return toast(errMsg(error), 'err');
          render();
        })
      );
    }

    (async () => {
      ctx = await requireAuth(['admin']);
      await render();
    })().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
