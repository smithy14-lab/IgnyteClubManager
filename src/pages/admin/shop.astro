---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Shop · Admin">
  <p class="eyebrow">Club admin</p>
  <div class="flex items-center justify-between gap-2 mt-1 mb-1">
    <h1 class="text-2xl">Club shop</h1>
    <a href="/admin" class="btn btn-ghost btn-sm">← Admin</a>
  </div>
  <p class="text-sm text-mist-400 mb-5 max-w-2xl">
    Kit, uniforms, merch. Orders land here and on your website's Shop page. With online
    payments on, every order invoices itself; otherwise families pay at the desk and you
    mark orders paid.
  </p>
  <div id="content"><p class="text-mist-500 text-sm">Loading…</p></div>

  <script>
    import { supabase } from '../../lib/supabase';
    import { requireAuth, esc, toast, errMsg, fmtDate, type AuthCtx } from '../../lib/app';

    const content = document.getElementById('content')!;
    let ctx: AuthCtx;
    let sym = '£';
    const pill: Record<string, string> = {
      pending: 'pill pill-warn', paid: 'pill pill-success', collected: 'pill', cancelled: 'pill',
    };

    function productForm(p?: { id?: string; name?: string; description?: string | null; price?: number; options?: string[]; image_url?: string | null; stock?: number | null; active?: boolean; sort?: number }) {
      return `
      <div class="grid gap-2 sm:grid-cols-3">
        <input class="field" data-f="name" value="${esc(p?.name ?? '')}" placeholder="Item e.g. Club Hoodie" />
        <input class="field" data-f="price" type="number" step="0.5" min="0" value="${p?.price ?? ''}" placeholder="${sym} price" />
        <input class="field" data-f="stock" type="number" min="0" value="${p?.stock ?? ''}" placeholder="Stock (blank = untracked)" />
        <input class="field sm:col-span-2" data-f="options" value="${esc((p?.options ?? []).join(', '))}" placeholder="Sizes/options, comma-separated (Age 5-6, Adult S…)" />
        <div class="flex items-center gap-2">
          <input class="field !w-16" data-f="sort" type="number" value="${p?.sort ?? 0}" title="order" />
          <label class="text-xs text-mist-300 flex gap-1.5 items-center"><input type="checkbox" data-f="active" ${p?.active !== false ? 'checked' : ''} /> on sale</label>
        </div>
        <div class="sm:col-span-2 flex gap-2 items-center">
          <input class="field flex-1" data-f="image" value="${esc(p?.image_url ?? '')}" placeholder="https:// image link (optional)" />
          <input type="file" data-f="imgfile" accept="image/*" class="hidden" />
          <button class="btn btn-ghost btn-sm" data-upload>📷</button>
        </div>
        <input class="field" data-f="description" value="${esc(p?.description ?? '')}" placeholder="Short description" />
      </div>
      <button class="btn btn-primary btn-sm mt-2" data-saveprod="${p?.id ?? ''}">${p ? 'Save item' : 'Add item'}</button>`;
    }

    async function render() {
      const club = ctx.club!;
      const [{ data: products }, { data: orders }, { data: settings }, { data: members }] = await Promise.all([
        supabase.from('shop_products').select('*').eq('club_id', club.id).order('sort').order('name'),
        supabase.from('shop_orders').select('*').eq('club_id', club.id).neq('status', 'cancelled').order('created_at', { ascending: false }).limit(80),
        supabase.from('club_settings').select('currency').eq('club_id', club.id).single(),
        supabase.from('club_members').select('profile_id, profiles(full_name)').eq('club_id', club.id),
      ]);
      sym = settings?.currency ?? '£';
      const money = (n: unknown) => sym + Number(n).toFixed(2);
      const names = Object.fromEntries((members ?? []).map((m) => [m.profile_id, (m.profiles as unknown as { full_name: string })?.full_name ?? '?']));
      const open = (orders ?? []).filter((o) => o.status !== 'collected');
      const done = (orders ?? []).filter((o) => o.status === 'collected');

      content.innerHTML = `
        <div class="grid gap-5 lg:grid-cols-2 items-start">
          <div>
            <h2 class="text-base font-semibold mb-3">🛍️ Items</h2>
            ${(products ?? [])
              .map(
                (p) => `
              <div class="surface-card p-5 mb-4 ${p.active ? '' : 'opacity-60'}" data-prodcard="${p.id}">
                <div class="flex items-center justify-between gap-2">
                  <p class="text-sm font-semibold">${esc(p.name)} · ${money(p.price)}
                    ${p.stock != null ? `<span class="pill ${p.stock === 0 ? 'pill-danger' : ''}">${p.stock} in stock</span>` : ''}
                    ${p.active ? '' : '<span class="pill">off sale</span>'}</p>
                  <button class="btn btn-ghost btn-sm" data-editprod="${p.id}">Edit</button>
                </div>
                <div class="edit-panel hidden mt-3 pt-3 border-t border-ink-700">${''}</div>
              </div>`
              )
              .join('')}
            <div class="surface-card p-5" data-prodcard=""><h3 class="text-sm font-semibold mb-2">Add an item</h3>${productForm()}</div>
          </div>
          <div>
            <h2 class="text-base font-semibold mb-3">📦 Orders</h2>
            ${
              open.length
                ? open
                    .map(
                      (o) => `
              <div class="surface-card p-4 mb-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <p class="text-sm font-semibold">${esc(names[o.buyer_id] ?? '?')} · ${esc(o.product_name)}${o.option_choice ? ` (${esc(o.option_choice)})` : ''} × ${o.qty}</p>
                    <p class="text-xs text-mist-500 mt-0.5">${fmtDate(o.created_at)} · ${money(o.amount)}${o.invoice_id ? ' · invoiced' : ' · pay at desk'}</p>
                  </div>
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="${pill[o.status] ?? 'pill'}">${o.status}</span>
                    ${o.status === 'pending' ? `<button class="btn btn-primary btn-sm" data-ostatus="paid:${o.id}">Paid</button>` : ''}
                    ${o.status === 'paid' ? `<button class="btn btn-primary btn-sm" data-ostatus="collected:${o.id}">Collected</button>` : ''}
                    ${o.status === 'pending' ? `<button class="btn btn-danger btn-sm" data-ostatus="cancelled:${o.id}">Cancel</button>` : ''}
                  </div>
                </div>
              </div>`
                    )
                    .join('')
                : '<p class="text-sm text-mist-500 mb-3">No open orders.</p>'
            }
            ${done.length ? `<p class="text-xs text-mist-500 mt-2">${done.length} collected order(s) in the books.</p>` : ''}
          </div>
        </div>`;

      const wire = (scope: HTMLElement) => {
        scope.querySelectorAll<HTMLButtonElement>('[data-upload]').forEach((b) =>
          b.addEventListener('click', () => {
            const fileInput = b.parentElement!.querySelector('[data-f="imgfile"]') as HTMLInputElement;
            fileInput.onchange = async () => {
              const file = fileInput.files?.[0];
              if (!file) return;
              if (file.size > 4 * 1024 * 1024) return toast('Keep images under 4MB.', 'err');
              const path = `${club.id}/shop/${Date.now()}-${file.name.replace(/[^a-zA-Z0-9.-]/g, '_')}`;
              const { error } = await supabase.storage.from('club-media').upload(path, file);
              if (error) return toast(errMsg(error), 'err');
              const { data: pub } = supabase.storage.from('club-media').getPublicUrl(path);
              (b.parentElement!.querySelector('[data-f="image"]') as HTMLInputElement).value = pub.publicUrl;
              toast('Photo uploaded. 📷');
            };
            fileInput.click();
          })
        );
        scope.querySelectorAll<HTMLButtonElement>('[data-saveprod]').forEach((b) =>
          b.addEventListener('click', async () => {
            const f = (n: string) => scope.querySelector(`[data-f="${n}"]`) as HTMLInputElement;
            if (!f('name').value.trim()) return toast('Give the product a name.', 'err');
            if (f('price').value === '') return toast('Set a price (0 is fine for freebies — but say so on purpose).', 'err');
            const { error } = await supabase.rpc('admin_save_product', {
              p_club: club.id,
              p_id: b.dataset.saveprod || null,
              p_name: f('name').value.trim(),
              p_price: Number(f('price').value || 0),
              p_description: f('description').value.trim() || null,
              p_options: f('options').value.split(',').map((s) => s.trim()).filter(Boolean),
              p_image_url: f('image').value.trim() || null,
              p_stock: f('stock').value === '' ? null : Number(f('stock').value),
              p_active: f('active').checked,
              p_sort: Number(f('sort').value || 0),
            });
            if (error) return toast(errMsg(error), 'err');
            toast('Saved — it\'s in the shop.');
            render();
          })
        );
      };
      wire(content.querySelector('[data-prodcard=""]')!);

      content.querySelectorAll<HTMLButtonElement>('[data-editprod]').forEach((b) =>
        b.addEventListener('click', () => {
          const card = content.querySelector<HTMLElement>(`[data-prodcard="${b.dataset.editprod}"]`)!;
          const panel = card.querySelector<HTMLElement>('.edit-panel')!;
          if (!panel.classList.contains('hidden')) return panel.classList.add('hidden');
          panel.innerHTML = productForm((products ?? []).find((p) => p.id === b.dataset.editprod));
          panel.classList.remove('hidden');
          wire(panel);
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-ostatus]').forEach((b) =>
        b.addEventListener('click', async () => {
          const [status, id] = b.dataset.ostatus!.split(':');
          if (status === 'cancelled' && !confirm('Cancel this order? Stock is restored and any invoice voided.')) return;
          const { error } = await supabase.rpc('admin_set_order_status', { p_order: id, p_status: status });
          if (error) return toast(errMsg(error), 'err');
          render();
        })
      );
    }

    (async () => {
      ctx = await requireAuth(['admin']);
      await render();
    })().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
