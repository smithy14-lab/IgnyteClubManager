---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Events · Admin">
  <p class="eyebrow">Club admin</p>
  <div class="flex items-center justify-between gap-2 mt-1 mb-5">
    <h1 class="text-2xl">Events</h1>
    <a href="/admin" class="btn btn-ghost btn-sm">← Admin</a>
  </div>
  <div id="content"><p class="text-mist-500 text-sm">Loading…</p></div>

  <script>
    import { supabase } from '../../lib/supabase';
    import { requireAuth, esc, toast, errMsg, fmtDate, type AuthCtx } from '../../lib/app';

    const content = document.getElementById('content')!;
    let ctx: AuthCtx;
    let locations: { id: string; name: string }[] = [];
    let sym = '£';

    function eventForm(e?: { id?: string; name?: string; description?: string | null; event_date?: string; start_time?: string | null; end_time?: string | null; location_id?: string | null; fee?: number | null; capacity?: number | null; active?: boolean }) {
      const hm = (t?: string | null) => (t ? t.slice(0, 5) : '');
      return `
      <div class="grid gap-2 sm:grid-cols-3">
        <input class="field sm:col-span-2" data-f="name" value="${esc(e?.name ?? '')}" placeholder="Event e.g. Regional Comp" />
        <input class="field" data-f="date" type="date" value="${e?.event_date ?? ''}" />
        <input class="field" data-f="start" type="time" value="${hm(e?.start_time)}" />
        <input class="field" data-f="end" type="time" value="${hm(e?.end_time)}" />
        <select class="field" data-f="location"><option value="">Location —</option>
          ${locations.map((l) => `<option value="${l.id}" ${e?.location_id === l.id ? 'selected' : ''}>${esc(l.name)}</option>`).join('')}
        </select>
        <input class="field" data-f="fee" type="number" step="0.5" min="0" value="${e?.fee ?? ''}" placeholder="${sym} fee (blank = free)" />
        <input class="field" data-f="capacity" type="number" min="1" value="${e?.capacity ?? ''}" placeholder="Capacity (blank = open)" />
        <label class="text-xs text-mist-300 flex gap-1.5 items-center"><input type="checkbox" data-f="active" ${e?.active !== false ? 'checked' : ''} /> live</label>
        <input class="field sm:col-span-3" data-f="description" value="${esc(e?.description ?? '')}" placeholder="Details families need — what, where, kit…" />
      </div>
      <button class="btn btn-primary btn-sm mt-2" data-saveev="${e?.id ?? ''}">${e ? 'Save event' : 'Add event'}</button>`;
    }

    async function render() {
      const club = ctx.club!;
      const [{ data: events }, { data: locs }, { data: settings }] = await Promise.all([
        supabase.from('events').select('*').eq('club_id', club.id).order('event_date', { ascending: false }).limit(30),
        supabase.from('locations').select('id, name').eq('club_id', club.id).eq('active', true),
        supabase.from('club_settings').select('currency').eq('club_id', club.id).single(),
      ]);
      locations = locs ?? [];
      sym = settings?.currency ?? '£';

      content.innerHTML = `
        ${(events ?? [])
          .map(
            (e) => `
          <div class="surface-card p-5 mb-4 ${e.active ? '' : 'opacity-60'}" data-evcard="${e.id}">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <p class="text-sm font-semibold">${esc(e.name)} · ${fmtDate(e.event_date)}
                ${Number(e.fee) > 0 ? `· ${sym}${Number(e.fee).toFixed(2)}` : '· free'}
                ${e.active ? '' : '<span class="pill">off</span>'}</p>
              <div class="flex gap-1.5">
                <button class="btn btn-ghost btn-sm" data-roster="${e.id}">Who's in</button>
                <button class="btn btn-ghost btn-sm" data-editev="${e.id}">Edit</button>
              </div>
            </div>
            <div class="roster-panel hidden mt-3 pt-3 border-t border-ink-700" data-rosterpanel="${e.id}"></div>
            <div class="edit-panel hidden mt-3 pt-3 border-t border-ink-700" data-editpanel="${e.id}"></div>
          </div>`
          )
          .join('')}
        <div class="surface-card p-5"><h2 class="text-base font-semibold mb-3">➕ New event</h2><div id="new-ev">${eventForm()}</div></div>`;

      const wire = (scope: HTMLElement) =>
        scope.querySelectorAll<HTMLButtonElement>('[data-saveev]').forEach((b) =>
          b.addEventListener('click', async () => {
            const f = (n: string) => scope.querySelector(`[data-f="${n}"]`) as HTMLInputElement;
            const { error } = await supabase.rpc('admin_save_event', {
              p_club: club.id,
              p_id: b.dataset.saveev || null,
              p_name: f('name').value.trim(),
              p_date: f('date').value,
              p_start: f('start').value || null,
              p_end: f('end').value || null,
              p_location: f('location').value || null,
              p_fee: f('fee').value === '' ? null : Number(f('fee').value),
              p_capacity: f('capacity').value === '' ? null : Number(f('capacity').value),
              p_description: f('description').value.trim() || null,
              p_active: f('active').checked,
            });
            if (error) return toast(errMsg(error), 'err');
            toast('Event saved.');
            render();
          })
        );
      wire(document.getElementById('new-ev')!);

      content.querySelectorAll<HTMLButtonElement>('[data-editev]').forEach((b) =>
        b.addEventListener('click', () => {
          const panel = content.querySelector<HTMLElement>(`[data-editpanel="${b.dataset.editev}"]`)!;
          if (!panel.classList.contains('hidden')) return panel.classList.add('hidden');
          panel.innerHTML = eventForm((events ?? []).find((e) => e.id === b.dataset.editev));
          panel.classList.remove('hidden');
          wire(panel);
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-roster]').forEach((b) =>
        b.addEventListener('click', async () => {
          const panel = content.querySelector<HTMLElement>(`[data-rosterpanel="${b.dataset.roster}"]`)!;
          if (!panel.classList.contains('hidden')) return panel.classList.add('hidden');
          const { data: sign } = await supabase
            .from('event_signups')
            .select('id, status, athletes(name), invoice_id')
            .eq('event_id', b.dataset.roster)
            .eq('status', 'booked')
            .order('created_at');
          panel.innerHTML = (sign ?? []).length
            ? (sign ?? [])
                .map(
                  (s) => `<div class="py-1.5 flex items-center justify-between gap-2 text-sm border-t border-ink-700 first:border-0">
                    <span>${esc((s.athletes as unknown as { name: string })?.name ?? '?')}${s.invoice_id ? '' : ' <span class="text-xs text-mist-500">(no fee)</span>'}</span>
                    <button class="btn btn-ghost btn-sm" data-kicksign="${s.id}">Remove</button>
                  </div>`
                )
                .join('')
            : '<p class="text-xs text-mist-500">Nobody signed up yet.</p>';
          panel.classList.remove('hidden');
          panel.querySelectorAll<HTMLButtonElement>('[data-kicksign]').forEach((k) =>
            k.addEventListener('click', async () => {
              if (!confirm('Remove this athlete from the event? Any unpaid fee is voided.')) return;
              const { error } = await supabase.rpc('cancel_event_signup', { p_signup: k.dataset.kicksign });
              if (error) return toast(errMsg(error), 'err');
              render();
            })
          );
        })
      );
    }

    (async () => {
      ctx = await requireAuth(['admin']);
      await render();
    })().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
