---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Money · Admin">
  <p class="eyebrow">Club admin</p>
  <div class="flex items-center justify-between gap-2 mt-1 mb-5">
    <h1 class="text-2xl">Money</h1>
    <div class="flex gap-2">
      <a href="/admin" class="btn btn-ghost btn-sm">← Admin</a>
      <a href="/admin/classes" class="btn btn-ghost btn-sm">🤸 Classes</a>
    </div>
  </div>

  <div id="content"><p class="text-mist-500 text-sm">Loading…</p></div>

  <script>
    import { supabase } from '../../lib/supabase';
    import { requireAuth, todayISO, esc, toast, errMsg, fmtDate, type AuthCtx } from '../../lib/app';

    const content = document.getElementById('content')!;
    let ctx: AuthCtx;
    let sym = '£';
    const money = (n: unknown) => sym + Number(n ?? 0).toFixed(2);
    const pill: Record<string, string> = { due: 'pill pill-warn', overdue: 'pill pill-danger', paid: 'pill pill-success', void: 'pill' };

    /** Direct Debits clear days later — quietly re-check any in flight. */
    async function reconcileProcessing(open: { id: string; meta: unknown }[]) {
      const pending = open.filter((i) => (i.meta as { dd_processing?: boolean })?.dd_processing);
      if (!pending.length) return;
      const { data: s } = await supabase.auth.getSession();
      const results = await Promise.all(
        pending.map((i) =>
          fetch(`${import.meta.env.PUBLIC_SUPABASE_URL}/functions/v1/pay`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${s.session?.access_token ?? ''}`,
              apikey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
            },
            body: JSON.stringify({ action: 'confirm', invoice_id: i.id }),
          })
            .then((r) => r.json())
            .catch(() => ({}))
        )
      );
      if (results.some((r) => r.paid)) {
        toast('A Direct Debit payment cleared ✅');
        render();
      }
    }

    async function payFlow(invoiceId: string) {
      const method = prompt('How was it paid?\n\n1 = bank transfer\n2 = cash\n3 = card\n4 = online\n5 = other', '1');
      if (method == null) return;
      const map: Record<string, string> = { '1': 'bank_transfer', '2': 'cash', '3': 'card', '4': 'online', '5': 'other' };
      const m = map[method.trim()] ?? 'other';
      const ref = m === 'bank_transfer' ? prompt('Payment reference (optional):') : null;
      const { error } = await supabase.rpc('record_payment', { p_invoice: invoiceId, p_method: m, p_reference: ref || null });
      if (error) return toast(errMsg(error), 'err');
      toast('Payment recorded ✅');
      render();
    }

    async function render() {
      const club = ctx.club!;
      const [{ data: summary, error }, { data: open }, { data: recentPay }, { data: plans }, { data: mems }, { data: members }, { data: settings }, { data: athletes }] =
        await Promise.all([
          supabase.rpc('admin_money_summary', { p_club: club.id }),
          supabase.from('invoices').select('*').eq('club_id', club.id).in('status', ['due', 'overdue']).order('due_date').limit(100),
          supabase.from('payments').select('*, invoices(description)').eq('club_id', club.id).order('received_at', { ascending: false }).limit(12),
          supabase.from('membership_plans').select('*').eq('club_id', club.id).order('monthly_fee'),
          supabase.from('memberships').select('*, athletes(name), membership_plans(name, monthly_fee), profiles!memberships_payer_id_fkey(full_name)').eq('club_id', club.id).eq('status', 'active').order('created_at'),
          supabase.from('club_members').select('profile_id, role, profiles(full_name, email)').eq('club_id', club.id).eq('status', 'active'),
          supabase.from('club_settings').select('currency, payment_instructions, payment_link_url, invoice_due_days, card_payments_enabled, billing_day, late_fee_amount, late_fee_after_days').eq('club_id', club.id).single(),
          supabase.from('athlete_enrolments').select('athletes(id, name, parent_id, profile_id)').eq('club_id', club.id),
        ]);
      if (error) return toast(errMsg(error), 'err');
      sym = settings?.currency ?? '£';
      reconcileProcessing(open ?? []);

      const people = (members ?? []).map((m) => ({
        id: m.profile_id,
        name: (m.profiles as unknown as { full_name: string })?.full_name ?? '?',
        role: m.role,
      }));
      const names = Object.fromEntries(people.map((p) => [p.id, p.name]));
      const famOptions = people
        .filter((p) => ['parent', 'athlete'].includes(p.role))
        .concat(people.filter((p) => !['parent', 'athlete'].includes(p.role)))
        .map((p) => `<option value="${p.id}">${esc(p.name)}${['parent', 'athlete'].includes(p.role) ? '' : ' (' + p.role + ')'}</option>`)
        .join('');
      const athList = (athletes ?? []).map((r) => r.athletes as unknown as { id: string; name: string }).filter(Boolean);
      const s = (summary ?? {}) as { due?: number; overdue?: number; paid_30d?: number; by_month?: { month: string; total: number }[]; debtors?: { name: string; profile_id: string; owed: number; oldest_due: string; has_overdue: boolean }[] };

      content.innerHTML = `
        <div class="grid gap-4 grid-cols-3 mb-6">
          ${[
            ['Owed', money(Number(s.due ?? 0) + Number(s.overdue ?? 0)), Number(s.overdue) > 0 ? money(s.overdue) + ' overdue' : 'nothing overdue'],
            ['Collected (30d)', money(s.paid_30d), 'marked paid'],
            ['This month', money((s.by_month ?? []).find((m) => m.month === new Date().toISOString().slice(0, 7))?.total ?? 0), 'revenue'],
          ]
            .map(
              ([label, big, sub]) => `
            <div class="surface-card p-5 text-center">
              <p class="text-2xl sm:text-3xl font-display font-semibold ignite-text">${big}</p>
              <p class="text-xs text-mist-400 mt-1">${label} · ${sub}</p>
            </div>`
            )
            .join('')}
        </div>

        <div class="grid gap-5 lg:grid-cols-2">
          <div>
            <div class="surface-card p-5 mb-5">
              <h2 class="text-base font-semibold mb-1">📥 Outstanding</h2>
              <p class="text-xs text-mist-500 mb-3">Money owed to the club. Record a payment when it lands in the bank or the cash tin.</p>
              ${
                (open ?? []).length
                  ? (open ?? [])
                      .map(
                        (i) => `
                  <div class="py-3 border-t border-ink-700 first:border-0">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <div>
                        <p class="text-sm">${esc(names[i.profile_id] ?? '?')} · ${esc(i.description)}</p>
                        <p class="text-xs text-mist-500 mt-0.5">due ${fmtDate(i.due_date)}</p>
                      </div>
                      <div class="flex items-center gap-1.5 flex-wrap">
                        <span class="${pill[i.status]}">${i.status}</span>
                        ${(i.meta as { dd_processing?: boolean })?.dd_processing ? '<span class="pill pill-accent" title="Direct Debit clearing — settles itself, no need to chase.">⏳ DD processing</span>' : ''}
                        <span class="text-sm font-semibold">${money(i.amount)}</span>
                        <button class="btn btn-primary btn-sm" data-pay="${i.id}">Paid</button>
                        <button class="btn btn-ghost btn-sm" data-chase="${i.id}">Chase</button>
                        <button class="btn btn-danger btn-sm" data-void="${i.id}">Void</button>
                      </div>
                    </div>
                  </div>`
                      )
                      .join('')
                  : '<p class="text-sm text-mist-300">✅ Nothing outstanding.</p>'
              }
            </div>

            <div class="surface-card p-5 mb-5">
              <h2 class="text-base font-semibold mb-3">➕ Raise an invoice</h2>
              <div class="grid gap-2 sm:grid-cols-2">
                <select class="field" id="inv-who">${famOptions}</select>
                <input class="field" id="inv-amount" type="number" step="0.5" min="0.5" placeholder="Amount (${sym})" />
                <input class="field sm:col-span-2" id="inv-desc" placeholder="What's it for? e.g. Comp fees, kit order…" />
                <input class="field" id="inv-due" type="date" />
                <button class="btn btn-primary" id="inv-go">Send invoice</button>
              </div>
              <div class="mt-4 pt-3 border-t border-ink-700">
                <p class="text-xs font-semibold text-mist-300 mb-2">💳 Sell a lesson credit pack</p>
                <div class="grid gap-2 sm:grid-cols-4">
                  <select class="field sm:col-span-2" id="pack-who">${famOptions}</select>
                  <input class="field" id="pack-n" type="number" min="1" placeholder="Credits" value="10" />
                  <input class="field" id="pack-amt" type="number" step="0.5" min="0" placeholder="${sym} total" />
                </div>
                <button class="btn btn-ghost btn-sm mt-2" id="pack-go">Invoice the pack</button>
                <p class="text-xs text-mist-500 mt-1.5">Credits land automatically the moment you mark it paid.</p>
              </div>
            </div>

            <div class="surface-card p-5">
              <h2 class="text-base font-semibold mb-3">🧾 Recent payments</h2>
              ${
                (recentPay ?? []).length
                  ? (recentPay ?? [])
                      .map(
                        (p) => `<p class="text-xs text-mist-300 py-1.5 border-t border-ink-700 first:border-0">
                        ${fmtDate(p.received_at)} · <b>${money(p.amount)}</b> · ${esc(names[p.profile_id] ?? '?')} · ${esc((p.invoices as unknown as { description: string })?.description ?? '')} <span class="text-mist-500">(${p.method.replace('_', ' ')})</span></p>`
                      )
                      .join('')
                  : '<p class="text-sm text-mist-500">No payments recorded yet.</p>'
              }
              <button class="btn btn-ghost btn-sm mt-3" id="x-money">Download money export (.xlsx)</button>
            </div>
          </div>

          <div>
            ${
              (s.debtors ?? []).length
                ? `<div class="surface-card p-5 mb-5">
              <h2 class="text-base font-semibold mb-3">⏰ Who owes what</h2>
              ${(s.debtors ?? [])
                .map(
                  (d) => `<div class="py-2 border-t border-ink-700 first:border-0 flex items-center justify-between gap-2 text-sm">
                    <span>${esc(d.name)}${d.has_overdue ? ' <span class="pill pill-danger">overdue</span>' : ''}</span>
                    <span class="font-semibold">${money(d.owed)}</span>
                  </div>`
                )
                .join('')}
            </div>`
                : ''
            }

            <div class="surface-card p-5 mb-5">
              <h2 class="text-base font-semibold mb-1">🏅 Membership plans</h2>
              <p class="text-xs text-mist-500 mb-3">Monthly plans families join themselves. Invoices go out automatically on the 1st; overdue ones are chased daily.</p>
              ${(plans ?? [])
                .map(
                  (p) => `
                <div class="py-2.5 border-t border-ink-700 first:border-0 flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <p class="text-sm font-semibold">${esc(p.name)} ${p.active ? '' : '<span class="pill">off</span>'}</p>
                    <p class="text-xs text-mist-400">${money(p.monthly_fee)}/mo · ${p.classes_per_week ? p.classes_per_week + ' class/wk' : 'unlimited classes'}${p.private_credits_per_month ? ' · ' + p.private_credits_per_month + ' credits/mo' : ''}</p>
                  </div>
                  <button class="btn btn-ghost btn-sm" data-planoff="${p.id}:${p.active ? '0' : '1'}">${p.active ? 'Disable' : 'Enable'}</button>
                </div>`
                )
                .join('')}
              <div class="mt-3 pt-3 border-t border-ink-700 grid gap-2 sm:grid-cols-2">
                <input class="field" id="plan-name" placeholder="Plan name e.g. Squad" />
                <input class="field" id="plan-fee" type="number" step="0.5" min="0" placeholder="${sym}/month" />
                <input class="field" id="plan-cpw" type="number" min="1" placeholder="Classes/week (blank = unlimited)" />
                <input class="field" id="plan-credits" type="number" min="0" placeholder="Private credits/month" />
                <input class="field sm:col-span-2" id="plan-desc" placeholder="Description (optional)" />
              </div>
              <button class="btn btn-primary btn-sm mt-2" id="plan-go">Add plan</button>
            </div>

            <div class="surface-card p-5 mb-5">
              <h2 class="text-base font-semibold mb-3">👥 Active memberships</h2>
              ${
                (mems ?? []).length
                  ? (mems ?? [])
                      .map(
                        (m) => `<div class="py-2 border-t border-ink-700 first:border-0 flex items-center justify-between gap-2 text-sm">
                      <span>${esc((m.athletes as unknown as { name: string })?.name ?? '?')} · ${esc((m.membership_plans as unknown as { name: string })?.name ?? '?')}
                        <span class="text-xs text-mist-500">pays: ${esc((m.profiles as unknown as { full_name: string })?.full_name ?? '?')}</span></span>
                      <button class="btn btn-ghost btn-sm" data-memcancel="${m.id}">Cancel</button>
                    </div>`
                      )
                      .join('')
                  : '<p class="text-sm text-mist-500">None yet — families join from their Money page, or start one here.</p>'
              }
              ${
                (plans ?? []).some((p) => p.active) && athList.length
                  ? `<div class="mt-3 pt-3 border-t border-ink-700 flex flex-wrap gap-2 items-center">
                <select class="field !w-auto !py-1.5 !text-xs" id="am-plan">${(plans ?? []).filter((p) => p.active).map((p) => `<option value="${p.id}">${esc(p.name)}</option>`).join('')}</select>
                <select class="field !w-auto !py-1.5 !text-xs" id="am-ath">${athList.map((a) => `<option value="${a.id}">${esc(a.name)}</option>`).join('')}</select>
                <button class="btn btn-ghost btn-sm" id="am-go">Start membership</button>
              </div>`
                  : ''
              }
            </div>

            <div class="surface-card p-5">
              <h2 class="text-base font-semibold mb-1">⚙️ How families pay you</h2>
              <p class="text-xs text-mist-500 mb-3">Shown on every family's Money page. Paste a Stripe/PayPal/GoCardless payment link if you have one — the money goes straight to you, we never touch it.</p>
              <div class="grid gap-2 sm:grid-cols-4">
                <div><label class="form-label">Currency</label>
                  <input class="field" id="ps-cur" value="${esc(sym)}" maxlength="3" placeholder="£" /></div>
                <div><label class="form-label">Days to pay</label>
                  <input class="field" id="ps-days" type="number" min="0" max="60" value="${settings?.invoice_due_days ?? 7}" /></div>
                <div class="sm:col-span-2"><label class="form-label">Payment link (optional)</label>
                  <input class="field" id="ps-link" value="${esc(settings?.payment_link_url ?? '')}" placeholder="https://…" /></div>
                <div><label class="form-label">Bill memberships on the…</label>
                  <select class="field" id="ps-billday">
                    ${Array.from({ length: 28 }, (_, i) => i + 1).map((d) => `<option value="${d}" ${(settings?.billing_day ?? 1) === d ? 'selected' : ''}>${d}${d === 1 ? 'st' : d === 2 ? 'nd' : d === 3 ? 'rd' : d === 21 ? 'st' : d === 22 ? 'nd' : d === 23 ? 'rd' : 'th'} of the month</option>`).join('')}
                  </select></div>
                <div><label class="form-label">Late fee (${esc(sym)}, 0 = off)</label>
                  <input class="field" id="ps-latefee" type="number" step="0.5" min="0" max="100" value="${settings?.late_fee_amount ?? 0}" /></div>
                <div><label class="form-label">Grace days before fee</label>
                  <input class="field" id="ps-latedays" type="number" min="0" max="60" value="${settings?.late_fee_after_days ?? 7}" /></div>
                <textarea class="field sm:col-span-4" id="ps-instr" rows="3" placeholder="Bank transfer details, cash desk hours…">${esc(settings?.payment_instructions ?? '')}</textarea>
              </div>
              <p class="text-xs text-mist-500 mt-1.5">
                Example: bill on the 1st with 11 days to pay → due the 12th. With a late fee and
                0 grace days, anyone unpaid on the 13th is charged the fee automatically (they're
                notified; a clearing Direct Debit never counts as late).
              </p>
              <button class="btn btn-primary btn-sm mt-2" id="ps-go">Save payment settings</button>
              <div class="mt-4 pt-3 border-t border-ink-700">
                <p class="text-xs font-semibold text-mist-300 mb-1">💳 Card payments — your own Stripe
                  ${settings?.card_payments_enabled ? '<span class="pill pill-success">on</span>' : '<span class="pill">off</span>'}</p>
                <p class="text-xs text-mist-500 mb-2">
                  Families get a "Pay online" button on every invoice. Payments go straight into
                  <b>your</b> Stripe account — Ignyte adds 0%. In Stripe: Developers → API keys →
                  create a <b>Restricted key</b> with Checkout Sessions (write) + Payment Intents (read), paste it here.
                </p>
                <p class="text-xs text-mist-500 mb-2">
                  Checkout automatically offers <b>every method you enable in Stripe</b> (Settings →
                  Payment methods): cards, Apple&nbsp;Pay &amp; Google&nbsp;Pay (~1.5% + 20p),
                  <b>Bacs Direct Debit</b> (~1% + 20p capped at £4 — cheapest for memberships, clears in ~3
                  days and settles itself here) and PayPal (dearer — convenience only).
                </p>
                <input class="field" id="st-key" type="password" placeholder="rk_live_… (stored securely, never shown again)" autocomplete="off" />
                <div class="flex flex-wrap gap-2 items-center mt-2">
                  <label class="text-xs text-mist-300 flex gap-1.5 items-center">
                    <input type="checkbox" id="st-pass" checked /> Add the card fee to the family's total
                  </label>
                  <input class="field !w-20 !py-1 !text-xs" id="st-pct" type="number" step="0.1" min="0" value="1.5" title="fee %" />
                  <span class="text-xs text-mist-500">% +</span>
                  <input class="field !w-20 !py-1 !text-xs" id="st-fix" type="number" step="0.01" min="0" value="0.20" title="fixed fee" />
                  <span class="text-xs text-mist-500">fixed</span>
                </div>
                ${settings?.card_payments_enabled ? '<p class="text-[0.68rem] text-mist-500 mt-1">Saving re-applies the fee settings exactly as shown above — set them how you want them before you save.</p>' : ''}
                <div class="flex gap-2 mt-2">
                  <button class="btn btn-primary btn-sm" id="st-save">${settings?.card_payments_enabled ? 'Update key & fees' : 'Connect Stripe'}</button>
                  ${settings?.card_payments_enabled ? '<button class="btn btn-danger btn-sm" id="st-off">Disconnect</button>' : ''}
                </div>
              </div>
            </div>
          </div>
        </div>`;

      content.querySelectorAll<HTMLButtonElement>('[data-pay]').forEach((b) => b.addEventListener('click', () => payFlow(b.dataset.pay!)));
      content.querySelectorAll<HTMLButtonElement>('[data-chase]').forEach((b) =>
        b.addEventListener('click', async () => {
          const { error: e } = await supabase.rpc('chase_invoice', { p_invoice: b.dataset.chase });
          if (e) return toast(errMsg(e), 'err');
          toast('Reminder sent.');
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-void]').forEach((b) =>
        b.addEventListener('click', async () => {
          if (!confirm('Void this invoice? It disappears from what the family owes.')) return;
          const { error: e } = await supabase.rpc('void_invoice', { p_invoice: b.dataset.void });
          if (e) return toast(errMsg(e), 'err');
          render();
        })
      );
      document.getElementById('inv-go')?.addEventListener('click', async () => {
        const who = (document.getElementById('inv-who') as HTMLSelectElement).value;
        const amount = Number((document.getElementById('inv-amount') as HTMLInputElement).value);
        const desc = (document.getElementById('inv-desc') as HTMLInputElement).value.trim();
        const due = (document.getElementById('inv-due') as HTMLInputElement).value || null;
        if (!desc || !amount) return toast('Description and amount required.', 'err');
        const { error: e } = await supabase.rpc('admin_create_invoice', { p_club: club.id, p_profile: who, p_description: desc, p_amount: amount, p_due: due, p_meta: {}, p_source: 'manual' });
        if (e) return toast(errMsg(e), 'err');
        toast('Invoice sent — they\'ve been notified.');
        render();
      });
      document.getElementById('pack-go')?.addEventListener('click', async () => {
        const who = (document.getElementById('pack-who') as HTMLSelectElement).value;
        const n = Number((document.getElementById('pack-n') as HTMLInputElement).value);
        const amt = Number((document.getElementById('pack-amt') as HTMLInputElement).value);
        if (!n || !amt) return toast('Credits and amount required.', 'err');
        const { error: e } = await supabase.rpc('admin_sell_credit_pack', { p_club: club.id, p_profile: who, p_credits: n, p_amount: amt });
        if (e) return toast(errMsg(e), 'err');
        toast('Pack invoiced — credits land when you mark it paid.');
        render();
      });
      content.querySelectorAll<HTMLButtonElement>('[data-planoff]').forEach((b) =>
        b.addEventListener('click', async () => {
          const [id, to] = b.dataset.planoff!.split(':');
          const p = (plans ?? []).find((x) => x.id === id)!;
          const { error: e } = await supabase.rpc('admin_save_plan', {
            p_club: club.id, p_id: id, p_name: p.name, p_fee: p.monthly_fee,
            p_classes_per_week: p.classes_per_week, p_credits: p.private_credits_per_month,
            p_description: p.description, p_active: to === '1',
          });
          if (e) return toast(errMsg(e), 'err');
          render();
        })
      );
      document.getElementById('plan-go')?.addEventListener('click', async () => {
        const name = (document.getElementById('plan-name') as HTMLInputElement).value.trim();
        const fee = Number((document.getElementById('plan-fee') as HTMLInputElement).value);
        const cpw = (document.getElementById('plan-cpw') as HTMLInputElement).value;
        const credits = Number((document.getElementById('plan-credits') as HTMLInputElement).value || 0);
        const desc = (document.getElementById('plan-desc') as HTMLInputElement).value.trim() || null;
        if (!name || !(fee >= 0)) return toast('Name and monthly fee required.', 'err');
        const { error: e } = await supabase.rpc('admin_save_plan', {
          p_club: club.id, p_id: null, p_name: name, p_fee: fee,
          p_classes_per_week: cpw ? Number(cpw) : null, p_credits: credits, p_description: desc, p_active: true,
        });
        if (e) return toast(errMsg(e), 'err');
        toast('Plan added.');
        render();
      });
      document.getElementById('am-go')?.addEventListener('click', async () => {
        const { error: e } = await supabase.rpc('start_membership', {
          p_plan: (document.getElementById('am-plan') as HTMLSelectElement).value,
          p_athlete: (document.getElementById('am-ath') as HTMLSelectElement).value,
        });
        if (e) return toast(errMsg(e), 'err');
        toast('Membership started & first invoice raised.');
        render();
      });
      content.querySelectorAll<HTMLButtonElement>('[data-memcancel]').forEach((b) =>
        b.addEventListener('click', async () => {
          if (!confirm('Cancel this membership? No further monthly invoices will be raised.')) return;
          const { error: e } = await supabase.rpc('cancel_membership', { p_membership: b.dataset.memcancel });
          if (e) return toast(errMsg(e), 'err');
          render();
        })
      );
      document.getElementById('ps-go')?.addEventListener('click', async () => {
        const { error: e } = await supabase.rpc('update_payment_settings', {
          p_club: club.id,
          p_currency: (document.getElementById('ps-cur') as HTMLInputElement).value.trim() || '£',
          p_instructions: (document.getElementById('ps-instr') as HTMLTextAreaElement).value,
          p_link: (document.getElementById('ps-link') as HTMLInputElement).value.trim(),
          p_due_days: Number((document.getElementById('ps-days') as HTMLInputElement).value || 7),
          p_billing_day: Number((document.getElementById('ps-billday') as HTMLSelectElement).value || 1),
          p_late_fee: Number((document.getElementById('ps-latefee') as HTMLInputElement).value || 0),
          p_late_fee_days: Number((document.getElementById('ps-latedays') as HTMLInputElement).value || 0),
        });
        if (e) return toast(errMsg(e), 'err');
        toast('Payment settings saved.');
        render();
      });
      document.getElementById('st-save')?.addEventListener('click', async () => {
        const key = (document.getElementById('st-key') as HTMLInputElement).value.trim();
        if (!key) return toast('Paste your Stripe restricted key first.', 'err');
        const { error: e } = await supabase.rpc('admin_set_stripe_key', {
          p_club: club.id,
          p_secret: key,
          p_pass_fees: (document.getElementById('st-pass') as HTMLInputElement).checked,
          p_fee_percent: Number((document.getElementById('st-pct') as HTMLInputElement).value || 1.5),
          p_fee_fixed: Number((document.getElementById('st-fix') as HTMLInputElement).value || 0.2),
        });
        if (e) return toast(errMsg(e), 'err');
        toast('Stripe connected — families can now pay by card. 🎉');
        render();
      });
      document.getElementById('st-off')?.addEventListener('click', async () => {
        if (!confirm('Disconnect Stripe? The "Pay by card" button disappears for families.')) return;
        const { error: e } = await supabase.rpc('admin_set_stripe_key', { p_club: club.id, p_secret: '', p_pass_fees: false, p_fee_percent: 1.5, p_fee_fixed: 0.2 });
        if (e) return toast(errMsg(e), 'err');
        toast('Stripe disconnected.');
        render();
      });
      document.getElementById('x-money')?.addEventListener('click', async () => {
        const [{ data: allInv }, { data: allPay }] = await Promise.all([
          supabase.from('invoices').select('*').eq('club_id', club.id).order('created_at'),
          supabase.from('payments').select('*').eq('club_id', club.id).order('received_at'),
        ]);
        const inv = [['#', 'Person', 'Description', 'Amount', 'Status', 'Due', 'Paid at', 'Method', 'Source']].concat(
          (allInv ?? []).map((i) => [String(i.invoice_no), names[i.profile_id] ?? i.profile_id, i.description, String(i.amount), i.status, i.due_date, i.paid_at ?? '', i.paid_method ?? '', i.source])
        );
        const pay = [['Date', 'Person', 'Amount', 'Method', 'Reference']].concat(
          (allPay ?? []).map((p) => [p.received_at.slice(0, 10), names[p.profile_id] ?? p.profile_id, String(p.amount), p.method, p.reference ?? ''])
        );
        const XLSX = await import('xlsx');
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(inv), 'Invoices');
        XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(pay), 'Payments');
        XLSX.writeFile(wb, `ignyte-money-${todayISO()}.xlsx`);
      });
    }

    (async () => {
      ctx = await requireAuth(['admin']);
      await render();
    })().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
