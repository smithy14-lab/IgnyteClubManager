---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Classes · Admin">
  <p class="eyebrow">Club admin</p>
  <div class="flex items-center justify-between gap-2 mt-1 mb-5">
    <h1 class="text-2xl">Group classes</h1>
    <div class="flex gap-2">
      <a href="/admin" class="btn btn-ghost btn-sm">← Admin</a>
      <a href="/admin/money" class="btn btn-ghost btn-sm">💷 Money</a>
    </div>
  </div>

  <div id="content"><p class="text-mist-500 text-sm">Loading…</p></div>

  <script>
    import { supabase } from '../../lib/supabase';
    import { requireAuth, todayISO, esc, toast, errMsg, ageFromDob, fmtDate, type AuthCtx } from '../../lib/app';

    const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const content = document.getElementById('content')!;
    let ctx: AuthCtx;
    let locations: { id: string; name: string }[] = [];
    let coaches: { id: string; name: string }[] = [];
    let symbol = '£';
    let disciplines: string[] = ['tumble', 'dance'];

    type Cls = {
      id: string; name: string; discipline: string; description: string | null;
      day_of_week: number; start_time: string; end_time: string; capacity: number;
      age_min: number | null; age_max: number | null; price_per_session: number | null;
      monthly_fee: number | null; trial_allowed: boolean; trial_price: number | null;
      location: string | null; coach: string | null; lead_coach_id: string | null;
      enrolled: number; waiting: number; next_date: string | null; active: boolean;
    };
    const hm = (t: string) => t.slice(0, 5);

    function classForm(c?: Cls) {
      const v = (x: unknown) => (x == null ? '' : String(x));
      return `
      <div class="grid gap-3 sm:grid-cols-2">
        <div><label class="form-label">Class name</label><input class="field" data-f="name" value="${esc(c?.name ?? '')}" placeholder="Mini Tumble Squad" /></div>
        <div><label class="form-label">Discipline</label>
          <select class="field" data-f="discipline">
            ${disciplines.map((d: string) => `<option ${c?.discipline === d ? 'selected' : ''}>${d}</option>`).join('')}
          </select></div>
        <div><label class="form-label">Day</label>
          <select class="field" data-f="day">${DAYS.map((d, i) => `<option value="${i}" ${c?.day_of_week === i ? 'selected' : ''}>${d}</option>`).join('')}</select></div>
        <div class="grid grid-cols-2 gap-2">
          <div><label class="form-label">Starts</label><input class="field" type="time" data-f="start" value="${c ? hm(c.start_time) : '17:00'}" /></div>
          <div><label class="form-label">Ends</label><input class="field" type="time" data-f="end" value="${c ? hm(c.end_time) : '18:00'}" /></div>
        </div>
        <div><label class="form-label">Location</label>
          <select class="field" data-f="location"><option value="">—</option>
            ${locations.map((l) => `<option value="${l.id}" ${c?.location === l.name ? 'selected' : ''}>${esc(l.name)}</option>`).join('')}
          </select></div>
        <div><label class="form-label">Lead coach</label>
          <select class="field" data-f="coach"><option value="">—</option>
            ${coaches.map((p) => `<option value="${p.id}" ${c?.lead_coach_id === p.id ? 'selected' : ''}>${esc(p.name)}</option>`).join('')}
          </select></div>
        <div class="grid grid-cols-3 gap-2">
          <div><label class="form-label">Capacity</label><input class="field" type="number" min="1" data-f="capacity" value="${v(c?.capacity ?? 10)}" /></div>
          <div><label class="form-label">Age min</label><input class="field" type="number" min="0" data-f="agemin" value="${v(c?.age_min)}" /></div>
          <div><label class="form-label">Age max</label><input class="field" type="number" min="0" data-f="agemax" value="${v(c?.age_max)}" /></div>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <div><label class="form-label">${symbol}/session</label><input class="field" type="number" step="0.5" min="0" data-f="price" value="${v(c?.price_per_session)}" /></div>
          <div><label class="form-label">${symbol}/month</label><input class="field" type="number" step="0.5" min="0" data-f="monthly" value="${v(c?.monthly_fee)}" /></div>
          <div><label class="form-label">Trial ${symbol}</label><input class="field" type="number" step="0.5" min="0" data-f="trialprice" value="${v(c?.trial_price)}" placeholder="free" /></div>
        </div>
        <div class="sm:col-span-2"><label class="form-label">Description</label><input class="field" data-f="description" value="${esc(c?.description ?? '')}" placeholder="Who is it for, what do they learn…" /></div>
        <label class="text-xs text-mist-300 flex gap-2 items-center sm:col-span-2">
          <input type="checkbox" data-f="trialallowed" ${c?.trial_allowed !== false ? 'checked' : ''} /> Allow trial bookings
        </label>
      </div>
      <button class="btn btn-primary btn-sm mt-3" data-saveclass="${c?.id ?? ''}">${c ? 'Save changes' : 'Create class'}</button>`;
    }

    async function saveClass(scope: HTMLElement, id: string) {
      const f = (n: string) => scope.querySelector(`[data-f="${n}"]`) as HTMLInputElement;
      const num = (n: string) => (f(n).value === '' ? null : Number(f(n).value));
      const { error } = await supabase.rpc('admin_save_class', {
        p_club: ctx.club!.id,
        p_id: id || null,
        p_name: f('name').value.trim(),
        p_discipline: (f('discipline') as unknown as HTMLSelectElement).value,
        p_day: Number(f('day').value),
        p_start: f('start').value,
        p_end: f('end').value,
        p_capacity: Number(f('capacity').value || 0),
        p_location: f('location').value || null,
        p_coach: f('coach').value || null,
        p_age_min: num('agemin'),
        p_age_max: num('agemax'),
        p_price: num('price'),
        p_monthly: num('monthly'),
        p_trial_allowed: f('trialallowed').checked,
        p_trial_price: num('trialprice'),
        p_description: f('description').value.trim() || null,
      });
      if (error) return toast(errMsg(error), 'err');
      toast(id ? 'Class updated.' : 'Class created — 8 weeks of sessions are on the calendar.');
      render();
    }

    async function openRoster(cid: string, host: HTMLElement) {
      const [{ data: enr }, { data: trials }, { data: sess }] = await Promise.all([
        supabase.from('class_enrolments').select('athlete_id, status, created_at, athletes(name, dob, medical_notes)').eq('class_id', cid).neq('status', 'left').order('created_at'),
        supabase.from('class_trials').select('id, status, athletes(name), class_sessions(session_date)').eq('class_id', cid).eq('status', 'booked'),
        supabase.from('class_sessions').select('id, session_date, cancelled').eq('class_id', cid).gte('session_date', todayISO()).order('session_date').limit(6),
      ]);
      const row = (e: NonNullable<typeof enr>[number]) => {
        const a = e.athletes as unknown as { name: string; dob: string; medical_notes: string | null };
        return `<div class="py-2 border-t border-ink-700 first:border-0 flex items-center justify-between gap-2">
          <p class="text-sm">${esc(a.name)} <span class="text-xs text-mist-500">(${ageFromDob(a.dob)})</span>
            ${a.medical_notes ? '<span class="pill pill-warn" title="' + esc(a.medical_notes) + '">🚑</span>' : ''}</p>
          <div class="flex gap-1.5 items-center">
            ${e.status === 'waiting' ? `<span class="pill pill-warn">waiting</span><button class="btn btn-primary btn-sm" data-promote="${cid}:${e.athlete_id}">Give place</button>` : ''}
            <button class="btn btn-ghost btn-sm" data-kick="${cid}:${e.athlete_id}">Remove</button>
          </div>
        </div>`;
      };
      host.innerHTML = `
        <div class="grid gap-4 sm:grid-cols-2 mt-3">
          <div>
            <p class="text-xs font-semibold text-mist-300 mb-1">Roster (${(enr ?? []).filter((e) => e.status === 'enrolled').length})</p>
            ${(enr ?? []).filter((e) => e.status === 'enrolled').map(row).join('') || '<p class="text-xs text-mist-500">Nobody enrolled yet.</p>'}
            ${(enr ?? []).some((e) => e.status === 'waiting') ? `<p class="text-xs font-semibold text-mist-300 mt-3 mb-1">Waiting list</p>${(enr ?? []).filter((e) => e.status === 'waiting').map(row).join('')}` : ''}
            ${(trials ?? []).length ? `<p class="text-xs font-semibold text-mist-300 mt-3 mb-1">Trials booked</p>${(trials ?? []).map((t) => `<p class="text-xs text-mist-300 py-1">⭐ ${esc((t.athletes as unknown as { name: string })?.name ?? '')} — ${fmtDate((t.class_sessions as unknown as { session_date: string })?.session_date ?? '')}</p>`).join('')}` : ''}
          </div>
          <div>
            <p class="text-xs font-semibold text-mist-300 mb-1">Upcoming sessions</p>
            ${(sess ?? [])
              .map(
                (s) => `<div class="py-1.5 flex items-center justify-between gap-2 text-sm ${s.cancelled ? 'opacity-50' : ''}">
                  <span>${fmtDate(s.session_date)}${s.cancelled ? ' (cancelled)' : ''}</span>
                  <button class="btn btn-ghost btn-sm" data-cancelsess="${s.id}:${s.cancelled ? '0' : '1'}">${s.cancelled ? 'Restore' : 'Cancel'}</button>
                </div>`
              )
              .join('')}
          </div>
        </div>`;
      host.querySelectorAll<HTMLButtonElement>('[data-promote]').forEach((b) =>
        b.addEventListener('click', async () => {
          const [c, a] = b.dataset.promote!.split(':');
          const { error } = await supabase.rpc('enrol_class', { p_class: c, p_athlete: a });
          if (error) return toast(errMsg(error), 'err');
          toast('Moved into the class.');
          openRoster(cid, host);
        })
      );
      host.querySelectorAll<HTMLButtonElement>('[data-kick]').forEach((b) =>
        b.addEventListener('click', async () => {
          const [c, a] = b.dataset.kick!.split(':');
          if (!confirm('Remove this athlete from the class?')) return;
          const { error } = await supabase.rpc('leave_class', { p_class: c, p_athlete: a });
          if (error) return toast(errMsg(error), 'err');
          openRoster(cid, host);
        })
      );
      host.querySelectorAll<HTMLButtonElement>('[data-cancelsess]').forEach((b) =>
        b.addEventListener('click', async () => {
          const [s, to] = b.dataset.cancelsess!.split(':');
          const { error } = await supabase.rpc('admin_cancel_class_session', { p_session: s, p_cancelled: to === '1' });
          if (error) return toast(errMsg(error), 'err');
          toast(to === '1' ? 'Session cancelled — families notified.' : 'Session restored.');
          openRoster(cid, host);
        })
      );
    }

    async function render() {
      const club = ctx.club!;
      const [{ data: classesRaw, error }, { data: locs }, { data: members }, { data: settings }] = await Promise.all([
        supabase.rpc('get_classes', { p_club: club.id }),
        supabase.from('locations').select('id, name').eq('club_id', club.id).eq('active', true),
        supabase.from('club_members').select('profile_id, role, profiles(full_name)').eq('club_id', club.id).eq('status', 'active').in('role', ['coach', 'admin']),
        supabase.from('club_settings').select('currency, disciplines').eq('club_id', club.id).single(),
      ]);
      if (error) return toast(errMsg(error), 'err');
      symbol = settings?.currency ?? '£';
      disciplines = settings?.disciplines ?? ['tumble', 'dance'];
      locations = locs ?? [];
      coaches = (members ?? []).map((m) => ({ id: m.profile_id, name: (m.profiles as unknown as { full_name: string })?.full_name ?? '?' }));
      const classes = (classesRaw ?? []) as Cls[];

      content.innerHTML = `
        ${classes
          .map(
            (c) => `
          <div class="surface-card p-5 mb-4 ${c.active ? '' : 'opacity-60'}" data-card="${c.id}">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <h2 class="font-semibold">${esc(c.name)} ${c.active ? '' : '<span class="pill">archived</span>'}</h2>
                <p class="text-xs text-mist-400 mt-0.5">${DAYS[c.day_of_week]}s ${hm(c.start_time)}–${hm(c.end_time)}${c.location ? ' · ' + esc(c.location) : ''}${c.coach ? ' · ' + esc(c.coach) : ''}</p>
              </div>
              <div class="flex gap-1.5 items-center flex-wrap">
                <span class="pill">${c.enrolled}/${c.capacity}</span>
                ${Number(c.waiting) ? `<span class="pill pill-warn">${c.waiting} waiting</span>` : ''}
                <button class="btn btn-ghost btn-sm" data-roster="${c.id}">Roster</button>
                <button class="btn btn-ghost btn-sm" data-edit="${c.id}">Edit</button>
                <button class="btn btn-ghost btn-sm" data-arch="${c.id}:${c.active ? '0' : '1'}">${c.active ? 'Archive' : 'Restore'}</button>
              </div>
            </div>
            <div class="roster-panel hidden" data-rosterpanel="${c.id}"></div>
            <div class="edit-panel hidden mt-3 pt-3 border-t border-ink-700" data-editpanel="${c.id}"></div>
          </div>`
          )
          .join('')}
        <div class="surface-card p-5">
          <h2 class="text-base font-semibold mb-3">➕ New class</h2>
          <div id="new-class">${classForm()}</div>
        </div>`;

      const wire = (scope: HTMLElement) =>
        scope.querySelectorAll<HTMLButtonElement>('[data-saveclass]').forEach((b) =>
          b.addEventListener('click', () => saveClass(scope, b.dataset.saveclass!))
        );
      wire(document.getElementById('new-class')!);

      content.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach((b) =>
        b.addEventListener('click', () => {
          const panel = content.querySelector<HTMLElement>(`[data-editpanel="${b.dataset.edit}"]`)!;
          if (!panel.classList.contains('hidden')) return panel.classList.add('hidden');
          panel.innerHTML = classForm(classes.find((c) => c.id === b.dataset.edit)!);
          panel.classList.remove('hidden');
          wire(panel);
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-roster]').forEach((b) =>
        b.addEventListener('click', () => {
          const panel = content.querySelector<HTMLElement>(`[data-rosterpanel="${b.dataset.roster}"]`)!;
          if (!panel.classList.contains('hidden')) return panel.classList.add('hidden');
          panel.classList.remove('hidden');
          openRoster(b.dataset.roster!, panel);
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-arch]').forEach((b) =>
        b.addEventListener('click', async () => {
          const [id, to] = b.dataset.arch!.split(':');
          if (to === '0' && !confirm('Archive this class? Future empty sessions are removed and it disappears from the family app.')) return;
          const { error: e } = await supabase.rpc('admin_set_class_active', { p_class: id, p_active: to === '1' });
          if (e) return toast(errMsg(e), 'err');
          render();
        })
      );
    }

    (async () => {
      ctx = await requireAuth(['admin'], 'classes');
      await render();
    })().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
