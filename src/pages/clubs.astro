---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Your clubs">
  <div class="max-w-lg mx-auto">
    <p class="eyebrow">Clubs</p>
    <h1 class="text-2xl mt-1 mb-5">Your clubs</h1>
    <div id="memberships" class="mb-6"></div>

    <div class="surface-card p-5 mb-5">
      <h2 class="text-base font-semibold mb-1">Join a club</h2>
      <p class="text-xs text-mist-500 mb-3">Got the club's 6-character code? You're in instantly. No code? Search and request to join.</p>
      <div class="flex gap-2 mb-4">
        <input class="field flex-1 uppercase" id="code" maxlength="6" placeholder="Club code e.g. 7F2KQ9" />
        <button class="btn btn-primary" id="code-join">Join</button>
      </div>
      <div class="flex gap-2">
        <input class="field flex-1" id="q" placeholder="Search clubs by name…" />
        <button class="btn btn-ghost" id="search">Search</button>
      </div>
      <div id="results" class="mt-3"></div>
    </div>

    <div class="surface-card p-5 text-center">
      <h2 class="text-base font-semibold">Run a club?</h2>
      <p class="text-xs text-mist-500 mt-1 mb-3">Set yours up in a few minutes — free.</p>
      <a href="/start" class="btn btn-primary btn-sm">Start your club</a>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';
    import { requireAuth, setActiveClub, esc, toast, errMsg } from '../lib/app';

    const membershipsEl = document.getElementById('memberships')!;

    async function render() {
      // an unfinished start-a-club signup? send them back to complete it
      if (localStorage.getItem('icm-pending-club')) {
        location.href = '/start';
        return;
      }
      const ctx = await requireAuth();
      const rows = ctx.memberships.filter((m) => m.status !== 'removed');
      membershipsEl.innerHTML = rows.length
        ? rows
            .map((m) => {
              const suspended = m.clubs.status !== 'active';
              const pending = m.status === 'pending';
              return `
          <div class="surface-card p-4 mb-3 flex items-center justify-between gap-3 ${suspended ? 'opacity-60' : ''}">
            <div>
              <p class="font-semibold">${esc(m.clubs.name)}</p>
              <p class="text-xs text-mist-500">${pending ? '⏳ waiting for approval' : m.role}${suspended ? ' · currently unavailable' : ''}</p>
            </div>
            ${!pending && !suspended ? `<button class="btn btn-primary btn-sm" data-open="${m.club_id}">Open</button>` : ''}
          </div>`;
            })
            .join('')
        : '<div class="surface-card p-6 text-center text-sm text-mist-500">You\'re not part of a club yet — join one below, or start your own.</div>';

      membershipsEl.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
        b.addEventListener('click', async () => {
          await setActiveClub(b.dataset.open!);
          location.href = '/dashboard';
        })
      );
    }

    document.getElementById('code-join')?.addEventListener('click', async () => {
      const code = (document.getElementById('code') as HTMLInputElement).value.trim();
      if (code.length < 4) return toast('Enter the club code.', 'err');
      const { data, error } = await supabase.rpc('join_by_code', { p_code: code });
      if (error) return toast(errMsg(error), 'err');
      toast(`Welcome to ${(data as { name: string }).name}! 🎉`);
      await setActiveClub((data as { club_id: string }).club_id);
      location.href = '/dashboard';
    });

    document.getElementById('search')?.addEventListener('click', async () => {
      const q = (document.getElementById('q') as HTMLInputElement).value.trim();
      const { data, error } = await supabase.rpc('clubs_search', { p_q: q });
      if (error) return toast(errMsg(error), 'err');
      const results = (data ?? []) as { name: string; slug: string; blurb: string | null }[];
      document.getElementById('results')!.innerHTML = results.length
        ? results
            .map(
              (c) => `
          <div class="py-2.5 border-t border-ink-700 flex items-center justify-between gap-2">
            <div>
              <p class="text-sm font-medium">${esc(c.name)}</p>
              ${c.blurb ? `<p class="text-xs text-mist-500">${esc(c.blurb)}</p>` : ''}
            </div>
            <button class="btn btn-ghost btn-sm" data-req="${esc(c.slug)}">Request to join</button>
          </div>`
            )
            .join('')
        : '<p class="text-sm text-mist-500 pt-2">No clubs found.</p>';
      document.querySelectorAll<HTMLButtonElement>('[data-req]').forEach((b) =>
        b.addEventListener('click', async () => {
          const { data: res, error: e } = await supabase.rpc('request_join', { p_slug: b.dataset.req });
          if (e) return toast(errMsg(e), 'err');
          if ((res as { status: string }).status === 'active') {
            toast('You are already a member!');
          } else {
            toast('Request sent — the club will approve you shortly.');
          }
          render();
        })
      );
    });

    render().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
