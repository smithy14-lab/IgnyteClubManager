---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Events">
  <p class="eyebrow">Events</p>
  <h1 class="text-2xl mt-1 mb-5">Comps, showcases &amp; camps</h1>
  <div id="content"><p class="text-mist-500 text-sm">Loading…</p></div>

  <script>
    import { supabase } from '../lib/supabase';
    import { requireAuth, myAthletes, esc, toast, errMsg, fmtDate, fmtTime, type AuthCtx } from '../lib/app';

    const content = document.getElementById('content')!;
    let ctx: AuthCtx;

    async function render() {
      const club = ctx.club!;
      const [{ data: events }, athletes, { data: settings }] = await Promise.all([
        supabase.from('events').select('*, locations(name)').eq('club_id', club.id).eq('active', true).gte('event_date', new Date().toISOString().slice(0, 10)).order('event_date'),
        myAthletes(club.id),
        supabase.from('club_settings').select('currency').eq('club_id', club.id).single(),
      ]);
      const sym = settings?.currency ?? '£';
      const mine = athletes.filter((a) => a.enrolled);
      const mineIds = mine.map((a) => a.id);
      const { data: signups } = mineIds.length
        ? await supabase.from('event_signups').select('id, event_id, athlete_id, status').in('athlete_id', mineIds).eq('status', 'booked')
        : { data: [] };

      if (!(events ?? []).length) {
        content.innerHTML = '<div class="surface-card p-5"><p class="text-sm text-mist-500">Nothing on the calendar yet — check back soon!</p></div>';
        return;
      }
      content.innerHTML = (events ?? [])
        .map((e) => {
          const locName = (e.locations as unknown as { name: string } | null)?.name;
          const states = mine
            .map((a) => {
              const s = (signups ?? []).find((x) => x.event_id === e.id && x.athlete_id === a.id);
              return s
                ? `<span class="pill pill-success">${esc(a.name.split(' ')[0])} ✓ in</span><button class="btn btn-ghost btn-sm" data-out="${s.id}">Pull out</button>`
                : '';
            })
            .filter(Boolean)
            .join(' ');
          return `
        <div class="surface-card p-5 mb-4" data-ev="${e.id}">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div>
              <h2 class="font-semibold">${esc(e.name)}</h2>
              <p class="text-xs text-mist-400 mt-0.5">${fmtDate(e.event_date)}${e.start_time ? ' · ' + fmtTime(e.start_time) : ''}${locName ? ' · ' + esc(locName) : ''}</p>
            </div>
            ${Number(e.fee) > 0 ? `<span class="font-display font-semibold ignite-text">${sym}${Number(e.fee).toFixed(2)}</span>` : '<span class="pill pill-success">free</span>'}
          </div>
          ${e.description ? `<p class="text-xs text-mist-400 mt-2">${esc(e.description)}</p>` : ''}
          ${states ? `<div class="mt-3 flex flex-wrap gap-1.5 items-center">${states}</div>` : ''}
          ${
            mine.length
              ? `<div class="mt-3 pt-3 border-t border-ink-700 flex flex-wrap gap-2 items-center">
                  <select class="field !w-auto !py-1.5 !text-xs" data-ath="${e.id}">
                    ${mine.map((a) => `<option value="${a.id}">${esc(a.name)}</option>`).join('')}
                  </select>
                  <button class="btn btn-primary btn-sm" data-signup="${e.id}">Sign up</button>
                </div>`
              : ''
          }
        </div>`;
        })
        .join('');

      content.querySelectorAll<HTMLButtonElement>('[data-signup]').forEach((b) =>
        b.addEventListener('click', async () => {
          const ath = (content.querySelector(`[data-ath="${b.dataset.signup}"]`) as HTMLSelectElement).value;
          const { data, error } = await supabase.rpc('signup_event', { p_event: b.dataset.signup, p_athlete: ath });
          if (error) return toast(errMsg(error), 'err');
          toast(data?.invoiced ? 'Signed up! The fee is on your Money page. 🎪' : 'Signed up! 🎪');
          render();
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-out]').forEach((b) =>
        b.addEventListener('click', async () => {
          if (!confirm('Pull out of this event? Any unpaid fee is voided.')) return;
          const { error } = await supabase.rpc('cancel_event_signup', { p_signup: b.dataset.out });
          if (error) return toast(errMsg(error), 'err');
          render();
        })
      );
    }

    (async () => {
      ctx = await requireAuth(['parent', 'athlete', 'admin']);
      await render();
    })().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
