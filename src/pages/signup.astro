---
import AppLayout from '../layouts/AppLayout.astro';
import IgnyteMark from '../components/IgnyteMark.astro';
---

<AppLayout title="Create account" chrome={false}>
  <div class="max-w-sm mx-auto mt-10">
    <div class="text-center mb-6">
      <IgnyteMark size={52} />
      <h1 class="text-2xl mt-3">Create your account</h1>
      <p class="text-sm text-mist-400 mt-1">One login for parents, athletes, coaches and clubs.</p>
    </div>
    <form id="signup" class="surface-card p-6 flex flex-col gap-4">
      <div>
        <label class="form-label" for="name">Your name</label>
        <input class="field" id="name" autocomplete="name" required maxlength="60" />
      </div>
      <div>
        <label class="form-label" for="email">Email</label>
        <input class="field" id="email" type="email" autocomplete="email" required />
      </div>
      <div>
        <label class="form-label" for="phone">Mobile <span class="text-mist-500 font-normal">(so your coach can reach you)</span></label>
        <input class="field" id="phone" type="tel" autocomplete="tel" />
      </div>
      <div>
        <label class="form-label" for="pw">Password</label>
        <input class="field" id="pw" type="password" autocomplete="new-password" minlength="8" required />
      </div>
      <div>
        <label class="form-label" for="code">Club code <span class="text-mist-500 font-normal">(optional — your club gives you this)</span></label>
        <input class="field uppercase" id="code" maxlength="6" placeholder="e.g. STORM1" />
        <p class="text-xs text-mist-500 mt-1">Coaches and club staff: skip this — your club has already added your email.</p>
      </div>
      <button class="btn btn-primary" type="submit" id="go">Create account</button>
    </form>
    <div id="confirm" class="hidden surface-card p-6 text-center mt-4">
      <p class="text-3xl">📧</p>
      <h2 class="text-lg mt-2">Check your email</h2>
      <p class="text-sm text-mist-400 mt-2">Tap the link we sent you, then <a href="/" class="text-ignite-400">sign in</a>. Your club code will be applied automatically.</p>
    </div>
    <p class="text-sm text-center text-mist-400 mt-5">Already have an account? <a href="/" class="text-ignite-400 font-semibold">Sign in</a></p>
  </div>

  <script>
    import { supabase } from '../lib/supabase';
    import { toast, errMsg } from '../lib/app';

    const q = new URLSearchParams(location.search);
    const codeEl = document.getElementById('code') as HTMLInputElement;
    if (q.get('code')) codeEl.value = q.get('code')!.toUpperCase();

    (document.getElementById('signup') as HTMLFormElement).addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('go') as HTMLButtonElement;
      btn.disabled = true;
      const full_name = (document.getElementById('name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
      const password = (document.getElementById('pw') as HTMLInputElement).value;
      const code = codeEl.value.trim().toUpperCase();
      const { data, error } = await supabase.auth.signUp({
        email, password,
        options: { data: { full_name, phone }, emailRedirectTo: location.origin + '/dashboard' },
      });
      btn.disabled = false;
      if (error) return toast(errMsg(error), 'err');
      if (code) localStorage.setItem('ignyte-pending-code', code);
      if (data.session) {
        location.href = '/dashboard';
      } else {
        document.getElementById('signup')!.classList.add('hidden');
        document.getElementById('confirm')!.classList.remove('hidden');
      }
    });
  </script>
</AppLayout>
