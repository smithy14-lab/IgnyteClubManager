---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Book a lesson">
  <div class="max-w-lg mx-auto">
    <div class="flex items-center justify-between gap-2 mb-4">
      <h1 class="text-2xl">Book a 1-2-1</h1>
      <a id="back" href="/family" class="btn btn-ghost btn-sm">← Back</a>
    </div>
    <div id="content"><p class="text-sm text-mist-500">Loading…</p></div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';
    import { requireAuth, myAthletes, schedule, startOfDay, addDays, esc, toast, errMsg, money, fmtTime, fmtDay, dayKey, groupByDay, type Ctx, type ScheduleRow, type Athlete } from '../lib/app';

    const content = document.getElementById('content')!;
    const q = new URLSearchParams(location.search);
    const back = q.get('back') || '/family';
    (document.getElementById('back') as HTMLAnchorElement).href = back;

    let ctx: Ctx;
    let athletes: Athlete[] = [];
    let rows: ScheduleRow[] = [];
    let athleteId = q.get('athlete') || '';
    let coachId = '';
    let day = '';

    function open(): ScheduleRow[] {
      return rows.filter((r) => !r.lesson_id && r.slot_status === 'open' && new Date(r.starts_at).getTime() > Date.now() && (!coachId || r.coach_id === coachId));
    }

    function render() {
      const club = ctx.club!;
      const coaches = [...new Map(rows.filter((r) => !r.lesson_id).map((r) => [r.coach_id, r.coach_name])).entries()];
      const avail = open();
      const days = groupByDay(avail);
      if (day && !days.some(([k]) => k === day)) day = '';
      const times = day ? avail.filter((r) => dayKey(r.starts_at) === day) : [];
      content.innerHTML = `
        <section class="surface-card p-4 mb-3">
          <p class="text-xs font-semibold uppercase tracking-widest text-mist-500 mb-2">1 · Who's the lesson for?</p>
          <div class="flex flex-wrap gap-1.5">
            ${athletes.map((a) => `<button class="portal-chip ${a.id === athleteId ? 'active' : ''}" data-ath="${a.id}">${esc(a.name)}</button>`).join('')}
            <a class="portal-chip" href="/family#athletes">＋ Add athlete</a>
          </div>
        </section>
        ${coaches.length > 1 ? `<section class="surface-card p-4 mb-3">
          <p class="text-xs font-semibold uppercase tracking-widest text-mist-500 mb-2">2 · Coach</p>
          <div class="flex flex-wrap gap-1.5">
            <button class="portal-chip ${!coachId ? 'active' : ''}" data-coach="">Any coach</button>
            ${coaches.map(([id, name]) => `<button class="portal-chip ${id === coachId ? 'active' : ''}" data-coach="${id}">${esc(name)}</button>`).join('')}
          </div>
        </section>` : ''}
        <section class="surface-card p-4 mb-3">
          <p class="text-xs font-semibold uppercase tracking-widest text-mist-500 mb-2">${coaches.length > 1 ? '3' : '2'} · Pick a day</p>
          ${days.length ? `<div class="grid grid-cols-2 sm:grid-cols-3 gap-1.5">
            ${days.map(([k, list]) => `<button class="rounded-lg border px-3 py-2 text-left text-sm ${k === day ? 'border-ignite-500 bg-ignite-500/10' : 'border-ink-700 bg-ink-900 hover:border-ink-500'}" data-day="${k}">
              <b class="block">${fmtDay(list[0].starts_at)}</b><span class="text-xs text-mist-500">${list.length} time${list.length === 1 ? '' : 's'}</span></button>`).join('')}
          </div>` : `<p class="text-sm text-mist-500">No open times in the next 6 weeks${coachId ? ' with this coach' : ''}. Ask the club to add availability.</p>`}
        </section>
        ${day ? `<section class="surface-card p-4">
          <p class="text-xs font-semibold uppercase tracking-widest text-mist-500 mb-2">${coaches.length > 1 ? '4' : '3'} · Pick a time · ${fmtDay(times[0].starts_at)}</p>
          <div class="flex flex-col gap-1.5">
            ${times.map((r) => `<button class="flex items-center gap-3 rounded-lg border border-ink-700 bg-ink-900 hover:border-ignite-500 px-3 py-2.5 text-left text-sm" data-slot="${r.slot_id}">
              <b class="font-display tabular-nums">${fmtTime(r.starts_at)}</b><span class="flex-1">${esc(r.coach_name)}</span><span class="text-xs text-mist-500">${r.minutes} min · ${money(r.price_pence, club.currency)}</span></button>`).join('')}
          </div>
        </section>` : ''}`;
      content.querySelectorAll<HTMLButtonElement>('[data-ath]').forEach((b) => b.addEventListener('click', () => { athleteId = b.dataset.ath!; render(); }));
      content.querySelectorAll<HTMLButtonElement>('[data-coach]').forEach((b) => b.addEventListener('click', () => { coachId = b.dataset.coach!; render(); }));
      content.querySelectorAll<HTMLButtonElement>('[data-day]').forEach((b) => b.addEventListener('click', () => { day = b.dataset.day!; render(); }));
      content.querySelectorAll<HTMLButtonElement>('[data-slot]').forEach((b) =>
        b.addEventListener('click', async () => {
          if (!athleteId) return toast('Choose who the lesson is for first.', 'err');
          const r = rows.find((x) => x.slot_id === b.dataset.slot)!;
          const a = athletes.find((x) => x.id === athleteId)!;
          if (!confirm(`Book ${a.name} with ${r.coach_name} on ${fmtDay(r.starts_at)} at ${fmtTime(r.starts_at)} (${money(r.price_pence, club.currency)})?`)) return;
          const { error } = await supabase.rpc('book_slot', { p_slot: r.slot_id, p_athlete: athleteId });
          if (error) return toast(errMsg(error), 'err');
          toast('Booked! 🎉');
          location.href = back;
        })
      );
    }

    (async () => {
      ctx = await requireAuth(['parent', 'athlete', 'owner', 'admin', 'coach']);
      athletes = await myAthletes(ctx.club!.id);
      if (!athletes.length) {
        content.innerHTML = `<div class="surface-card p-5 text-sm"><p>Add an athlete first — a child, or yourself if you train.</p><a class="btn btn-primary btn-sm mt-3" href="/family#athletes">Add athlete</a></div>`;
        return;
      }
      if (!athletes.some((a) => a.id === athleteId)) athleteId = athletes.length === 1 ? athletes[0].id : '';
      rows = await schedule(ctx.club!.id, new Date(), addDays(startOfDay(), 43));
      render();
    })().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
  <style>
    .portal-chip { display: inline-flex; align-items: center; padding: 0.4rem 0.8rem; border-radius: 999px; border: 1px solid var(--color-ink-600); color: var(--color-mist-300); font-size: 0.85rem; font-weight: 500; }
    .portal-chip:hover { border-color: var(--color-ignite-500); color: var(--color-ignite-400); }
    .portal-chip.active { background: var(--color-ignite-500); border-color: var(--color-ignite-500); color: #fff; }
  </style>
</AppLayout>
