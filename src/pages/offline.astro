---
import AppLayout from '../layouts/AppLayout.astro';
import IgnyteMark from '../components/IgnyteMark.astro';
---

<AppLayout title="Offline" chrome={false}>
  <div class="max-w-sm mx-auto mt-16 text-center">
    <IgnyteMark size={48} />
    <h1 class="text-2xl mt-3">You're offline</h1>
    <p class="text-sm text-mist-400 mt-2">Booking needs a connection. We'll pick up where you left off.</p>
    <a href="/dashboard" class="btn btn-primary mt-5">Try again</a>
  </div>
</AppLayout>
