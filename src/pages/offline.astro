---
import AppLayout from '../layouts/AppLayout.astro';
import IgnyteMark from '../components/IgnyteMark.astro';
---

<AppLayout title="Offline" chrome={false}>
  <section class="min-h-[70dvh] flex flex-col items-center justify-center text-center">
    <IgnyteMark size={56} />
    <h1 class="mt-6 text-2xl">You're offline</h1>
    <p class="mt-3 max-w-sm text-mist-400 text-sm">
      This page isn't cached yet. Pages you've visited before are available offline — booking and
      cancelling need a connection.
    </p>
    <button onclick="location.reload()" class="btn btn-primary mt-6">Try again</button>
  </section>
</AppLayout>
