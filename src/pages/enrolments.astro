---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Enrolments">
  <p class="eyebrow">Your teams</p>
  <div class="flex items-center justify-between gap-2 mt-1 mb-5">
    <h1 class="text-2xl">Enrolments</h1>
    <a href="/classes" class="btn btn-ghost btn-sm">Browse classes →</a>
  </div>
  <div id="content"><p class="text-mist-500 text-sm">Loading…</p></div>

  <script>
    import { supabase } from '../lib/supabase';
    import { requireAuth, myAthletes, fmtTime, esc, toast, errMsg } from '../lib/app';

    const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const content = document.getElementById('content')!;

    async function render() {
      const ctx = await requireAuth(['parent', 'athlete', 'admin'], 'enrolments');
      const club = ctx.club!;
      const athletes = (await myAthletes(club.id)).filter((a) => a.enrolled);
      const ids = athletes.map((a) => a.id);

      if (!ids.length) {
        content.innerHTML =
          '<div class="surface-card p-8 text-center text-sm text-mist-500">No athletes yet — add one on your <a class="text-ignite-400" href="/athletes">Profile</a>, then enrol them in a class.</div>';
        return;
      }

      const { data: enr, error } = await supabase
        .from('class_enrolments')
        .select('athlete_id, status, class_groups(name, discipline, day_of_week, start_time, end_time, profiles:lead_coach_id(full_name), locations(name))')
        .eq('club_id', club.id)
        .in('athlete_id', ids)
        .eq('status', 'enrolled');
      if (error) return toast(errMsg(error), 'err');

      const byAthlete = new Map<string, any[]>();
      (enr ?? []).forEach((e) => (byAthlete.get(e.athlete_id) ?? byAthlete.set(e.athlete_id, []).get(e.athlete_id)!).push(e));

      content.innerHTML = athletes
        .map((a) => {
          const teams = byAthlete.get(a.id) ?? [];
          return `
        <div class="surface-card p-5 mb-4">
          <h2 class="text-base font-semibold mb-1">${esc(a.name)}</h2>
          ${
            teams.length
              ? teams
                  .map((t) => {
                    const g = t.class_groups as {
                      name: string; discipline: string; day_of_week: number; start_time: string; end_time: string;
                      profiles: { full_name: string } | null; locations: { name: string } | null;
                    } | null;
                    if (!g) return '';
                    return `
                <div class="py-3 border-t border-ink-700 first:border-0">
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-sm font-medium">${esc(g.name)}</p>
                    <span class="pill">${esc(g.discipline)}</span>
                  </div>
                  <p class="text-xs text-mist-400 mt-1">
                    ${DAYS[g.day_of_week]} · ${fmtTime(g.start_time)}–${fmtTime(g.end_time)}
                    ${g.locations?.name ? ` · ${esc(g.locations.name)}` : ''}
                    ${g.profiles?.full_name ? ` · Coach ${esc(g.profiles.full_name)}` : ''}
                  </p>
                </div>`;
                  })
                  .join('')
              : '<p class="text-sm text-mist-500 mt-1">Not on any team yet. <a class="text-ignite-400" href="/classes">Find a class →</a></p>'
          }
        </div>`;
        })
        .join('');
    }

    render().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
