---
// Public club portal. Served at /c/{slug} via the worker rewrite (or ?s=slug).
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Club">
  <div id="portal" class="max-w-lg mx-auto py-6">
    <p class="text-mist-500 text-sm text-center">Loading club…</p>
  </div>

  <script>
    import { supabase } from '../lib/supabase';
    import { esc, toast, errMsg, setActiveClub } from '../lib/app';

    const portal = document.getElementById('portal')!;
    const m = location.pathname.match(/^\/c\/([a-z0-9-]+)/);
    const slug = m?.[1] ?? new URLSearchParams(location.search).get('s') ?? '';

    async function render() {
      if (!slug) {
        portal.innerHTML = '<p class="text-center text-mist-500">No club specified.</p>';
        return;
      }
      const [{ data }, { data: session }] = await Promise.all([
        supabase.rpc('get_club_public', { p_slug: slug }),
        supabase.auth.getSession(),
      ]);
      if (!data) {
        portal.innerHTML = `
          <div class="surface-card p-8 text-center">
            <h1 class="text-xl">Club not found</h1>
            <p class="text-sm text-mist-500 mt-2">This club may have closed or changed its link.</p>
            <a href="/" class="btn btn-ghost btn-sm mt-4">Ignyte Club Manager</a>
          </div>`;
        return;
      }
      const c = data as {
        name: string; slug: string; blurb: string | null; accent_color: string | null;
        coaches: { name: string; disciplines: string[] | null; levels: string | null }[];
        upcoming_slots: number; locations: string[];
        classes?: { name: string; discipline: string; day_of_week: number; start_time: string; end_time: string;
          age_min: number | null; age_max: number | null; monthly_fee: number | null;
          price_per_session: number | null; trial_allowed: boolean }[];
      };
      const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      if (c.accent_color) {
        document.documentElement.style.setProperty('--color-ignite-500', c.accent_color);
        document.documentElement.style.setProperty('--color-ignite-400', c.accent_color);
        document.documentElement.style.setProperty('--color-ignite-600', c.accent_color);
      }
      const signedIn = Boolean(session.session);

      portal.innerHTML = `
        <div class="text-center animate-rise">
          <div class="mx-auto w-16 h-16 rounded-2xl flex items-center justify-center font-display font-bold text-white text-xl"
            style="background: linear-gradient(135deg, var(--color-charge-400), var(--color-ignite-500), var(--color-spark-500))">
            ${esc(c.name.slice(0, 2).toUpperCase())}
          </div>
          <h1 class="text-2xl mt-4">${esc(c.name)}</h1>
          ${c.blurb ? `<p class="text-sm text-mist-400 mt-2">${esc(c.blurb)}</p>` : ''}
          ${c.locations.length ? `<p class="text-xs text-mist-500 mt-2">📍 ${c.locations.map((l) => esc(l)).join(' · ')}</p>` : ''}
        </div>

        <div class="surface-card p-5 mt-6">
          <p class="text-sm font-semibold">⚡ Book 1-2-1 private lessons online</p>
          <p class="text-xs text-mist-500 mt-1">${c.upcoming_slots} slot${c.upcoming_slots === 1 ? '' : 's'} open in the next two weeks.</p>
        </div>

        ${
          (c.classes ?? []).length
            ? `<div class="surface-card p-5 mt-4">
                <p class="text-sm font-semibold mb-2">🤸 Weekly classes</p>
                ${(c.classes ?? [])
                  .map(
                    (g) => `<div class="py-1.5 border-t border-ink-700 first:border-0 flex items-center justify-between gap-2">
                      <p class="text-sm">${esc(g.name)}
                        <span class="text-xs text-mist-500">· ${DAYS[g.day_of_week]}s ${g.start_time.slice(0, 5)}–${g.end_time.slice(0, 5)}${g.age_min != null || g.age_max != null ? ` · ages ${g.age_min ?? 0}–${g.age_max ?? '99+'}` : ''}</span></p>
                      ${g.trial_allowed ? '<span class="pill pill-accent">trials open</span>' : ''}
                    </div>`
                  )
                  .join('')}
                <p class="text-xs text-mist-500 mt-2">Join below to enrol or book a trial.</p>
              </div>`
            : ''
        }

        ${
          c.coaches.length
            ? `<div class="surface-card p-5 mt-4">
                <p class="text-sm font-semibold mb-2">Our coaches</p>
                ${c.coaches
                  .map(
                    (co) => `<p class="text-sm py-1.5 border-t border-ink-700 first:border-0">${esc(co.name)}
                      <span class="text-xs text-mist-500">${co.disciplines?.length ? '· ' + co.disciplines.join(' + ') : ''}${co.levels ? ' · ' + esc(co.levels) : ''}</span></p>`
                  )
                  .join('')}
              </div>`
            : ''
        }

        <div class="surface-card p-5 mt-4">
          <p class="text-sm font-semibold mb-2">Join ${esc(c.name)}</p>
          <p class="text-xs text-mist-500 mb-3">Have the club's code? You're in instantly. Otherwise send a join request and the club will approve you.</p>
          <div class="flex gap-2 mb-3">
            <input class="field flex-1 uppercase" id="p-code" maxlength="6" placeholder="Club code (optional)" />
            <button class="btn btn-primary" id="p-join">Join</button>
          </div>
          ${signedIn ? '' : `<p class="text-xs text-mist-500">You'll create your (free) family account first — takes a minute.</p>`}
          <a href="/login" class="text-xs text-ignite-400 ${signedIn ? 'hidden' : ''}">Already have an account? Sign in</a>
        </div>`;

      document.getElementById('p-join')?.addEventListener('click', async () => {
        const code = (document.getElementById('p-code') as HTMLInputElement).value.trim();
        if (!signedIn) {
          location.href = `/signup?club=${encodeURIComponent(c.slug)}${code ? `&code=${encodeURIComponent(code)}` : ''}`;
          return;
        }
        try {
          if (code) {
            const { data: res, error } = await supabase.rpc('join_by_code', { p_code: code });
            if (error) throw error;
            await setActiveClub((res as { club_id: string }).club_id);
            toast(`Welcome to ${c.name}! 🎉`);
            setTimeout(() => (location.href = '/dashboard'), 800);
          } else {
            const { data: res, error } = await supabase.rpc('request_join', { p_slug: c.slug });
            if (error) throw error;
            if ((res as { status: string }).status === 'active') {
              location.href = '/dashboard';
            } else {
              toast('Request sent — the club will approve you shortly.');
            }
          }
        } catch (e) {
          toast(errMsg(e), 'err');
        }
      });
    }

    render().catch((e) => toast(errMsg(e), 'err'));
  </script>
</AppLayout>
