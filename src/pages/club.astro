---
// Public club site. Served at /c/{slug} and /c/{slug}/{page} via the worker
// rewrite (or ?s=slug). Clubs with the website feature get a multi-page site
// (custom pages + classes + coaches + contact); everyone else gets the
// single-page portal.
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Club" chrome={false}>
  <div class="min-h-dvh flex flex-col">
    <div id="portal" class="max-w-2xl w-full mx-auto py-8 px-4 flex-1">
      <p class="text-mist-500 text-sm text-center">Loading club…</p>
    </div>
    <footer class="py-5 text-center border-t border-ink-800">
      <a href="/" id="powered-by" class="text-xs text-mist-500 hover:text-ignite-400">
        ⚡ Powered by <span class="font-semibold">Ignyte Club Manager</span>
      </a>
      <a href="/dashboard" id="openapp-footer" class="hidden text-xs text-ignite-400 ml-3">Open the app →</a>
    </footer>
  </div>

  <script>
    import { supabase } from '../lib/supabase';
    import { esc, toast, errMsg, setActiveClub } from '../lib/app';

    const portal = document.getElementById('portal')!;
    const m = location.pathname.match(/^\/c\/([a-z0-9-]+)(?:\/([a-z0-9-]+))?/);
    let slug = m?.[1] ?? new URLSearchParams(location.search).get('s') ?? '';
    let pageSlug = m?.[2] ?? new URLSearchParams(location.search).get('p') ?? '';
    // Custom club domain: the host IS the club; the path is the page.
    const onCustomDomain = !slug && !/workers\.dev$|^localhost$|^127\./.test(location.hostname);
    if (onCustomDomain) pageSlug = location.pathname.replaceAll('/', '');
    if (pageSlug === 'signup') pageSlug = 'join';
    const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

    type Site = {
      name: string; slug: string; blurb: string | null; accent_color: string | null;
      website: boolean; open_join?: boolean;
      pages: { slug: string; title: string; body: string; blocks: Block[] | null }[];
      coaches: { name: string; disciplines: string[] | null; levels: string | null }[];
      upcoming_slots: number; locations: string[];
      shop?: { name: string; description: string | null; price: number; options: string[]; image_url: string | null; in_stock: boolean }[];
      events?: { name: string; description: string | null; event_date: string; start_time: string | null; fee: number | null }[];
      classes?: { name: string; discipline: string; day_of_week: number; start_time: string; end_time: string;
        age_min: number | null; age_max: number | null; monthly_fee: number | null;
        price_per_session: number | null; trial_allowed: boolean }[];
    };

    type Block = {
      type: string; heading?: string; sub?: string; md?: string; url?: string;
      caption?: string; side?: string; images?: string[]; label?: string; page?: string;
      cta_label?: string; cta_page?: string;
    };

    /** Wix-style sections: static blocks render content, live blocks render club data. */
    function renderBlocks(c: Site, blocks: Block[], signedIn: boolean): string {
      const img = (u?: string, cls = '') =>
        u && /^https:\/\//.test(u) ? `<img src="${esc(u)}" alt="" class="rounded-xl max-w-full ${cls}" loading="lazy" />` : '';
      return blocks
        .map((b) => {
          switch (b.type) {
            case 'hero':
              return `<div class="text-center py-8">
                ${b.heading ? `<h1 class="text-3xl font-display">${esc(b.heading)}</h1>` : ''}
                ${b.sub ? `<p class="text-mist-400 mt-3 max-w-xl mx-auto">${esc(b.sub)}</p>` : ''}
                ${b.url ? `<div class="mt-5 flex justify-center">${img(b.url, 'max-h-80 object-cover w-full')}</div>` : ''}
                ${b.cta_label ? `<a href="${link(b.cta_page ?? 'join')}" class="btn btn-primary mt-6">${esc(b.cta_label)}</a>` : ''}
              </div>`;
            case 'text':
              return `<div class="surface-card p-6 mt-4 text-left">${md(b.md ?? '')}</div>`;
            case 'image':
              return `<figure class="mt-4 text-center">${img(b.url, 'w-full object-cover')}
                ${b.caption ? `<figcaption class="text-xs text-mist-500 mt-2">${esc(b.caption)}</figcaption>` : ''}</figure>`;
            case 'image_text':
              return `<div class="surface-card p-6 mt-4 grid gap-5 sm:grid-cols-2 items-center">
                <div class="${b.side === 'right' ? 'sm:order-2' : ''}">${img(b.url, 'w-full object-cover')}</div>
                <div class="text-left">${md(b.md ?? '')}</div>
              </div>`;
            case 'gallery':
              return `<div class="mt-4 grid gap-2 grid-cols-2 sm:grid-cols-3">
                ${(b.images ?? []).slice(0, 12).map((u) => img(u, 'w-full h-36 object-cover')).join('')}
              </div>`;
            case 'cta':
              return `<div class="text-center mt-6"><a href="${link(b.page ?? 'join')}" class="btn btn-primary">${esc(b.label ?? 'Join us')}</a></div>`;
            case 'timetable':
              return classesHtml(c);
            case 'coaches':
              return coachesHtml(c);
            case 'events':
              return eventsHtml(c);
            case 'shop':
              return shopHtml(c);
            case 'contact':
              return contactHtml(c);
            default:
              return '';
          }
        })
        .join('');
    }

    /** Tiny markdown: headings, bold/italic, https links, lists, paragraphs. Escapes first. */
    function md(src: string): string {
      const inline = (s: string) =>
        s
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/\*([^*]+)\*/g, '<em>$1</em>')
          .replace(/!\[([^\]]*)\]\((https:\/\/[^)\s]+)\)/g, '<img src="$2" alt="$1" class="rounded-lg my-2 max-w-full" loading="lazy" />')
          .replace(/\[([^\]]+)\]\((https:\/\/[^)\s]+)\)/g, '<a class="text-ignite-400 underline" href="$2" target="_blank" rel="noopener">$1</a>');
      const blocks = esc(src).replace(/\r/g, '').split(/\n{2,}/);
      return blocks
        .map((b) => {
          const t = b.trim();
          if (!t) return '';
          if (/^### /.test(t)) return `<h3 class="text-base font-semibold mt-4">${inline(t.slice(4))}</h3>`;
          if (/^## /.test(t)) return `<h2 class="text-lg font-semibold mt-5">${inline(t.slice(3))}</h2>`;
          if (/^# /.test(t)) return `<h1 class="text-xl font-semibold mt-5">${inline(t.slice(2))}</h1>`;
          if (t.split('\n').every((l) => /^[-*] /.test(l.trim()))) {
            return `<ul class="list-disc pl-5 mt-3 flex flex-col gap-1 text-sm text-mist-300">${t
              .split('\n')
              .map((l) => `<li>${inline(l.trim().slice(2))}</li>`)
              .join('')}</ul>`;
          }
          return `<p class="mt-3 text-sm text-mist-300 leading-relaxed">${inline(t).replace(/\n/g, '<br />')}</p>`;
        })
        .join('');
    }

    // page targets are club-authored: hard-sanitise so nothing can escape the href
    const link = (p: string) => {
      const safe = (p ?? '').toLowerCase().replace(/[^a-z0-9-]/g, '');
      return onCustomDomain ? `/${safe}` : `/c/${slug}${safe ? '/' + safe : ''}`;
    };

    function classesHtml(c: Site) {
      return (c.classes ?? []).length
        ? `<div class="surface-card p-5 mt-4">
            <p class="text-sm font-semibold mb-2">🤸 Weekly classes</p>
            ${(c.classes ?? [])
              .map(
                (g) => `<div class="py-1.5 border-t border-ink-700 first:border-0 flex items-center justify-between gap-2">
                  <p class="text-sm">${esc(g.name)}
                    <span class="text-xs text-mist-500">· ${DAYS[g.day_of_week]}s ${g.start_time.slice(0, 5)}–${g.end_time.slice(0, 5)}${g.age_min != null || g.age_max != null ? ` · ages ${g.age_min ?? 0}–${g.age_max ?? '99+'}` : ''}</span></p>
                  ${g.trial_allowed ? '<span class="pill pill-accent">trials open</span>' : ''}
                </div>`
              )
              .join('')}
            <p class="text-xs text-mist-500 mt-2">Join the club to enrol or book a taster.</p>
          </div>`
        : '<p class="text-sm text-mist-500 mt-4">No group classes yet — 1-2-1 privates are bookable in the app.</p>';
    }

    function coachesHtml(c: Site) {
      return c.coaches.length
        ? `<div class="surface-card p-5 mt-4">
            <p class="text-sm font-semibold mb-2">Our coaches</p>
            ${c.coaches
              .map(
                (co) => `<p class="text-sm py-1.5 border-t border-ink-700 first:border-0">${esc(co.name)}
                  <span class="text-xs text-mist-500">${co.disciplines?.length ? '· ' + co.disciplines.join(' + ') : ''}${co.levels ? ' · ' + esc(co.levels) : ''}</span></p>`
              )
              .join('')}
          </div>`
        : '';
    }

    function joinHtml(c: Site, signedIn: boolean) {
      return `<div class="surface-card p-5 mt-4">
        <p class="text-sm font-semibold mb-2">Join ${esc(c.name)}</p>
        <p class="text-xs text-mist-500 mb-3">${c.open_join !== false ? 'Sign up and you\'re in — book, enrol and shop straight away.' : 'Sign up and the club will approve you — usually the same day.'}</p>
        ${
          signedIn
            ? `<button class="btn btn-primary" id="p-join">Join this club</button>
               <div class="mt-3 flex gap-2"><input class="field flex-1 uppercase" id="p-code" maxlength="6" placeholder="Club code (optional)" /></div>`
            : `<div class="flex flex-wrap gap-2">
                <a href="${link('join')}" class="btn btn-primary">Join online — free account</a>
                <a href="${link('login')}" class="btn btn-ghost">Member sign in</a>
              </div>`
        }
      </div>`;
    }

    function authHtml(c: Site, mode: 'login' | 'join') {
      return `<div class="surface-card p-6 mt-4 max-w-md mx-auto">
        <h2 class="text-lg font-semibold mb-1">${mode === 'login' ? `Sign in to ${esc(c.name)}` : `Join ${esc(c.name)}`}</h2>
        <p class="text-xs text-mist-500 mb-4">${
          mode === 'login'
            ? 'Your one Ignyte login works for every club you belong to.'
            : c.open_join !== false
              ? 'Free family account — you\'re in the club the moment you sign up.'
              : 'Free family account — the club approves new members, usually the same day.'
        }</p>
        <form id="auth-form" class="flex flex-col gap-3">
          ${mode === 'join' ? `
          <div><label class="form-label">Your name</label><input class="field" id="a-name" required autocomplete="name" /></div>
          <div><label class="form-label">Phone (optional)</label><input class="field" id="a-phone" type="tel" autocomplete="tel" /></div>` : ''}
          <div><label class="form-label">Email</label><input class="field" id="a-email" type="email" required autocomplete="email" /></div>
          <div><label class="form-label">Password</label><input class="field" id="a-pw" type="password" minlength="8" required autocomplete="${mode === 'login' ? 'current-password' : 'new-password'}" /></div>
          <button class="btn btn-primary w-full" type="submit">${mode === 'login' ? 'Sign in' : c.open_join !== false ? 'Create account & join' : 'Create account & request to join'}</button>
        </form>
        <p class="text-xs text-mist-500 mt-4">
          ${mode === 'login'
            ? `New here? <a class="text-ignite-400" href="${link('join')}">Join ${esc(c.name)}</a>`
            : `Already have an account? <a class="text-ignite-400" href="${link('login')}">Sign in</a>`}
        </p>
      </div>`;
    }

    async function activateAndGo(c: Site) {
      const { data: clubRow } = await supabase.from('clubs').select('id').eq('slug', c.slug).maybeSingle();
      if (clubRow) await setActiveClub(clubRow.id);
      location.href = '/dashboard';
    }

    function wireAuth(c: Site, mode: 'login' | 'join') {
      document.getElementById('auth-form')?.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const email = (document.getElementById('a-email') as HTMLInputElement).value.trim();
        const pw = (document.getElementById('a-pw') as HTMLInputElement).value;
        try {
          if (mode === 'login') {
            const { error } = await supabase.auth.signInWithPassword({ email, password: pw });
            if (error) throw error;
            toast(`Welcome back! 🔥`);
            await activateAndGo(c);
            return;
          }
          const { data, error } = await supabase.auth.signUp({
            email,
            password: pw,
            options: {
              data: {
                full_name: (document.getElementById('a-name') as HTMLInputElement).value.trim(),
                phone: (document.getElementById('a-phone') as HTMLInputElement).value.trim() || undefined,
                join_slug: c.slug,
              },
            },
          });
          if (error) throw error;
          if (data.session) {
            toast(c.open_join !== false ? `Welcome to ${c.name}! 🎉` : 'Account created — the club will approve you shortly.');
            await activateAndGo(c);
          } else {
            (document.getElementById('auth-form') as HTMLFormElement).outerHTML =
              '<p class="text-sm text-mist-300">📧 Check your email to confirm your account, then sign in here — your club membership is already set up.</p>';
          }
        } catch (e) {
          toast(errMsg(e), 'err');
        }
      });
    }

    function shopHtml(c: Site) {
      return (c.shop ?? []).length
        ? `<div class="surface-card p-5 mt-4">
            <p class="text-sm font-semibold mb-2">🛍️ Club shop</p>
            ${(c.shop ?? [])
              .map(
                (s) => `<div class="py-2 border-t border-ink-700 first:border-0 flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    ${s.image_url ? `<img src="${esc(s.image_url)}" alt="" class="w-10 h-10 rounded object-cover" loading="lazy" />` : ''}
                    <p class="text-sm">${esc(s.name)}${s.description ? ` <span class="text-xs text-mist-500">· ${esc(s.description)}</span>` : ''}</p>
                  </div>
                  <span class="text-sm font-semibold">£${Number(s.price).toFixed(2)}${s.in_stock ? '' : ' <span class="pill">out of stock</span>'}</span>
                </div>`
              )
              .join('')}
            <p class="text-xs text-mist-500 mt-2">Join the club to order — collection at training.</p>
          </div>`
        : '';
    }

    function eventsHtml(c: Site) {
      return (c.events ?? []).length
        ? `<div class="surface-card p-5 mt-4">
            <p class="text-sm font-semibold mb-2">🎪 Coming up</p>
            ${(c.events ?? [])
              .map(
                (e) => `<div class="py-1.5 border-t border-ink-700 first:border-0 flex items-center justify-between gap-2">
                  <p class="text-sm">${esc(e.name)}
                    <span class="text-xs text-mist-500">· ${new Date(e.event_date + 'T00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' })}${e.start_time ? ' ' + e.start_time.slice(0, 5) : ''}</span></p>
                  ${Number(e.fee) > 0 ? `<span class="text-sm">£${Number(e.fee).toFixed(2)}</span>` : ''}
                </div>`
              )
              .join('')}
          </div>`
        : '';
    }

    function contactHtml(c: Site) {
      return `<div class="surface-card p-5 mt-4">
        <p class="text-sm font-semibold mb-2">📬 Ask ${esc(c.name)} anything</p>
        <div class="grid gap-2">
          <input class="field" id="e-name" placeholder="Your name" />
          <input class="field" id="e-email" type="email" placeholder="you@email.com" />
          <textarea class="field" id="e-msg" rows="3" placeholder="Ages, experience, what you're looking for…"></textarea>
          <button class="btn btn-primary btn-sm" id="e-go">Send enquiry</button>
        </div>
      </div>`;
    }

    async function render() {
      if (!slug && onCustomDomain) {
        const { data: resolved } = await supabase.rpc('resolve_club_domain', { p_host: location.hostname });
        if (resolved) slug = resolved;
        // subdomain-per-club: blaze.<platform-domain> -> slug "blaze"
        if (!slug) {
          const label = location.hostname.split('.')[0];
          if (label && !['www', 'app'].includes(label)) slug = label;
        }
      }
      if (!slug) {
        portal.innerHTML = '<p class="text-center text-mist-500">No club specified.</p>';
        return;
      }
      const [{ data }, { data: session }] = await Promise.all([
        supabase.rpc('get_club_public', { p_slug: slug }),
        supabase.auth.getSession(),
      ]);
      if (!data) {
        portal.innerHTML = `
          <div class="surface-card p-8 text-center">
            <h1 class="text-xl">Club not found</h1>
            <p class="text-sm text-mist-500 mt-2">This club may have closed or changed its link.</p>
            <a href="/" class="btn btn-ghost btn-sm mt-4">Ignyte Club Manager</a>
          </div>`;
        return;
      }
      const c = data as Site;
      if (c.accent_color) {
        document.documentElement.style.setProperty('--color-ignite-500', c.accent_color);
        document.documentElement.style.setProperty('--color-ignite-400', c.accent_color);
        document.documentElement.style.setProperty('--color-ignite-600', c.accent_color);
      }
      const signedIn = Boolean(session.session);
      document.title = c.name;
      if (signedIn) document.getElementById('openapp-footer')?.classList.remove('hidden');
      const siteMode = c.website && (c.pages ?? []).length > 0;

      const hero = `
        <div class="text-center animate-rise">
          <div class="mx-auto w-16 h-16 rounded-2xl flex items-center justify-center font-display font-bold text-white text-xl"
            style="background: linear-gradient(135deg, var(--color-charge-400), var(--color-ignite-500), var(--color-spark-500))">
            ${esc(c.name.slice(0, 2).toUpperCase())}
          </div>
          <h1 class="text-2xl mt-4">${esc(c.name)}</h1>
          ${c.blurb ? `<p class="text-sm text-mist-400 mt-2">${esc(c.blurb)}</p>` : ''}
          ${c.locations.length ? `<p class="text-xs text-mist-500 mt-2">📍 ${c.locations.map((l) => esc(l)).join(' · ')}</p>` : ''}
        </div>`;

      const bookCallout = `
        <div class="surface-card p-5 mt-6">
          <p class="text-sm font-semibold">⚡ Book 1-2-1 private lessons online</p>
          <p class="text-xs text-mist-500 mt-1">${c.upcoming_slots} slot${c.upcoming_slots === 1 ? '' : 's'} open in the next two weeks.</p>
        </div>`;

      // Branded front door: works with or without the full site.
      if (pageSlug === 'login' || pageSlug === 'join') {
        const mode = pageSlug as 'login' | 'join';
        portal.innerHTML = hero + authHtml(c, mode);
        wireAuth(c, mode);
        return;
      }

      if (!siteMode) {
        portal.innerHTML =
          hero + bookCallout + classesHtml(c) + eventsHtml(c) + shopHtml(c) + coachesHtml(c) + contactHtml(c) + joinHtml(c, signedIn);
      } else {
        const navItems: [string, string][] = [
          ['Home', ''],
          ...c.pages.filter((p) => p.slug !== 'home').map((p) => [p.title, p.slug] as [string, string]),
          ['Classes', 'classes'],
          ...((c.shop ?? []).length ? [['Shop', 'shop'] as [string, string]] : []),
          ['Contact', 'contact'],
          ...(signedIn ? [] : [['Sign in', 'login'] as [string, string]]),
        ];
        const nav = `<nav class="flex flex-wrap gap-1.5 justify-center mt-6 mb-2">
          ${navItems
            .map(
              ([label, s]) =>
                `<a href="${link(s)}" class="btn btn-sm ${s === pageSlug ? 'btn-primary' : 'btn-ghost'}">${esc(label)}</a>`
            )
            .join('')}
        </nav>`;

        const page = c.pages.find((p) => p.slug === pageSlug);
        const homePage = c.pages.find((p) => p.slug === 'home');
        let bodyHtml: string;
        if (pageSlug === 'classes') bodyHtml = classesHtml(c) + joinHtml(c, signedIn);
        else if (pageSlug === 'shop') bodyHtml = shopHtml(c) + joinHtml(c, signedIn);
        else if (pageSlug === 'coaches') bodyHtml = coachesHtml(c) || '<p class="text-sm text-mist-500 mt-4">Coach profiles coming soon.</p>';
        else if (pageSlug === 'contact') bodyHtml = contactHtml(c);
        else if (page?.blocks?.length) bodyHtml = renderBlocks(c, page.blocks, signedIn);
        else if (page) bodyHtml = `<div class="surface-card p-6 mt-4 text-left">${md(page.body)}</div>`;
        else if (homePage?.blocks?.length) bodyHtml = renderBlocks(c, homePage.blocks, signedIn) + joinHtml(c, signedIn); // built home
        else bodyHtml = bookCallout + classesHtml(c) + eventsHtml(c) + coachesHtml(c) + joinHtml(c, signedIn); // default home

        portal.innerHTML = hero + nav + bodyHtml;
      }

      document.getElementById('e-go')?.addEventListener('click', async () => {
        const name = (document.getElementById('e-name') as HTMLInputElement).value;
        const email = (document.getElementById('e-email') as HTMLInputElement).value;
        const msg = (document.getElementById('e-msg') as HTMLTextAreaElement).value;
        const { error } = await supabase.rpc('submit_club_enquiry', { p_slug: slug, p_name: name, p_email: email, p_message: msg });
        if (error) return toast(errMsg(error), 'err');
        portal.querySelectorAll<HTMLInputElement>('#e-name,#e-email,#e-msg').forEach((i) => (i.value = ''));
        toast('Sent! The club will get back to you. 📬');
      });

      document.getElementById('p-join')?.addEventListener('click', async () => {
        const code = ((document.getElementById('p-code') as HTMLInputElement | null)?.value ?? '').trim();
        try {
          if (code) {
            const { data: res, error } = await supabase.rpc('join_by_code', { p_code: code });
            if (error) throw error;
            await setActiveClub((res as { club_id: string }).club_id);
            toast(`Welcome to ${c.name}! 🎉`);
            setTimeout(() => (location.href = '/dashboard'), 800);
          } else {
            const { data: res, error } = await supabase.rpc('request_join', { p_slug: c.slug });
            if (error) throw error;
            if ((res as { status: string }).status === 'active') {
              location.href = '/dashboard';
            } else {
              toast('Request sent — the club will approve you shortly.');
            }
          }
        } catch (e) {
          toast(errMsg(e), 'err');
        }
      });
    }

    render().catch((e) => toast(errMsg(e), 'err'));
  </script>
</AppLayout>
