---
import AppLayout from '../layouts/AppLayout.astro';

const tiers = [
  {
    name: 'Free',
    price: '£0',
    sub: 'a real club website and classes — actually free',
    highlight: false,
    features: [
      'Your club website — pages, enquiry form, live timetable',
      'Group classes: booking, registers & waiting lists',
      'Free taster trials with automatic follow-ups',
      'Club page, join codes & member approvals',
      'Up to 30 athletes',
    ],
    cta: ['Start free — set up in minutes', '/start'],
  },
  {
    name: 'Small',
    price: '£15/mo',
    sub: 'Free + the 1-2-1 privates engine, for growing clubs',
    highlight: false,
    features: [
      'Everything in Free, up to 100 athletes',
      '1-2-1 private lessons: slots, weekly series, coach cut-offs',
      'Skill journeys, badges & videos families love',
      'Invoicing & online payments — card, Direct Debit, 0% fees',
      'Late fees, chasing, credits, packs & makeup tokens',
      'Broadcasts + Excel money & coach-pay exports',
      'Paid taster trials',
    ],
    cta: ['Start free, upgrade when ready', '/start'],
  },
  {
    name: 'Club',
    price: '£35/mo',
    sub: 'everything, on your own domain — the full club platform',
    highlight: true,
    features: [
      'Everything in Small, unlimited athletes',
      'Monthly memberships billed on your chosen day',
      'Your own domain (yourclub.co.uk) + club mailbox',
      'Your branding — colours & logo everywhere',
      'Coach & family migration from your old system',
      'Priority support & early access',
    ],
    cta: ['Start free, upgrade any time', '/start'],
  },
];

const addons = [
  ['Privates', '£10/mo', '1-2-1 lesson management on its own: slots, weekly series, skill journeys, invoicing & online payments. Perfect if privates are all you run.'],
  ['Website Pro', '£10/mo', 'Just the website, properly yours: custom domain, club mailbox and your own colours & logo — on top of the free builder.'],
];
---

<AppLayout title="Pricing">
  <section class="max-w-3xl mx-auto py-10 text-center animate-rise">
    <p class="eyebrow justify-center flex">Pricing</p>
    <h1 class="text-3xl mt-2">Priced like a club, <span class="ignite-text">not a franchise.</span></h1>
    <p class="mt-3 text-mist-400 max-w-lg mx-auto">
      No per-member fees. No card machine contracts. One flat price a single private lesson
      pays for.
    </p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 text-left">
      {tiers.map((t) => (
        <div class={`surface-card p-6 ${t.highlight ? 'border-ignite-500/50' : ''}`} style={t.highlight ? 'box-shadow: var(--shadow-glow)' : ''}>
          {t.highlight && <span class="pill pill-accent mb-3">Early access — now</span>}
          <h2 class="text-lg font-semibold">{t.name}</h2>
          <p class="mt-1"><span class="text-3xl font-display font-bold ignite-text">{t.price}</span></p>
          <p class="text-xs text-mist-500 mt-0.5">{t.sub}</p>
          <ul class="mt-4 flex flex-col gap-2">
            {t.features.map((f) => (
              <li class="text-sm text-mist-300 flex gap-2"><span class="text-ignite-400">✓</span>{f}</li>
            ))}
          </ul>
          <a href={t.cta[1]} class={`btn ${t.highlight ? 'btn-primary' : 'btn-ghost'} mt-5 w-full`}>{t.cta[0]}</a>
        </div>
      ))}
    </div>
    <div class="mt-8 text-left">
      <p class="eyebrow justify-center flex">Or pick just what you need</p>
      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        {addons.map(([name, price, blurb]) => (
          <div class="surface-card p-5">
            <p class="text-sm font-semibold">{name} <span class="ignite-text font-display">{price}</span> <span class="text-xs text-mist-500">on top of Free</span></p>
            <p class="text-xs text-mist-400 mt-1.5">{blurb}</p>
          </div>
        ))}
      </div>
    </div>
    <p class="mt-6 text-xs text-mist-500">
      Every plan: payments stay between you and your families — we never take a cut of club revenue.
      Modules stack however you like; upgrade, downgrade or add on any time.
    </p>
  </section>
</AppLayout>
