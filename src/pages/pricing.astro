---
import AppLayout from '../layouts/AppLayout.astro';

const tiers = [
  {
    name: 'Free',
    price: '£0',
    sub: 'the basics, to get you off the spreadsheet',
    highlight: false,
    features: [
      '1-2-1 booking, weekly slots & waiting lists',
      'Registers on the coach’s phone',
      'Your own club page & join code',
      'Up to 40 athletes',
    ],
    cta: ['Start free — set up in minutes', '/start'],
  },
  {
    name: 'Privates',
    price: '£15/mo',
    sub: 'everything for a private-lesson club — nothing you don’t need',
    highlight: false,
    features: [
      'Everything in Free, unlimited athletes',
      'Skill journeys, badges & videos families love',
      'Invoicing & online payments — card, Direct Debit, 0% fees',
      'Late fees & automatic payment chasing',
      'Credits, packs & makeup tokens',
      'Broadcasts + Excel money & coach-pay exports',
    ],
    cta: ['Start free, upgrade when ready', '/start'],
  },
  {
    name: 'Club',
    price: '£29/mo',
    sub: 'the full club manager — classes, memberships, your brand',
    highlight: true,
    features: [
      'Everything in Privates',
      'Group classes, taster trials & class waiting lists',
      'Monthly memberships billed on your chosen day',
      'Your branding — colours & logo everywhere',
      'Coach & family migration from your old system',
      'Priority support & early access',
    ],
    cta: ['Start free, upgrade any time', '/start'],
  },
];
---

<AppLayout title="Pricing">
  <section class="max-w-3xl mx-auto py-10 text-center animate-rise">
    <p class="eyebrow justify-center flex">Pricing</p>
    <h1 class="text-3xl mt-2">Priced like a club, <span class="ignite-text">not a franchise.</span></h1>
    <p class="mt-3 text-mist-400 max-w-lg mx-auto">
      No per-member fees. No card machine contracts. One flat price a single private lesson
      pays for.
    </p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 text-left">
      {tiers.map((t) => (
        <div class={`surface-card p-6 ${t.highlight ? 'border-ignite-500/50' : ''}`} style={t.highlight ? 'box-shadow: var(--shadow-glow)' : ''}>
          {t.highlight && <span class="pill pill-accent mb-3">Early access — now</span>}
          <h2 class="text-lg font-semibold">{t.name}</h2>
          <p class="mt-1"><span class="text-3xl font-display font-bold ignite-text">{t.price}</span></p>
          <p class="text-xs text-mist-500 mt-0.5">{t.sub}</p>
          <ul class="mt-4 flex flex-col gap-2">
            {t.features.map((f) => (
              <li class="text-sm text-mist-300 flex gap-2"><span class="text-ignite-400">✓</span>{f}</li>
            ))}
          </ul>
          <a href={t.cta[1]} class={`btn ${t.highlight ? 'btn-primary' : 'btn-ghost'} mt-5 w-full`}>{t.cta[0]}</a>
        </div>
      ))}
    </div>
    <p class="mt-6 text-xs text-mist-500">
      Payments for lessons stay between you and your families — we never take a cut.
    </p>
  </section>
</AppLayout>
