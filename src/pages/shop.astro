---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Club shop">
  <p class="eyebrow">Shop</p>
  <h1 class="text-2xl mt-1 mb-5">Club shop</h1>
  <div id="content"><p class="text-mist-500 text-sm">Loading…</p></div>

  <script>
    import { supabase } from '../lib/supabase';
    import { requireAuth, esc, toast, errMsg, fmtDate, type AuthCtx } from '../lib/app';

    const content = document.getElementById('content')!;
    let ctx: AuthCtx;
    let sym = '£';

    const pill: Record<string, string> = {
      pending: 'pill pill-warn', paid: 'pill pill-success', collected: 'pill', cancelled: 'pill',
    };

    async function render() {
      const club = ctx.club!;
      const [{ data: products }, { data: orders }, { data: settings }] = await Promise.all([
        supabase.from('shop_products').select('*').eq('club_id', club.id).eq('active', true).order('sort').order('name'),
        supabase.from('shop_orders').select('*').eq('club_id', club.id).eq('buyer_id', ctx.profile.id).order('created_at', { ascending: false }).limit(20),
        supabase.from('club_settings').select('currency').eq('club_id', club.id).single(),
      ]);
      sym = settings?.currency ?? '£';
      const money = (n: unknown) => sym + Number(n).toFixed(2);

      content.innerHTML = `
        ${
          (products ?? []).length
            ? `<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-6">
          ${(products ?? [])
            .map(
              (p) => `
            <div class="surface-card p-5 flex flex-col" data-prod="${p.id}">
              ${p.image_url ? `<img src="${esc(p.image_url)}" alt="${esc(p.name)}" class="rounded-lg mb-3 w-full object-cover" style="max-height:140px" loading="lazy" />` : ''}
              <div class="flex items-start justify-between gap-2">
                <h2 class="font-semibold">${esc(p.name)}</h2>
                <span class="font-display font-semibold ignite-text">${money(p.price)}</span>
              </div>
              ${p.description ? `<p class="text-xs text-mist-400 mt-1">${esc(p.description)}</p>` : ''}
              ${p.stock != null && p.stock <= 3 ? `<p class="text-xs ${p.stock === 0 ? 'text-charge-400' : 'text-mist-500'} mt-1">${p.stock === 0 ? 'Out of stock' : 'Only ' + p.stock + ' left'}</p>` : ''}
              <div class="mt-3 pt-3 border-t border-ink-700 flex flex-wrap gap-2 items-center">
                ${(p.options ?? []).length ? `<select class="field !w-auto !py-1.5 !text-xs" data-opt>${(p.options as string[]).map((o) => `<option>${esc(o)}</option>`).join('')}</select>` : ''}
                <select class="field !w-auto !py-1.5 !text-xs" data-qty>${[1, 2, 3, 4, 5].map((n) => `<option>${n}</option>`).join('')}</select>
                <button class="btn btn-primary btn-sm" data-order="${p.id}" ${p.stock === 0 ? 'disabled' : ''}>Order</button>
              </div>
            </div>`
            )
            .join('')}
        </div>`
            : `<div class="surface-card p-5 mb-6"><p class="text-sm text-mist-500">${esc(club.name)} hasn't stocked the shop yet — check back soon!</p></div>`
        }

        ${
          (orders ?? []).length
            ? `<div class="surface-card p-5">
          <h2 class="text-base font-semibold mb-3">📦 My orders</h2>
          ${(orders ?? [])
            .map(
              (o) => `
            <div class="py-2.5 border-t border-ink-700 first:border-0 flex flex-wrap items-center justify-between gap-2">
              <div>
                <p class="text-sm">${esc(o.product_name)}${o.option_choice ? ` (${esc(o.option_choice)})` : ''} × ${o.qty}</p>
                <p class="text-xs text-mist-500 mt-0.5">${fmtDate(o.created_at)}${o.invoice_id && o.status === 'pending' ? ' · pay from your <a class="text-ignite-400 underline" href="/money">Money page</a>' : o.status === 'pending' ? ' · pay at the club' : ''}</p>
              </div>
              <div class="flex items-center gap-2">
                <span class="${pill[o.status] ?? 'pill'}">${o.status}</span>
                <span class="text-sm font-semibold">${money(o.amount)}</span>
                ${o.status === 'pending' ? `<button class="btn btn-ghost btn-sm" data-cancel="${o.id}">Cancel</button>` : ''}
              </div>
            </div>`
            )
            .join('')}
        </div>`
            : ''
        }`;

      content.querySelectorAll<HTMLButtonElement>('[data-order]').forEach((b) =>
        b.addEventListener('click', async () => {
          const card = content.querySelector(`[data-prod="${b.dataset.order}"]`)!;
          const opt = (card.querySelector('[data-opt]') as HTMLSelectElement | null)?.value ?? null;
          const qty = Number((card.querySelector('[data-qty]') as HTMLSelectElement).value);
          b.disabled = true;
          const { data, error } = await supabase.rpc('place_shop_order', { p_product: b.dataset.order, p_option: opt, p_qty: qty });
          b.disabled = false;
          if (error) return toast(errMsg(error), 'err');
          toast(data?.invoiced ? 'Ordered! The invoice is on your Money page. 🛍️' : 'Ordered! Pay at the club when you collect. 🛍️');
          render();
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-cancel]').forEach((b) =>
        b.addEventListener('click', async () => {
          if (!confirm('Cancel this order?')) return;
          const { error } = await supabase.rpc('cancel_shop_order', { p_order: b.dataset.cancel });
          if (error) return toast(errMsg(error), 'err');
          toast('Order cancelled.');
          render();
        })
      );
    }

    (async () => {
      ctx = await requireAuth('any', 'shop');
      await render();
    })().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
