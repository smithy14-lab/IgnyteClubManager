---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Contact">
  <section class="max-w-lg mx-auto py-10 animate-rise">
    <p class="eyebrow">Contact</p>
    <h1 class="text-3xl mt-2">Let's get your club <span class="ignite-text">ignyted.</span></h1>
    <p class="mt-3 text-mist-400 text-sm">
      Tell us about your club and we'll come back within a day — usually much faster.
    </p>
    <form id="lead-form" class="surface-card p-6 mt-6 flex flex-col gap-4">
      <div>
        <label class="form-label" for="l-club">Club name</label>
        <input class="field" id="l-club" required />
      </div>
      <div>
        <label class="form-label" for="l-name">Your name</label>
        <input class="field" id="l-name" required />
      </div>
      <div>
        <label class="form-label" for="l-email">Email</label>
        <input class="field" id="l-email" type="email" required />
      </div>
      <div>
        <label class="form-label" for="l-msg">Anything you'd like us to know? (optional)</label>
        <textarea class="field" id="l-msg" rows="3" placeholder="How many coaches, locations, what you use today…"></textarea>
      </div>
      <button class="btn btn-primary" type="submit">Send</button>
    </form>
    <div id="lead-done" class="hidden surface-card p-8 mt-6 text-center">
      <p class="text-3xl">🎉</p>
      <h2 class="text-lg mt-2">Got it — talk soon!</h2>
      <p class="text-sm text-mist-400 mt-1">We'll be in touch shortly to get your club set up.</p>
    </div>
  </section>

  <script>
    import { supabase } from '../lib/supabase';
    import { toast, errMsg } from '../lib/app';

    const form = document.getElementById('lead-form') as HTMLFormElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (btn?.disabled) return;
      if (btn) btn.disabled = true;
      const { error } = await supabase.from('club_leads').insert({
        club_name: (document.getElementById('l-club') as HTMLInputElement).value,
        contact_name: (document.getElementById('l-name') as HTMLInputElement).value,
        email: (document.getElementById('l-email') as HTMLInputElement).value,
        message: (document.getElementById('l-msg') as HTMLTextAreaElement).value || null,
      });
      if (error) {
        if (btn) btn.disabled = false;
        return toast(errMsg(error), 'err');
      }
      form.classList.add('hidden');
      document.getElementById('lead-done')?.classList.remove('hidden');
    });
  </script>
</AppLayout>
