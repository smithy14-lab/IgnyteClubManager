---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Private 1-2-1">
  <p class="eyebrow">Private 1-2-1</p>
  <div class="flex items-center justify-between gap-2 mt-1 mb-5">
    <h1 class="text-2xl">Your 1-2-1 lessons</h1>
    <a href="/book" class="btn btn-primary btn-sm">＋ Book a lesson</a>
  </div>
  <div id="content"><p class="text-mist-500 text-sm">Loading…</p></div>

  <script>
    import { supabase } from '../lib/supabase';
    import { requireAuth, todayISO, myAthletes, fmtDate, fmtTime, esc, toast, errMsg, type ActiveClub } from '../lib/app';

    const content = document.getElementById('content')!;
    let club: ActiveClub | null = null;
    let cancelNoticeHours = 24;

    async function render() {
      const ctx = await requireAuth('any', 'privates');
      club = ctx.club!;
      const athletes = (await myAthletes(club.id)).filter((a) => a.enrolled);
      const ids = athletes.map((a) => a.id);
      const today = todayISO();

      const { data: settings } = await supabase
        .from('club_settings')
        .select('cancellation_notice_hours, cancellation_policy')
        .eq('club_id', club.id)
        .single();
      cancelNoticeHours = settings?.cancellation_notice_hours ?? 24;

      if (!ids.length) {
        content.innerHTML =
          '<div class="surface-card p-8 text-center text-sm text-mist-500">Add an athlete on the <a class="text-ignite-400" href="/athletes">Athletes page</a> to start booking.</div>';
        return;
      }

      const [{ data: offers }, { data: waiting }, { data: bookings }, { data: series }] =
        await Promise.all([
          supabase
            .from('waitlist')
            .select('*, slots(slot_date, start_time, end_time), athletes(name), profiles!waitlist_requested_coach_id_fkey(full_name)')
            .eq('club_id', club.id)
            .in('athlete_id', ids)
            .eq('status', 'offered'),
          supabase
            .from('waitlist')
            .select('*, slots(slot_date, start_time, end_time), athletes(name), profiles!waitlist_requested_coach_id_fkey(full_name)')
            .eq('club_id', club.id)
            .in('athlete_id', ids)
            .eq('status', 'waiting'),
          supabase
            .from('bookings')
            .select('*, slots(slot_date, start_time, end_time), athletes(name), profiles!bookings_coach_id_fkey(full_name)')
            .eq('club_id', club.id)
            .in('athlete_id', ids)
            .eq('status', 'booked')
            .gte('slots.slot_date', today),
          supabase
            .from('booking_series')
            .select('*, athletes(name), profiles!booking_series_coach_id_fkey(full_name)')
            .eq('club_id', club.id)
            .in('athlete_id', ids)
            .eq('active', true),
        ]);

      const upcoming = (bookings ?? [])
        .filter((b) => b.slots)
        .sort((a, b) =>
          (a.slots.slot_date + a.slots.start_time).localeCompare(b.slots.slot_date + b.slots.start_time)
        );

      let html = '';

      if ((offers ?? []).length) {
        html += `<div class="surface-card p-5 mb-5 border-ignite-500/40" style="box-shadow: var(--shadow-glow)">
          <h2 class="text-base font-semibold text-ignite-400">A space has opened up — respond before it expires</h2>
          ${(offers ?? [])
            .map(
              (o) => `
            <div class="mt-4 pt-4 border-t border-ink-700 first:border-0 first:pt-2">
              <p class="text-sm font-medium">${esc(o.athletes?.name)} — ${fmtDate(o.slots.slot_date)} at ${fmtTime(o.slots.start_time)}</p>
              <p class="text-xs text-mist-400 mt-0.5">
                ${o.profiles ? 'Coach ' + esc(o.profiles.full_name) : 'Any available coach'} ·
                expires ${new Date(o.offer_expires_at).toLocaleString(undefined, { weekday: 'short', hour: '2-digit', minute: '2-digit' })}
              </p>
              <div class="mt-2.5 flex gap-2">
                <button class="btn btn-primary btn-sm" data-accept="${o.id}" data-anycoach="${o.requested_coach_id ? '' : '1'}" data-slot="${o.slot_id}" data-date="${o.slots.slot_date}">Accept space</button>
                <button class="btn btn-ghost btn-sm" data-decline="${o.id}">Pass</button>
              </div>
            </div>`
            )
            .join('')}
        </div>`;
      }

      html += `<div class="surface-card p-5 mb-5">
        <h2 class="text-base font-semibold mb-1">Upcoming lessons</h2>
        <p class="text-xs text-mist-500 mb-3">${esc(settings?.cancellation_policy ?? '')}</p>
        ${
          upcoming.length
            ? upcoming
                .map((b) => {
                  const isLate =
                    new Date(b.slots.slot_date + 'T' + b.slots.start_time).getTime() - Date.now() <
                    cancelNoticeHours * 3600_000;
                  return `
            <div class="py-3 border-t border-ink-700 flex flex-wrap items-center justify-between gap-2">
              <div>
                <p class="text-sm font-medium">${fmtDate(b.slots.slot_date)} · ${fmtTime(b.slots.start_time)}–${fmtTime(b.slots.end_time)}</p>
                <p class="text-xs text-mist-400 mt-0.5">${esc(b.athletes?.name)} with ${esc(b.profiles?.full_name)}
                  ${b.discipline_focus ? ` · ${b.discipline_focus === 'both' ? 'tumble + dance' : b.discipline_focus}` : ''}
                  ${b.series_booking_id ? ' · <span class="text-ignite-400">weekly</span>' : ''}
                </p>
              </div>
              <div class="flex gap-1.5">
                <button class="btn btn-ghost btn-sm" title="Add to your calendar"
                  data-ics="${b.slots.slot_date}|${b.slots.start_time}|${b.slots.end_time}|${esc(b.athletes?.name ?? '')}|${esc(b.profiles?.full_name ?? '')}">📅</button>
                <button class="btn btn-danger btn-sm" data-cancel="${b.id}" data-late="${isLate ? '1' : ''}">Cancel</button>
              </div>
            </div>`;
                })
                .join('')
            : '<p class="text-sm text-mist-500 py-2">No upcoming lessons. <a class="text-ignite-400" href="/book">Book one →</a></p>'
        }
      </div>`;

      if ((series ?? []).length) {
        html += `<div class="surface-card p-5 mb-5">
          <h2 class="text-base font-semibold mb-3">Weekly bookings</h2>
          ${(series ?? [])
            .map(
              (s) => `
            <div class="py-3 border-t border-ink-700 first:border-0 flex flex-wrap items-center justify-between gap-2">
              <p class="text-sm">${esc(s.athletes?.name)} with ${esc(s.profiles?.full_name)} — every week until cancelled</p>
              <button class="btn btn-danger btn-sm" data-cancel-series="${s.id}">Cancel weekly booking</button>
            </div>`
            )
            .join('')}
        </div>`;
      }

      if ((waiting ?? []).length) {
        html += `<div class="surface-card p-5">
          <h2 class="text-base font-semibold mb-3">Waiting list</h2>
          ${(waiting ?? [])
            .map(
              (w) => `
            <div class="py-3 border-t border-ink-700 first:border-0 flex flex-wrap items-center justify-between gap-2">
              <div>
                <p class="text-sm font-medium">${fmtDate(w.slots.slot_date)} at ${fmtTime(w.slots.start_time)}</p>
                <p class="text-xs text-mist-400 mt-0.5">${esc(w.athletes?.name)} · ${w.profiles ? 'coach ' + esc(w.profiles.full_name) : 'any coach'}</p>
              </div>
              <button class="btn btn-ghost btn-sm" data-leave="${w.id}">Leave list</button>
            </div>`
            )
            .join('')}
        </div>`;
      }

      content.innerHTML = html;
      wire();
    }

    function wire() {
      // "Add to calendar" — downloads a standard .ics the phone opens natively.
      content.querySelectorAll<HTMLButtonElement>('[data-ics]').forEach((b) =>
        b.addEventListener('click', () => {
          const [date, start, end, athlete, coach] = (b.dataset.ics ?? '').split('|');
          const d = date.replace(/-/g, '');
          const ics = [
            'BEGIN:VCALENDAR',
            'VERSION:2.0',
            `PRODID:-//${club?.name ?? 'Ignyte Club Manager'}//EN`,
            'BEGIN:VEVENT',
            `UID:${d}${start.replace(':', '')}-${athlete.replace(/\W/g, '')}@ignyte`,
            `DTSTART:${d}T${start.replace(':', '')}00`,
            `DTEND:${d}T${end.replace(':', '')}00`,
            `SUMMARY:${athlete} — 1-2-1 with ${coach}`,
            'END:VEVENT',
            'END:VCALENDAR',
          ].join('\r\n');
          const url = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' }));
          const a = document.createElement('a');
          a.href = url;
          a.download = `ignyte-lesson-${date}.ics`;
          a.click();
          URL.revokeObjectURL(url);
        })
      );

      content.querySelectorAll<HTMLButtonElement>('[data-cancel]').forEach((b) =>
        b.addEventListener('click', async () => {
          const warning = b.dataset.late
            ? `This is within the club's ${cancelNoticeHours}-hour notice window, so the lesson is still payable. Cancel anyway? The space will be offered to the waiting list.`
            : 'Cancel this lesson?';
          if (!confirm(warning)) return;
          const { data, error } = await supabase.rpc('cancel_booking', { p_booking_id: b.dataset.cancel });
          if (error) return toast(errMsg(error), 'err');
          toast(
            (data as { late?: boolean })?.late
              ? 'Cancelled — marked as a late cancellation (still payable).'
              : 'Lesson cancelled.'
          );
          render();
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-cancel-series]').forEach((b) =>
        b.addEventListener('click', async () => {
          if (!confirm('Cancel this weekly booking and all its future lessons?')) return;
          const { error } = await supabase.rpc('cancel_booking_series', {
            p_series_booking_id: b.dataset.cancelSeries,
          });
          if (error) return toast(errMsg(error), 'err');
          toast('Weekly booking cancelled.');
          render();
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-leave]').forEach((b) =>
        b.addEventListener('click', async () => {
          const { error } = await supabase.rpc('leave_waitlist', { p_waitlist_id: b.dataset.leave });
          if (error) return toast(errMsg(error), 'err');
          toast('Removed from the waiting list.');
          render();
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-decline]').forEach((b) =>
        b.addEventListener('click', async () => {
          const { error } = await supabase.rpc('leave_waitlist', { p_waitlist_id: b.dataset.decline });
          if (error) return toast(errMsg(error), 'err');
          toast('Passed — the space goes to the next person.');
          render();
        })
      );
      const acceptOffer = async (waitlistId: string, coachId: string | null) => {
        const { error } = await supabase.rpc('accept_waitlist_offer', {
          p_waitlist_id: waitlistId,
          p_coach_id: coachId,
        });
        if (error) return toast(errMsg(error), 'err');
        toast('Space accepted — lesson booked! 🎉');
        render();
      };
      content.querySelectorAll<HTMLButtonElement>('[data-accept]').forEach((b) =>
        b.addEventListener('click', async () => {
          const waitlistId = b.dataset.accept!;
          if (!b.dataset.anycoach) return acceptOffer(waitlistId, null);
          // "Any coach" entry — find a free coach in the slot to book with.
          const day = b.dataset.date || todayISO();
          const { data: board } = await supabase.rpc('get_slot_board', { p_club: club!.id, p_from: day, p_to: day });
          const slot = ((board ?? []) as { id: string; coaches: { id: string; name: string; busy: boolean }[] }[]).find(
            (s) => s.id === b.dataset.slot
          );
          const free = slot?.coaches.filter((c) => !c.busy) ?? [];
          if (!free.length) return toast('No coach is free in that slot any more.', 'err');
          if (free.length === 1) return acceptOffer(waitlistId, free[0].id);
          const row = b.parentElement!;
          row.innerHTML =
            '<span class="text-xs text-mist-400 self-center">Who with?</span>' +
            free.map((c) => `<button class="btn btn-primary btn-sm" data-pick="${c.id}">${esc(c.name)}</button>`).join('') +
            '<button class="btn btn-ghost btn-sm" data-pickback>Back</button>';
          row.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((p) =>
            p.addEventListener('click', () => acceptOffer(waitlistId, p.dataset.pick!))
          );
          row.querySelector('[data-pickback]')?.addEventListener('click', () => render());
        })
      );
    }

    render().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
