---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Waiver">
  <p class="eyebrow">Club agreement</p>
  <h1 class="text-2xl mt-1 mb-5">Terms &amp; consent</h1>
  <div id="content" class="max-w-2xl"><p class="text-mist-500 text-sm">Loading…</p></div>

  <script>
    import { supabase } from '../lib/supabase';
    import { requireAuth, esc, toast, errMsg, fmtDate, type AuthCtx } from '../lib/app';

    const content = document.getElementById('content')!;
    let ctx: AuthCtx;

    async function render() {
      const club = ctx.club!;
      const { data, error } = await supabase.rpc('waiver_status', { p_club: club.id });
      if (error) return toast(errMsg(error), 'err');
      if (!data?.required) {
        content.innerHTML = `<div class="surface-card p-5"><p class="text-sm text-mist-300">${esc(club.name)} hasn't published a club agreement — nothing to sign. ✅</p></div>`;
        return;
      }
      content.innerHTML = `
        <div class="surface-card p-6">
          <div class="flex items-center justify-between gap-2 mb-3">
            <h2 class="text-base font-semibold">${esc(club.name)} — club agreement</h2>
            ${data.signed ? '<span class="pill pill-success">✓ signed</span>' : '<span class="pill pill-warn">needs signing</span>'}
          </div>
          <p class="text-xs text-mist-500 mb-3">Updated ${fmtDate(data.updated_at)}</p>
          <p class="text-sm text-mist-300 whitespace-pre-line leading-relaxed">${esc(data.text ?? '')}</p>
          ${
            data.signed
              ? ''
              : `<div class="mt-5 pt-4 border-t border-ink-700">
                  <label class="form-label" for="sig">Type your full name to sign</label>
                  <div class="flex gap-2">
                    <input class="field flex-1" id="sig" placeholder="Your full name" autocomplete="name" />
                    <button class="btn btn-primary" id="sign-go">Sign</button>
                  </div>
                  <p class="text-xs text-mist-500 mt-2">Signing records your name, account and the time, against this version of the agreement.</p>
                </div>`
          }
        </div>`;
      document.getElementById('sign-go')?.addEventListener('click', async () => {
        const name = (document.getElementById('sig') as HTMLInputElement).value.trim();
        const { error: e } = await supabase.rpc('sign_waiver', { p_club: club.id, p_name: name });
        if (e) return toast(errMsg(e), 'err');
        toast('Signed — thank you! ✅');
        render();
      });
    }

    (async () => {
      ctx = await requireAuth('any');
      await render();
    })().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
