---
import AppLayout from '../layouts/AppLayout.astro';
import IgnyteMark from '../components/IgnyteMark.astro';
---

<AppLayout title="Start your club">
  <div class="max-w-md mx-auto">
    <div class="text-center mb-6">
      <IgnyteMark size={48} />
      <h1 class="text-2xl mt-3">Start your club</h1>
      <p class="text-sm text-mist-400 mt-1">Free to set up — website, classes and bookings in minutes.</p>
    </div>

    <form id="wizard" class="surface-card p-6 flex flex-col gap-4">
      <div id="account-fields" class="hidden flex flex-col gap-4">
        <p class="text-xs font-semibold uppercase tracking-widest text-mist-500">Your account</p>
        <div>
          <label class="form-label" for="w-yourname">Your name</label>
          <input class="field" id="w-yourname" maxlength="60" autocomplete="name" placeholder="Alex Smith" />
        </div>
        <div>
          <label class="form-label" for="w-email">Email</label>
          <input class="field" id="w-email" type="email" autocomplete="email" placeholder="you@yourclub.co.uk" />
        </div>
        <div>
          <label class="form-label" for="w-pw">Password</label>
          <input class="field" id="w-pw" type="password" minlength="8" autocomplete="new-password" />
        </div>
        <p class="text-xs font-semibold uppercase tracking-widest text-mist-500 pt-2 border-t border-ink-700">Your club</p>
      </div>
      <div>
        <label class="form-label" for="w-name">Club name</label>
        <input class="field" id="w-name" required maxlength="60" placeholder="e.g. Storm Allstars" />
      </div>
      <div>
        <label class="form-label" for="w-slug">Your club link</label>
        <div class="flex items-center gap-1 text-sm text-mist-500">
          <span>/c/</span>
          <input class="field flex-1" id="w-slug" required pattern="[a-z0-9][a-z0-9-]{1,28}[a-z0-9]" placeholder="storm-allstars" />
        </div>
        <p class="text-xs text-mist-500 mt-1">Lowercase letters, numbers and dashes. This becomes your website &amp; sign-up link.</p>
      </div>
      <div>
        <label class="form-label">What do you coach?</label>
        <label class="text-sm block"><input type="checkbox" id="w-tumble" checked /> Cheer tumble</label>
        <label class="text-sm block"><input type="checkbox" id="w-dance" checked /> All-star dance</label>
      </div>
      <div>
        <label class="form-label" for="w-loc">Your first venue</label>
        <input class="field" id="w-loc" placeholder="Main Gym" />
      </div>
      <div>
        <label class="form-label" for="w-tz">Timezone</label>
        <select class="field" id="w-tz">
          <option value="Europe/London" selected>UK (Europe/London)</option>
          <option value="Europe/Dublin">Ireland</option>
          <option value="America/New_York">US Eastern</option>
          <option value="America/Chicago">US Central</option>
          <option value="America/Los_Angeles">US Pacific</option>
          <option value="Australia/Sydney">Australia (Sydney)</option>
        </select>
      </div>
      <div>
        <label class="form-label" for="w-promo">Discount code (optional)</label>
        <input class="field uppercase" id="w-promo" maxlength="20" placeholder="e.g. CHEER50" />
        <p class="text-xs mt-1 hidden" id="w-promo-msg"></p>
      </div>
      <button class="btn btn-primary" type="submit" id="w-go">Create my club</button>
      <p class="text-xs text-mist-500 text-center hidden" id="w-signin-hint">
        Already have an Ignyte account? <a href="/login" class="text-ignite-400">Sign in first</a> and come back.
      </p>
    </form>

    <div id="confirm-note" class="hidden surface-card p-6 text-center">
      <p class="text-3xl">📧</p>
      <h2 class="text-lg mt-2">Confirm your email</h2>
      <p class="text-sm text-mist-400 mt-2">
        We've saved your club details. Click the link in your email, sign in, and your club
        will finish setting itself up automatically.
      </p>
    </div>

    <div id="done" class="hidden surface-card p-6 text-center" style="box-shadow: var(--shadow-glow)">
      <p class="text-3xl">🎉</p>
      <h2 class="text-lg mt-2">Your club is live!</h2>
      <div class="text-left mt-4 text-sm flex flex-col gap-2">
        <p>🌐 Your website &amp; sign-up link: <code id="d-link" class="text-ignite-400"></code></p>
        <p>🔑 Fallback join code: <code id="d-code" class="text-ignite-400 text-lg"></code></p>
        <p class="text-xs text-mist-500">Families who sign up at your link join automatically. Invite coaches from Admin → Import.</p>
      </div>
      <a href="/admin" class="btn btn-primary mt-5">Open your admin</a>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase';
    import { setActiveClub, toast, errMsg } from '../lib/app';

    const nameEl = document.getElementById('w-name') as HTMLInputElement;
    const slugEl = document.getElementById('w-slug') as HTMLInputElement;
    const promoEl = document.getElementById('w-promo') as HTMLInputElement;
    const promoMsg = document.getElementById('w-promo-msg')!;
    let signedIn = false;

    nameEl.addEventListener('input', () => {
      if (!slugEl.dataset.touched) {
        slugEl.value = nameEl.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 30);
      }
    });
    slugEl.addEventListener('input', () => (slugEl.dataset.touched = '1'));

    promoEl.addEventListener('change', async () => {
      const code = promoEl.value.trim();
      promoMsg.classList.add('hidden');
      if (!code) return;
      const { data } = await supabase.rpc('check_promo', { p_code: code });
      promoMsg.classList.remove('hidden');
      if (data?.valid) {
        promoMsg.className = 'text-xs mt-1 text-ignite-400';
        promoMsg.textContent = `✓ ${data.percent_off}% off for ${data.duration_months} months${data.description ? ' — ' + data.description : ''}`;
      } else {
        promoMsg.className = 'text-xs mt-1 text-charge-400';
        promoMsg.textContent = "That code isn't valid.";
      }
    });

    type Pending = { name: string; slug: string; disciplines: string[]; location: string; timezone: string; promo: string | null };

    async function provision(p: Pending) {
      const { data, error } = await supabase.rpc('provision_club', {
        p_name: p.name, p_slug: p.slug, p_timezone: p.timezone,
        p_disciplines: p.disciplines, p_location: p.location || 'Main venue',
        p_promo: p.promo,
      });
      if (error) {
        const msg = errMsg(error);
        throw new Error(msg.includes('duplicate') || msg.includes('unique') ? 'That link is taken — try another.' : msg);
      }
      localStorage.removeItem('icm-pending-club');
      const res = data as { club_id: string; slug: string; join_code: string };
      await setActiveClub(res.club_id);
      document.getElementById('wizard')!.classList.add('hidden');
      document.getElementById('confirm-note')!.classList.add('hidden');
      document.getElementById('d-link')!.textContent = `${location.origin}/c/${res.slug}`;
      document.getElementById('d-code')!.textContent = res.join_code;
      document.getElementById('done')!.classList.remove('hidden');
    }

    function readForm(): Pending {
      const disciplines = [
        (document.getElementById('w-tumble') as HTMLInputElement).checked && 'tumble',
        (document.getElementById('w-dance') as HTMLInputElement).checked && 'dance',
      ].filter(Boolean) as string[];
      return {
        name: nameEl.value.trim(),
        slug: slugEl.value.trim(),
        disciplines,
        location: (document.getElementById('w-loc') as HTMLInputElement).value.trim(),
        timezone: (document.getElementById('w-tz') as HTMLSelectElement).value,
        promo: promoEl.value.trim() || null,
      };
    }

    (document.getElementById('wizard') as HTMLFormElement).addEventListener('submit', async (e) => {
      e.preventDefault();
      const p = readForm();
      if (!p.disciplines.length) return toast('Pick at least one discipline.', 'err');
      try {
        if (signedIn) return await provision(p);

        // founder signup: account + club in one go
        const yourName = (document.getElementById('w-yourname') as HTMLInputElement).value.trim();
        const email = (document.getElementById('w-email') as HTMLInputElement).value.trim();
        const pw = (document.getElementById('w-pw') as HTMLInputElement).value;
        if (!yourName || !email || pw.length < 8) return toast('Fill in your name, email and a password (8+ characters).', 'err');
        const { data, error } = await supabase.auth.signUp({
          email, password: pw, options: { data: { full_name: yourName } },
        });
        if (error) throw error;
        if (data.session) {
          await provision(p);
          toast('Welcome to Ignyte! 🎉');
        } else {
          localStorage.setItem('icm-pending-club', JSON.stringify(p));
          document.getElementById('wizard')!.classList.add('hidden');
          document.getElementById('confirm-note')!.classList.remove('hidden');
        }
      } catch (err) {
        toast(errMsg(err), 'err');
      }
    });

    (async () => {
      const { data } = await supabase.auth.getSession();
      signedIn = Boolean(data.session);
      if (!signedIn) {
        document.getElementById('account-fields')!.classList.remove('hidden');
        document.getElementById('w-signin-hint')!.classList.remove('hidden');
        return;
      }
      // returning after email confirmation with a stashed club? finish the job.
      const stash = localStorage.getItem('icm-pending-club');
      if (stash) {
        try {
          await provision(JSON.parse(stash));
          toast('Your club is live! 🎉');
        } catch (err) {
          toast(errMsg(err), 'err');
        }
      }
    })();
  </script>
</AppLayout>
