---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Classes">
  <p class="eyebrow">Group classes</p>
  <h1 class="text-2xl mt-1 mb-1">Weekly classes</h1>
  <p class="text-sm text-mist-400 mb-5">
    Enrol for a regular spot, or book a trial to try a class first. Full class? Join the
    waiting list and we'll move you up automatically the moment a space opens.
  </p>
  <div id="list" class="grid gap-4 sm:grid-cols-2"><p class="text-mist-500 text-sm">Loading…</p></div>

  <script>
    import { supabase } from '../lib/supabase';
    import { requireAuth, todayISO, myAthletes, esc, toast, errMsg, ageFromDob, type AuthCtx } from '../lib/app';

    const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const list = document.getElementById('list')!;
    let ctx: AuthCtx;
    let symbol = '£';

    type Cls = {
      id: string; name: string; discipline: string; description: string | null;
      day_of_week: number; start_time: string; end_time: string; capacity: number;
      age_min: number | null; age_max: number | null; price_per_session: number | null;
      monthly_fee: number | null; trial_allowed: boolean; trial_price: number | null;
      location: string | null; coach: string | null; enrolled: number; waiting: number;
      next_date: string | null; active: boolean;
    };

    const hm = (t: string) => t.slice(0, 5);
    const dstr = (d: string) =>
      new Date(d + 'T00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });

    async function render() {
      const club = ctx.club!;
      const [{ data: classesRaw, error }, athletes, { data: settings }] = await Promise.all([
        supabase.rpc('get_classes', { p_club: club.id }),
        myAthletes(club.id),
        supabase.from('club_settings').select('currency').eq('club_id', club.id).single(),
      ]);
      if (error) return toast(errMsg(error), 'err');
      symbol = settings?.currency ?? '£';
      const classes = (classesRaw ?? []) as Cls[];
      const mine = athletes.filter((a) => a.enrolled);
      const mineIds = mine.map((a) => a.id);

      const [{ data: enr }, { data: trials }] = await Promise.all([
        mineIds.length
          ? supabase.from('class_enrolments').select('class_id, athlete_id, status').in('athlete_id', mineIds).eq('club_id', club.id)
          : Promise.resolve({ data: [] } as never),
        mineIds.length
          ? supabase
              .from('class_trials')
              .select('id, class_id, athlete_id, status, class_sessions(session_date)')
              .in('athlete_id', mineIds)
              .eq('club_id', club.id)
              .eq('status', 'booked')
          : Promise.resolve({ data: [] } as never),
      ]);

      if (!classes.length) {
        list.innerHTML = `<p class="text-sm text-mist-500 sm:col-span-2">No classes yet — ${esc(club.name)} runs 1-2-1 lessons only for now. Check the Book page!</p>`;
        return;
      }

      list.innerHTML = classes
        .map((c) => {
          const spots = Math.max(0, c.capacity - Number(c.enrolled));
          const price = [
            c.monthly_fee != null ? `${symbol}${c.monthly_fee}/month` : '',
            c.price_per_session != null ? `${symbol}${c.price_per_session}/session` : '',
          ].filter(Boolean).join(' · ');
          const states = mine
            .map((a) => {
              const e = (enr ?? []).find((x) => x.class_id === c.id && x.athlete_id === a.id && x.status !== 'left');
              const t = (trials ?? []).find((x) => x.class_id === c.id && x.athlete_id === a.id);
              if (e?.status === 'enrolled')
                return `<span class="pill pill-success">${esc(a.name.split(' ')[0])} ✓ enrolled</span><button class="btn btn-ghost btn-sm" data-leave="${c.id}:${a.id}">Leave</button>`;
              if (e?.status === 'waiting')
                return `<span class="pill pill-warn">${esc(a.name.split(' ')[0])} ⏳ waiting list</span><button class="btn btn-ghost btn-sm" data-leave="${c.id}:${a.id}">Remove</button>`;
              if (t) {
                const sd = (t as unknown as { class_sessions: { session_date: string } }).class_sessions?.session_date;
                return `<span class="pill pill-accent">${esc(a.name.split(' ')[0])} ⭐ trial ${sd ? dstr(sd) : ''}</span><button class="btn btn-ghost btn-sm" data-canceltrial="${t.id}">Cancel</button>`;
              }
              return '';
            })
            .filter(Boolean)
            .join(' ');

          return `
        <div class="surface-card p-5 flex flex-col" data-card="${c.id}">
          <div class="flex items-start justify-between gap-2">
            <div>
              <h2 class="font-semibold">${esc(c.name)}</h2>
              <p class="text-xs text-mist-400 mt-0.5">${DAYS[c.day_of_week]}s ${hm(c.start_time)}–${hm(c.end_time)}${c.location ? ' · ' + esc(c.location) : ''}</p>
            </div>
            <span class="pill">${esc(c.discipline)}</span>
          </div>
          <p class="text-xs text-mist-400 mt-2">
            ${c.coach ? '👤 ' + esc(c.coach) + ' · ' : ''}${c.age_min != null || c.age_max != null ? `ages ${c.age_min ?? 0}–${c.age_max ?? '99+'}` : 'all ages'}
            ${price ? ' · ' + price : ''}
          </p>
          ${c.description ? `<p class="text-xs text-mist-500 mt-1">${esc(c.description)}</p>` : ''}
          <div class="mt-2 flex flex-wrap gap-1.5 items-center text-xs">
            ${spots > 0 ? `<span class="pill pill-success">${spots} space${spots === 1 ? '' : 's'} left</span>` : '<span class="pill pill-warn">Full — waiting list open</span>'}
            ${Number(c.waiting) ? `<span class="pill">${c.waiting} waiting</span>` : ''}
            ${c.next_date ? `<span class="text-mist-500">Next: ${dstr(c.next_date)}</span>` : ''}
          </div>
          ${states ? `<div class="mt-3 flex flex-wrap gap-1.5 items-center">${states}</div>` : ''}
          <div class="mt-3 pt-3 border-t border-ink-700 flex flex-wrap gap-2 items-center">
            <select class="field !w-auto !py-1.5 !text-xs" data-ath="${c.id}">
              ${mine.map((a) => `<option value="${a.id}">${esc(a.name)} (${ageFromDob(a.dob)})</option>`).join('')}
            </select>
            <button class="btn btn-primary btn-sm" data-enrol="${c.id}">${spots > 0 ? 'Enrol' : 'Join waiting list'}</button>
            ${c.trial_allowed ? `<button class="btn btn-ghost btn-sm" data-trial="${c.id}">Book a trial${Number(c.trial_price) > 0 ? ` (${symbol}${c.trial_price})` : ' — free'}</button>` : ''}
          </div>
          <div class="trial-panel hidden mt-2" data-trialpanel="${c.id}"></div>
        </div>`;
        })
        .join('');

      if (!mine.length) {
        list.innerHTML =
          `<div class="surface-card p-5 sm:col-span-2"><p class="text-sm text-mist-300">Add an athlete first, then enrol them in classes.</p>
           <a href="/athletes" class="btn btn-primary btn-sm mt-3">Add an athlete</a></div>` + list.innerHTML;
        list.querySelectorAll<HTMLElement>('[data-enrol],[data-trial],[data-ath]').forEach((el) => ((el as HTMLButtonElement).disabled = true));
      }

      const athFor = (cid: string) => (list.querySelector(`[data-ath="${cid}"]`) as HTMLSelectElement)?.value;

      list.querySelectorAll<HTMLButtonElement>('[data-enrol]').forEach((b) =>
        b.addEventListener('click', async () => {
          const { data, error: e } = await supabase.rpc('enrol_class', { p_class: b.dataset.enrol, p_athlete: athFor(b.dataset.enrol!) });
          if (e) return toast(errMsg(e), 'err');
          toast(data?.status === 'enrolled' ? 'Enrolled! 🎉' : 'Class is full — added to the waiting list.');
          render();
        })
      );
      list.querySelectorAll<HTMLButtonElement>('[data-leave]').forEach((b) =>
        b.addEventListener('click', async () => {
          const [cid, aid] = b.dataset.leave!.split(':');
          if (!confirm('Leave this class? The space is offered to the waiting list.')) return;
          const { error: e } = await supabase.rpc('leave_class', { p_class: cid, p_athlete: aid });
          if (e) return toast(errMsg(e), 'err');
          toast('Done.');
          render();
        })
      );
      list.querySelectorAll<HTMLButtonElement>('[data-canceltrial]').forEach((b) =>
        b.addEventListener('click', async () => {
          const { error: e } = await supabase.rpc('cancel_class_trial', { p_trial: b.dataset.canceltrial });
          if (e) return toast(errMsg(e), 'err');
          toast('Trial cancelled.');
          render();
        })
      );
      list.querySelectorAll<HTMLButtonElement>('[data-trial]').forEach((b) =>
        b.addEventListener('click', async () => {
          const cid = b.dataset.trial!;
          const panel = list.querySelector(`[data-trialpanel="${cid}"]`)!;
          if (!panel.classList.contains('hidden')) return panel.classList.add('hidden');
          const { data: sess } = await supabase
            .from('class_sessions')
            .select('id, session_date')
            .eq('class_id', cid)
            .gte('session_date', todayISO())
            .eq('cancelled', false)
            .order('session_date')
            .limit(4);
          panel.innerHTML = (sess ?? []).length
            ? `<p class="text-xs text-mist-400 mb-1.5">Pick a week for the trial:</p><div class="flex flex-wrap gap-1.5">` +
              (sess ?? []).map((s) => `<button class="btn btn-ghost btn-sm" data-trialgo="${cid}:${s.id}">${dstr(s.session_date)}</button>`).join('') +
              `</div>`
            : '<p class="text-xs text-mist-500">No upcoming sessions.</p>';
          panel.classList.remove('hidden');
          panel.querySelectorAll<HTMLButtonElement>('[data-trialgo]').forEach((g) =>
            g.addEventListener('click', async () => {
              const [c, s] = g.dataset.trialgo!.split(':');
              const { error: e } = await supabase.rpc('book_class_trial', { p_class: c, p_athlete: athFor(c), p_session: s });
              if (e) return toast(errMsg(e), 'err');
              toast('Trial booked! ⭐');
              render();
            })
          );
        })
      );
    }

    (async () => {
      ctx = await requireAuth(['parent', 'athlete', 'admin']);
      await render();
    })().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
