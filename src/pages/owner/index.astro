---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Owner HQ">
  <p class="eyebrow">Owner HQ</p>
  <h1 class="text-2xl mt-1 mb-5">Run the platform</h1>
  <div id="content"><p class="text-mist-500 text-sm">Loading…</p></div>

  <script>
    import { supabase } from '../../lib/supabase';
    import { requireOwner, esc, toast, errMsg } from '../../lib/app';

    const content = document.getElementById('content')!;
    const statusPill: Record<string, string> = {
      active: 'pill pill-success', suspended: 'pill pill-warn', churned: 'pill pill-danger',
      new: 'pill pill-accent', contacted: 'pill pill-warn', converted: 'pill pill-success', closed: 'pill',
    };

    type Club = {
      id: string; name: string; slug: string; status: string; plan: string; join_code: string;
      contact_email: string | null; created_at: string; families: number; coaches: number;
      pending: number; bookings_per_week: number; last_booking_at: string | null;
    };
    let extraByClub: Record<string, { addons: string[]; custom_domain: string | null; custom_domain_status: string | null; mailbox_alias: string | null; starter_status: string | null }> = {};

    async function render() {
      const [{ data: health }, { data: leads }, { data: audit }, { data: addonRows }] = await Promise.all([
        supabase.rpc('owner_club_health'),
        supabase.from('club_leads').select('*').order('created_at', { ascending: false }).limit(30),
        supabase.from('owner_audit').select('*').order('created_at', { ascending: false }).limit(15),
        supabase.from('clubs').select('id, addons, custom_domain, custom_domain_status, mailbox_alias, starter_status'),
      ]);
      extraByClub = Object.fromEntries(
        (addonRows ?? []).map((r) => [r.id, { addons: r.addons ?? [], custom_domain: r.custom_domain, custom_domain_status: r.custom_domain_status, mailbox_alias: r.mailbox_alias, starter_status: r.starter_status }])
      );
      const clubs = (health ?? []) as Club[];
      const liveClubs = clubs.filter((c) => c.status === 'active');

      content.innerHTML = `
        <div class="grid gap-4 grid-cols-2 sm:grid-cols-4 mb-6">
          ${[
            ['Active clubs', liveClubs.length],
            ['Families', liveClubs.reduce((s, c) => s + Number(c.families), 0)],
            ['Lessons/week', liveClubs.reduce((s, c) => s + Number(c.bookings_per_week), 0).toFixed(0)],
            ['Open leads', (leads ?? []).filter((l) => ['new', 'contacted'].includes(l.status)).length],
          ]
            .map(
              ([label, n]) => `
            <div class="surface-card p-5 text-center">
              <p class="text-3xl font-display font-semibold ignite-text">${n}</p>
              <p class="text-xs text-mist-400 mt-1">${label}</p>
            </div>`
            )
            .join('')}
        </div>

        <div class="surface-card p-5 mb-5">
          <h2 class="text-base font-semibold mb-3">🏟️ Clubs</h2>
          <div style="overflow-x:auto">
          ${clubs
            .map((c) => {
              const quiet = c.last_booking_at && Date.now() - new Date(c.last_booking_at).getTime() > 21 * 864e5;
              return `
            <div class="py-3 border-t border-ink-700 first:border-0">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <p class="text-sm font-semibold">${esc(c.name)} <span class="text-xs text-mist-500">/c/${esc(c.slug)}</span></p>
                  <p class="text-xs text-mist-400 mt-0.5">
                    ${c.families} families · ${c.coaches} coaches · ${c.bookings_per_week}/wk
                    ${c.pending ? ` · <span class="text-charge-400">${c.pending} pending</span>` : ''}
                    ${quiet ? ' · <span class="text-charge-400">quiet 3+ weeks</span>' : ''}
                  </p>
                </div>
                <div class="flex gap-1.5 items-center flex-wrap">
                  <span class="${statusPill[c.status] ?? 'pill'}">${c.status}</span>
                  <select class="field !w-auto !py-1 !text-xs" data-plan="${c.id}">
                    ${['free', 'small', 'club', 'comped'].map((pl) => `<option value="${pl}" ${pl === c.plan ? 'selected' : ''}>${pl}</option>`).join('')}
                  </select>
                  <select class="field !w-auto !py-1 !text-xs" data-status="${c.id}">
                    ${['active', 'suspended', 'churned'].map((st) => `<option value="${st}" ${st === c.status ? 'selected' : ''}>${st}</option>`).join('')}
                  </select>
                  <button class="btn btn-ghost btn-sm ${(extraByClub[c.id]?.addons ?? []).includes('privates') ? '!text-ignite-400' : ''}"
                    data-addon="privates:${c.id}" title="Toggle the Privates add-on (£10/mo)">⚡</button>
                  <button class="btn btn-ghost btn-sm ${(extraByClub[c.id]?.addons ?? []).includes('websitepro') ? '!text-ignite-400' : ''}"
                    data-addon="websitepro:${c.id}" title="Toggle the Website Pro add-on (£10/mo)">🌐</button>
                  <button class="btn btn-ghost btn-sm" data-viewas="${c.id}" data-name="${esc(c.name)}">View as admin</button>
                </div>
              </div>
              ${
                extraByClub[c.id]?.starter_status
                  ? `<p class="text-xs mt-1.5 ${extraByClub[c.id].starter_status === 'done' ? 'text-mist-400' : 'text-charge-400'}">
                      🚀 starter: ${extraByClub[c.id].starter_status!.replace('_', ' ')}
                      ${extraByClub[c.id].starter_status !== 'done' ? `<button class="btn btn-ghost btn-sm ml-1" data-starter="${c.id}:${extraByClub[c.id].starter_status === 'requested' ? 'in_progress' : 'done'}">${extraByClub[c.id].starter_status === 'requested' ? 'Start work' : 'Mark done'}</button>` : ''}
                    </p>`
                  : ''
              }
              ${
                extraByClub[c.id]?.custom_domain
                  ? `<p class="text-xs mt-1.5 ${extraByClub[c.id].custom_domain_status === 'live' ? 'text-mist-400' : 'text-charge-400'}">
                      🌐 ${esc(extraByClub[c.id].custom_domain!)}${extraByClub[c.id].mailbox_alias ? ' · 📧 ' + esc(extraByClub[c.id].mailbox_alias!) + '@' + esc(extraByClub[c.id].custom_domain!) : ''}
                      · ${extraByClub[c.id].custom_domain_status}
                      ${extraByClub[c.id].custom_domain_status === 'requested' ? `<button class="btn btn-ghost btn-sm ml-1" data-domainlive="${c.id}">Mark live</button>` : ''}
                    </p>`
                  : ''
              }
            </div>`;
            })
            .join('')}
          </div>
          <p class="text-xs text-mist-500 mt-3">"View as admin" is read-only until you grant yourself a 60-minute support window (logged in the audit trail). New clubs self-serve at /start.</p>
        </div>

        <div class="grid gap-5 lg:grid-cols-2">
          <div class="surface-card p-5">
            <h2 class="text-base font-semibold mb-3">📥 Leads</h2>
            ${
              (leads ?? []).length
                ? (leads ?? [])
                    .map(
                      (l) => `
                <div class="py-3 border-t border-ink-700 first:border-0">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <p class="text-sm font-semibold">${esc(l.club_name)}</p>
                    <span class="${statusPill[l.status] ?? 'pill'}">${l.status}</span>
                  </div>
                  <p class="text-xs text-mist-400 mt-0.5">${esc(l.contact_name)} · ${esc(l.email)}</p>
                  ${l.message ? `<p class="text-xs text-mist-500 mt-1">${esc(l.message)}</p>` : ''}
                  ${
                    ['new', 'contacted'].includes(l.status)
                      ? `<div class="mt-2 flex gap-1.5 flex-wrap">
                          <button class="btn btn-ghost btn-sm" data-lead="contacted" data-id="${l.id}">Contacted</button>
                          <button class="btn btn-ghost btn-sm" data-lead="converted" data-id="${l.id}">Converted</button>
                          <button class="btn btn-danger btn-sm" data-lead="closed" data-id="${l.id}">Close</button>
                        </div>`
                      : ''
                  }
                </div>`
                    )
                    .join('')
                : '<p class="text-sm text-mist-500">No leads yet — they arrive from the Contact page. Clubs can also self-serve at /start.</p>'
            }
          </div>

          <div>
            <div class="surface-card p-5 mb-5">
              <h2 class="text-base font-semibold mb-2">📣 Announce to all club admins</h2>
              <input class="field mb-2" id="an-title" placeholder="Title" />
              <textarea class="field mb-2" id="an-body" rows="2" placeholder="Message to every club's admins…"></textarea>
              <button class="btn btn-primary btn-sm" id="an-send">Send announcement</button>
            </div>
            <div class="surface-card p-5">
              <h2 class="text-base font-semibold mb-2">🧾 Audit trail</h2>
              ${(audit ?? [])
                .map(
                  (a) => `<p class="text-xs text-mist-400 py-1 border-t border-ink-700 first:border-0">
                    ${new Date(a.created_at).toLocaleString()} · <b>${esc(a.action)}</b>${a.detail ? ' · ' + esc(a.detail) : ''}</p>`
                )
                .join('') || '<p class="text-sm text-mist-500">Nothing yet.</p>'}
            </div>
          </div>
        </div>`;

      content.querySelectorAll<HTMLSelectElement>('[data-plan]').forEach((sel) =>
        sel.addEventListener('change', async () => {
          const { error } = await supabase.rpc('owner_set_plan', { p_club: sel.dataset.plan, p_plan: sel.value });
          if (error) return toast(errMsg(error), 'err');
          toast('Plan updated.');
        })
      );
      content.querySelectorAll<HTMLSelectElement>('[data-status]').forEach((sel) =>
        sel.addEventListener('change', async () => {
          if (sel.value !== 'active' && !confirm(`Set this club to ${sel.value}? Members will be locked out until it's active again.`)) {
            render();
            return;
          }
          const { error } = await supabase.rpc('owner_set_club_status', { p_club: sel.dataset.status, p_status: sel.value });
          if (error) return toast(errMsg(error), 'err');
          toast('Status updated.');
          render();
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-addon]').forEach((b) =>
        b.addEventListener('click', async () => {
          const [addon, id] = b.dataset.addon!.split(':');
          const current = extraByClub[id]?.addons ?? [];
          const next = current.includes(addon) ? current.filter((a) => a !== addon) : [...current, addon];
          const { error } = await supabase.rpc('owner_set_addons', { p_club: id, p_addons: next });
          if (error) return toast(errMsg(error), 'err');
          toast(`${addon} add-on ${next.includes(addon) ? 'ON' : 'off'}.`);
          render();
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-starter]').forEach((b) =>
        b.addEventListener('click', async () => {
          const [id, status] = b.dataset.starter!.split(':');
          const { error } = await supabase.rpc('owner_set_starter_status', { p_club: id, p_status: status });
          if (error) return toast(errMsg(error), 'err');
          toast(status === 'done' ? 'Starter Package complete — club notified. 🚀' : 'Marked in progress.');
          render();
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-domainlive]').forEach((b) =>
        b.addEventListener('click', async () => {
          if (!confirm('Mark this domain live? Only do this after the Cloudflare custom hostname + email routing are set up.')) return;
          const { error } = await supabase.rpc('owner_set_domain_status', { p_club: b.dataset.domainlive, p_status: 'live' });
          if (error) return toast(errMsg(error), 'err');
          toast('Domain live. 🌐');
          render();
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-viewas]').forEach((b) =>
        b.addEventListener('click', async () => {
          if (confirm(`Open ${b.dataset.name} as admin?\n\nOK = grant yourself a 60-minute SUPPORT window (you can make changes; everything is logged).\nCancel = read-only view.`)) {
            const { error } = await supabase.rpc('owner_grant_support', { p_club: b.dataset.viewas, p_minutes: 60 });
            if (error) return toast(errMsg(error), 'err');
          }
          localStorage.setItem('icm-active-club', b.dataset.viewas!);
          location.href = `/admin?club=${b.dataset.viewas}`;
        })
      );
      content.querySelectorAll<HTMLButtonElement>('[data-lead]').forEach((b) =>
        b.addEventListener('click', async () => {
          const { error } = await supabase.from('club_leads').update({ status: b.dataset.lead }).eq('id', b.dataset.id);
          if (error) return toast(errMsg(error), 'err');
          render();
        })
      );
      document.getElementById('an-send')?.addEventListener('click', async () => {
        const title = (document.getElementById('an-title') as HTMLInputElement).value.trim();
        const body = (document.getElementById('an-body') as HTMLTextAreaElement).value.trim();
        if (!title || !body) return toast('Title and message required.', 'err');
        const { data, error } = await supabase.rpc('owner_announce', { p_title: title, p_body: body });
        if (error) return toast(errMsg(error), 'err');
        toast(`Sent to ${data} club admin(s).`);
        render();
      });
    }

    (async () => {
      await requireOwner();
      await render();
    })().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
