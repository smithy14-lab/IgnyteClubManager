---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Home">
  <div id="content" class="max-w-lg mx-auto"><p class="text-sm text-mist-500">Loading…</p></div>

  <script>
    import { supabase } from '../lib/supabase';
    import { requireAuth, portalsFor, setActiveClub, esc, toast, errMsg } from '../lib/app';

    const content = document.getElementById('content')!;

    (async () => {
      const ctx = await requireAuth();
      // a club code entered at sign-up is applied on first arrival
      const pending = localStorage.getItem('ignyte-pending-code');
      if (pending) {
        localStorage.removeItem('ignyte-pending-code');
        const { data, error } = await supabase.rpc('join_club', { p_code: pending });
        if (error) toast(errMsg(error), 'err');
        else {
          setActiveClub(data as string);
          location.reload();
          return;
        }
      }
      const portals = portalsFor(ctx.club, ctx.profile.is_platform_owner);
      const forced = new URLSearchParams(location.search).get('stay');
      if (portals.length === 1 && !forced) {
        location.replace(portals[0].href + (ctx.club ? `?club=${ctx.club.id}` : ''));
        return;
      }
      if (!portals.length) {
        content.innerHTML = `
          <h1 class="text-2xl">Hi ${esc(ctx.profile.full_name.split(' ')[0])} 👋</h1>
          <p class="text-sm text-mist-400 mt-1">You're not in a club yet.</p>
          <form id="join" class="surface-card p-5 mt-5 flex flex-col gap-3">
            <label class="form-label" for="code">Enter your club code</label>
            <input class="field uppercase" id="code" maxlength="6" placeholder="e.g. STORM1" required />
            <button class="btn btn-primary" type="submit">Join club</button>
            <p class="text-xs text-mist-500">Parents get this from their club. Coaches and staff: your club adds your email — sign out and back in once they have.</p>
          </form>`;
        document.getElementById('join')!.addEventListener('submit', async (e) => {
          e.preventDefault();
          const code = (document.getElementById('code') as HTMLInputElement).value.trim().toUpperCase();
          const { data, error } = await supabase.rpc('join_club', { p_code: code });
          if (error) return toast(errMsg(error), 'err');
          setActiveClub(data as string);
          location.href = '/family';
        });
        return;
      }
      const blurbs: Record<string, string> = {
        hq: 'Every club on Ignyte — create clubs, invite owners, see activity.',
        club: 'Schedule, people, money and settings for your club.',
        coach: 'Your availability, today\'s lessons, notes and athlete progress.',
        family: 'Book lessons, see progress and coach notes for your athletes.',
        me: 'Your own lessons, goals and skill journey.',
      };
      content.innerHTML = `
        <h1 class="text-2xl">Hi ${esc(ctx.profile.full_name.split(' ')[0])} 👋</h1>
        <p class="text-sm text-mist-400 mt-1">${ctx.club ? `You have a few hats at <b>${esc(ctx.club.name)}</b>. Where to?` : 'Where to?'}</p>
        <div class="grid gap-3 mt-5">
          ${portals.map((p) => `
            <a href="${p.href}" class="surface-card p-5 flex items-center gap-4 hover:border-ignite-500/60 transition-colors">
              <span class="text-2xl">${p.label.slice(0, 2)}</span>
              <span><span class="font-display font-semibold block">${p.label.slice(2).trim()}</span>
              <span class="text-xs text-mist-400">${blurbs[p.key]}</span></span>
            </a>`).join('')}
        </div>`;
    })().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
