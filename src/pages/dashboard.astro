---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Dashboard">
  <div id="dash" class="animate-fade">
    <p class="text-mist-500 text-sm">Loading…</p>
  </div>

  <script>
    import { supabase } from '../lib/supabase';
    import { requireAuth, todayISO, myAthletes, fmtDate, fmtTime, esc, toast, errMsg } from '../lib/app';

    const dash = document.getElementById('dash')!;

    async function render() {
      const ctx = await requireAuth('any');
      const club = ctx.club!;
      const role = club.role === 'owner' ? 'admin' : club.role;
      const today = todayISO();
      const firstName = ctx.profile.full_name.split(' ')[0];

      let html = `
        <p class="eyebrow">${esc(club.name)}</p>
        <h1 class="text-2xl mt-1 mb-6">Hey, ${esc(firstName)} 👋</h1>`;

      if (role === 'parent' || role === 'athlete') {
        const athletes = (await myAthletes(club.id)).filter((a) => a.enrolled);
        const athleteIds = athletes.map((a) => a.id);

        const progressMap = new Map<string, { pct: number; mastered: number; working: number }>();
        if (athleteIds.length) {
          const [{ count: totalSkills }, { data: statuses }, { data: clubSkills }] = await Promise.all([
            supabase.from('skills').select('*', { count: 'exact', head: true }).eq('club_id', club.id),
            supabase.from('athlete_skills').select('athlete_id, status, skill_id').in('athlete_id', athleteIds),
            supabase.from('skills').select('id').eq('club_id', club.id),
          ]);
          // only THIS club's skills count — multi-club athletes carry other clubs' rows
          const clubSkillIds = new Set((clubSkills ?? []).map((s) => s.id));
          for (const id of athleteIds) {
            const mine = (statuses ?? []).filter((s) => s.athlete_id === id && clubSkillIds.has(s.skill_id));
            const done = mine.filter((s) => s.status === 'achieved' || s.status === 'mastered').length;
            progressMap.set(id, {
              pct: totalSkills ? Math.round((done / totalSkills) * 100) : 0,
              mastered: mine.filter((s) => s.status === 'mastered').length,
              working: mine.filter((s) => s.status === 'working_on').length,
            });
          }
        }

        const { data: ledger } = await supabase
          .from('credit_ledger')
          .select('delta')
          .eq('club_id', club.id)
          .eq('profile_id', ctx.profile.id);
        const credits = (ledger ?? []).reduce((s, r) => s + r.delta, 0);
        if (credits > 0) {
          html += `<div class="mb-4"><span class="pill pill-accent">💳 ${credits} lesson credit${credits === 1 ? '' : 's'} at ${esc(club.name)} — used automatically when you book</span></div>`;
        }

        const { data: bookings } = athleteIds.length
          ? await supabase
              .from('bookings')
              .select('*, slots(slot_date, start_time, end_time), profiles!bookings_coach_id_fkey(full_name), athletes(name)')
              .eq('club_id', club.id)
              .in('athlete_id', athleteIds)
              .eq('status', 'booked')
              .gte('slots.slot_date', today)
          : { data: [] };
        const upcoming = (bookings ?? [])
          .filter((b) => b.slots)
          .sort((a, b) => (a.slots.slot_date + a.slots.start_time).localeCompare(b.slots.slot_date + b.slots.start_time))
          .slice(0, 5);

        const { data: offers } = athleteIds.length
          ? await supabase
              .from('waitlist')
              .select('*, slots(slot_date, start_time), athletes(name)')
              .eq('club_id', club.id)
              .in('athlete_id', athleteIds)
              .eq('status', 'offered')
          : { data: [] };

        if ((offers ?? []).length) {
          html += `<div class="surface-card p-5 mb-5 border-ignite-500/40" style="box-shadow: var(--shadow-glow)">
            <h2 class="text-base font-semibold text-ignite-400">🎉 A space has opened up!</h2>
            ${(offers ?? [])
              .map(
                (o) => `
              <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
                <p class="text-sm">${esc(o.athletes?.name)} — ${fmtDate(o.slots.slot_date)} at ${fmtTime(o.slots.start_time)}</p>
                <a href="/bookings" class="btn btn-primary btn-sm">Respond</a>
              </div>`
              )
              .join('')}
          </div>`;
        }

        html += `<div class="grid gap-4 sm:grid-cols-2">
          <div class="surface-card p-5">
            <h2 class="text-base font-semibold mb-3">Next lessons</h2>
            ${
              upcoming.length
                ? upcoming
                    .map(
                      (b) => `
                <div class="py-2.5 border-t border-ink-700 first:border-0 flex items-center justify-between gap-2">
                  <div>
                    <p class="text-sm font-medium">${fmtDate(b.slots.slot_date)} · ${fmtTime(b.slots.start_time)}</p>
                    <p class="text-xs text-mist-400 mt-0.5">${esc(b.athletes?.name)} with ${esc(b.profiles?.full_name)}</p>
                  </div>
                  ${b.series_booking_id ? '<span class="pill pill-accent">Weekly</span>' : ''}
                </div>`
                    )
                    .join('')
                : '<p class="text-sm text-mist-500">No lessons booked yet.</p>'
            }
            <a href="/book" class="btn btn-primary btn-sm mt-4">Book a lesson</a>
          </div>

          <div class="surface-card p-5">
            <h2 class="text-base font-semibold mb-3">${role === 'parent' ? 'Your athletes' : 'Your progression'}</h2>
            ${
              athletes.length
                ? athletes
                    .map((a) => {
                      const p = progressMap.get(a.id) ?? { pct: 0, mastered: 0, working: 0 };
                      return `
                <div class="py-3 border-t border-ink-700 first:border-0">
                  <div class="flex items-center justify-between gap-2">
                    <p class="text-sm font-medium">${esc(a.name)}</p>
                    <a class="btn btn-ghost btn-sm" href="/progress?athlete=${a.id}">Journey →</a>
                  </div>
                  <div class="mt-2 flex items-center gap-2.5">
                    <div class="progress-track flex-1"><div class="progress-fill" style="width:${p.pct}%"></div></div>
                    <span class="text-xs font-display font-bold ignite-text">${p.pct}%</span>
                  </div>
                  <p class="text-[0.68rem] text-mist-500 mt-1">🔥 ${p.mastered} mastered · 💪 ${p.working} in training</p>
                </div>`;
                    })
                    .join('')
                : `<p class="text-sm text-mist-500">${role === 'parent' ? `No athletes at ${esc(club.name)} yet — add or enrol one.` : 'No athlete record found.'}</p>`
            }
            ${role === 'parent' ? '<a href="/athletes" class="btn btn-ghost btn-sm mt-4">Manage athletes</a>' : ''}
          </div>
        </div>`;
      }

      if (role === 'coach') {
        const { data: myLessons } = await supabase
          .from('bookings')
          .select('*, slots(slot_date, start_time, end_time), athletes(name)')
          .eq('club_id', club.id)
          .eq('coach_id', ctx.profile.id)
          .eq('status', 'booked')
          .gte('slots.slot_date', today);
        const lessons = (myLessons ?? [])
          .filter((b) => b.slots)
          .sort((a, b) => (a.slots.slot_date + a.slots.start_time).localeCompare(b.slots.slot_date + b.slots.start_time));
        const todays = lessons.filter((b) => b.slots.slot_date === today);

        html += `<div class="grid gap-4 sm:grid-cols-2">
          <div class="surface-card p-5">
            <h2 class="text-base font-semibold mb-3">Today's lessons (${todays.length})</h2>
            ${
              todays.length
                ? todays
                    .map(
                      (b) => `
                  <div class="py-2.5 border-t border-ink-700 first:border-0 flex items-center justify-between gap-2">
                    <p class="text-sm font-medium">${fmtTime(b.slots.start_time)} — ${esc(b.athletes?.name)}</p>
                    ${
                      b.attendance
                        ? `<span class="pill ${b.attendance === 'present' ? 'pill-success' : 'pill-danger'}">${b.attendance}</span>`
                        : '<span class="pill pill-warn">Register due</span>'
                    }
                  </div>`
                    )
                    .join('')
                : '<p class="text-sm text-mist-500">Nothing today.</p>'
            }
            <a href="/coach" class="btn btn-primary btn-sm mt-4">Open coaching hub</a>
          </div>
          <div class="surface-card p-5">
            <h2 class="text-base font-semibold mb-3">Upcoming</h2>
            ${
              lessons.slice(0, 6).length
                ? lessons
                    .slice(0, 6)
                    .map((b) => `<div class="py-2 border-t border-ink-700 first:border-0"><p class="text-sm">${fmtDate(b.slots.slot_date)} · ${fmtTime(b.slots.start_time)} — ${esc(b.athletes?.name)}</p></div>`)
                    .join('')
                : '<p class="text-sm text-mist-500">No upcoming lessons.</p>'
            }
          </div>
        </div>`;
      }

      if (role === 'admin') {
        const [
          { data: summary },
          { count: pendingCount },
          { count: memberCount },
          { data: slotBoard },
          { data: classSessions },
          { data: settings },
        ] = await Promise.all([
          supabase.rpc('admin_money_summary', { p_club: club.id }),
          supabase.from('club_members').select('*', { count: 'exact', head: true }).eq('club_id', club.id).eq('status', 'pending'),
          supabase.from('club_members').select('*', { count: 'exact', head: true }).eq('club_id', club.id).eq('status', 'active'),
          supabase.rpc('get_slot_board', { p_club: club.id, p_from: today, p_to: today }),
          supabase
            .from('class_sessions')
            .select('id, start_time, end_time, class_groups(name)')
            .eq('club_id', club.id)
            .eq('session_date', today)
            .eq('cancelled', false),
          supabase.from('club_settings').select('currency').eq('club_id', club.id).single(),
        ]);
        const sym = settings?.currency ?? '£';
        const money = (n: unknown) => sym + Number(n ?? 0).toFixed(2);
        const s = (summary ?? {}) as { due?: number; overdue?: number; paid_30d?: number; debtors?: { name: string; owed: number; has_overdue: boolean }[] };
        const owed = Number(s.due ?? 0) + Number(s.overdue ?? 0);
        const overdueCount = (s.debtors ?? []).filter((d) => d.has_overdue).length;

        // ---- "Needs you" — only the things that actually need an action today
        const actions: string[] = [];
        if ((pendingCount ?? 0) > 0)
          actions.push(`<a href="/admin?tab=people" class="flex items-center justify-between gap-3 rounded-lg border border-ink-700 px-3 py-2.5">
            <span><b>${pendingCount}</b> join request${pendingCount === 1 ? '' : 's'} waiting</span>
            <span class="btn btn-primary btn-sm">Review →</span></a>`);
        if (overdueCount > 0)
          actions.push(`<a href="/admin/money" class="flex items-center justify-between gap-3 rounded-lg border border-ink-700 px-3 py-2.5">
            <span><b>${overdueCount}</b> famil${overdueCount === 1 ? 'y' : 'ies'} overdue · ${money(s.overdue)}</span>
            <span class="btn btn-primary btn-sm">Chase →</span></a>`);

        if (actions.length) {
          html += `<div class="surface-card p-5 mb-5 border-ignite-500/40" style="box-shadow: var(--shadow-glow)">
            <h2 class="text-base font-semibold text-ignite-400 mb-1">Needs you</h2>
            <div class="mt-2 flex flex-col gap-2">${actions.join('')}</div>
          </div>`;
        }

        // ---- On today — group classes and 1-2-1 privates in one list
        type TodayItem = { time: string; title: string; sub: string; href: string; kind: string };
        const items: TodayItem[] = [];
        for (const c of (classSessions ?? []) as unknown as { id: string; start_time: string; end_time: string; class_groups: { name: string } | null }[]) {
          items.push({ time: c.start_time, title: c.class_groups?.name ?? 'Class', sub: `${fmtTime(c.start_time)}–${fmtTime(c.end_time)} · group class`, href: '/admin/classes', kind: '🤸' });
        }
        for (const sl of (slotBoard ?? []) as { start_time: string; end_time: string; booked: number; capacity: number; coaches: { name: string }[] }[]) {
          items.push({ time: sl.start_time, title: `1-2-1 · ${fmtTime(sl.start_time)}`, sub: `${sl.booked}/${sl.capacity} booked${sl.coaches.length ? ' · ' + sl.coaches.map((c) => esc(c.name)).join(', ') : ''}`, href: '/admin?tab=bookings', kind: '⚡' });
        }
        items.sort((a, b) => a.time.localeCompare(b.time));

        html += `<div class="surface-card p-5 mb-5">
          <h2 class="text-base font-semibold mb-3">On today (${items.length})</h2>
          ${
            items.length
              ? items
                  .map(
                    (i) => `
              <a href="${i.href}" class="flex items-center justify-between gap-3 py-2.5 border-t border-ink-700 first:border-0 hover:text-ignite-400">
                <div><p class="text-sm font-medium">${i.kind} ${esc(i.title)}</p><p class="text-xs text-mist-500 mt-0.5">${i.sub}</p></div>
                <span class="text-xs text-mist-400">Register →</span>
              </a>`
                  )
                  .join('')
              : '<p class="text-sm text-mist-500">Nothing scheduled today. <a class="text-ignite-400" href="/admin/classes">Add a class</a> or <a class="text-ignite-400" href="/admin?tab=slots">private slots</a>.</p>'
          }
        </div>

        <div class="grid gap-4 grid-cols-3 mb-5">
          ${[
            ['Owed', money(owed), overdueCount ? `${money(s.overdue)} overdue` : 'up to date'],
            ['Collected (30d)', money(s.paid_30d), 'paid'],
            ['Members', String(memberCount ?? 0), 'active'],
          ]
            .map(
              ([label, big, sub]) => `
            <div class="surface-card p-4 text-center">
              <p class="text-xl sm:text-2xl font-display font-semibold ignite-text">${big}</p>
              <p class="text-[0.68rem] text-mist-400 mt-0.5">${label} · ${sub}</p>
            </div>`
            )
            .join('')}
        </div>

        <div class="flex flex-wrap gap-2">
          <a href="/admin/classes" class="btn btn-ghost btn-sm">＋ Class</a>
          <a href="/admin?tab=slots" class="btn btn-ghost btn-sm">＋ Private slots</a>
          <a href="/admin/money" class="btn btn-ghost btn-sm">＋ Invoice</a>
          <a href="/admin?tab=people" class="btn btn-ghost btn-sm">Invite people</a>
          <a href="/admin" class="btn btn-primary btn-sm ml-auto">Manage the club →</a>
        </div>`;
      }

      dash.innerHTML = html;
    }

    render().catch((e) => {
      if ((e as Error).message !== 'redirecting') toast(errMsg(e), 'err');
    });
  </script>
</AppLayout>
