---
/**
 * Shell for every page. Top bar = the public website nav (Home, About,
 * Pricing, Contact). Signed-in users get a hamburger that slides the app
 * drawer out from the left (Dashboard, Book, Bookings…), role-filtered.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import IgnyteMark from '../components/IgnyteMark.astro';

interface Props {
  title: string;
  /** Bare pages (login/signup/offline) hide the nav chrome. */
  chrome?: boolean;
}
const { title, chrome = true } = Astro.props;

const siteNav = [
  ['Home', '/'],
  ['About', '/about'],
  ['Pricing', '/pricing'],
  ['Contact', '/contact'],
];
const appNav: [string, string, string][] = [
  ['🏠 Dashboard', '/dashboard', 'parent,athlete,coach,admin,owner'],
  ['⚡ Book a lesson', '/book', 'parent,athlete'],
  ['🤸 Classes', '/classes', 'parent,athlete'],
  ['📅 My bookings', '/bookings', 'parent,athlete'],
  ['💳 Money', '/money', 'parent,athlete'],
  ['🛍️ Shop', '/shop', 'parent,athlete,coach'],
  ['🧒 Athletes', '/athletes', 'parent'],
  ['🔥 Skill journey', '/progress', 'parent,athlete'],
  ['📣 Coaching hub', '/coach', 'coach'],
  ['📋 Class registers', '/coach/classes', 'coach'],
  ['🛠️ Club admin', '/admin', 'admin,owner'],
  ['👑 Owner HQ', '/owner', 'owner'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Ignyte Club Manager</title>
    <meta name="description" content="Private lesson booking & skill progression for cheer tumble and all-star dance clubs." />
    <meta name="theme-color" content="#07070b" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body>
    <!-- Shared flame gradient used by every IgnyteMark on the page -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <linearGradient id="ignyte-flame-gradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffc23d"></stop>
          <stop offset="45%" stop-color="#ff6a1a"></stop>
          <stop offset="100%" stop-color="#ff1f8e"></stop>
        </linearGradient>
      </defs>
    </svg>

    <div
      id="offline-banner"
      class="hidden bg-charge-400/15 border-b border-charge-400/30 text-charge-400 text-center text-xs font-semibold py-1.5 px-4"
    >
      You're offline — showing your last-loaded info. Booking needs a connection.
    </div>

    {
      chrome && (
        <header class="sticky top-0 z-40 border-b border-ink-700 bg-ink-950/85 backdrop-blur-md">
          <div class="container-app flex h-16 items-center gap-2">
            <button
              id="drawer-btn"
              class="hidden rounded-lg border border-ink-600 p-2 text-mist-300 hover:text-ignite-400 hover:border-ignite-500"
              aria-label="Open app menu"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M3 6h18M3 12h18M3 18h18" />
              </svg>
            </button>
            <a href="/" class="flex items-center gap-2 shrink-0">
              <IgnyteMark size={26} />
              <span class="font-display font-semibold tracking-tight text-mist-100">
                Ignyte <span class="text-mist-400 font-normal hidden sm:inline">Club Manager</span>
              </span>
            </a>

            <nav class="ml-auto hidden md:flex items-center gap-1 text-sm">
              {siteNav.map(([label, href]) => (
                <a href={href} class="nav-link">{label}</a>
              ))}
            </nav>

            <div class="flex items-center gap-2 ml-auto md:ml-3">
              <a id="signin-link" href="/login" class="btn btn-primary btn-sm hidden">Sign in</a>
              <a id="openapp-link" href="/dashboard" class="btn btn-primary btn-sm hidden">Open app</a>
              <button
                id="notif-btn"
                class="relative hidden rounded-full border border-ink-600 p-2 text-mist-300 hover:text-ignite-400 hover:border-ignite-500 transition-colors"
                aria-label="Notifications"
              >
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
                  <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
                </svg>
                <span id="notif-dot" class="hidden absolute -top-0.5 -right-0.5 h-2.5 w-2.5 rounded-full bg-ignite-500 ring-2 ring-ink-950" />
              </button>
            </div>
          </div>

          <div
            id="notif-panel"
            class="hidden absolute right-3 top-[4.2rem] w-[min(92vw,22rem)] max-h-[70vh] overflow-y-auto surface-card p-2 z-50"
          >
            <p class="px-3 pt-2 pb-1 text-xs font-semibold uppercase tracking-widest text-mist-500">Notifications</p>
            <div id="notif-list" class="flex flex-col" />
          </div>
        </header>

        <div id="drawer-backdrop" class="hidden fixed inset-0 bg-black/60 z-40" />
        <aside
          id="app-drawer"
          class="fixed left-0 top-0 z-50 h-dvh w-72 border-r border-ink-700 bg-ink-900 p-4 flex flex-col gap-1"
        >
          <div class="flex items-center gap-2 px-2 pb-4 border-b border-ink-700 mb-2">
            <IgnyteMark size={24} />
            <span id="drawer-club" class="font-display font-semibold truncate">Your club</span>
            <button id="drawer-close" class="ml-auto btn btn-ghost btn-sm">✕</button>
          </div>
          <div id="club-switcher" class="hidden mb-2 pb-2 border-b border-ink-700">
            <p class="px-2 pb-1 text-[0.65rem] font-semibold uppercase tracking-widest text-mist-500">Your clubs</p>
            <div id="club-switcher-list"></div>
            <a href="/clubs" class="drawer-link text-mist-400">➕ Join or start a club</a>
          </div>
          {appNav.map(([label, href, roles]) => (
            <a data-roles={roles} href={href} class="drawer-link hidden">{label}</a>
          ))}
          <div class="mt-auto pt-4 border-t border-ink-700 flex flex-col gap-2">
            <button id="drawer-install" class="btn btn-ghost btn-sm hidden">📲 Install the app</button>
            <button id="signout-btn" class="btn btn-ghost btn-sm">Sign out</button>
          </div>
        </aside>
      )
    }

    <main class="container-app py-6 pb-24">
      <slot />
    </main>

    <div id="install-hint" class="hidden fixed bottom-4 inset-x-4 sm:left-auto sm:w-96 z-50 surface-card p-4">
      <div class="flex items-start gap-3">
        <IgnyteMark size={30} />
        <div class="flex-1">
          <p class="font-display font-semibold text-sm">Install Ignyte Club Manager</p>
          <p class="text-xs text-mist-400 mt-0.5">Add it to your home screen for quick booking &amp; offline access.</p>
          <div class="mt-2.5 flex gap-2">
            <button id="install-btn" class="btn btn-primary btn-sm">Install</button>
            <button id="install-dismiss" class="btn btn-ghost btn-sm">Not now</button>
          </div>
        </div>
      </div>
    </div>

    <style>
      .nav-link {
        padding: 0.4rem 0.7rem;
        border-radius: 999px;
        color: var(--color-mist-300);
        font-weight: 500;
        white-space: nowrap;
      }
      .nav-link:hover {
        color: var(--color-ignite-400);
        background: var(--color-ink-800);
      }
      .drawer-link {
        display: block;
        padding: 0.65rem 0.8rem;
        border-radius: 0.6rem;
        font-size: 0.92rem;
        font-weight: 500;
        color: var(--color-mist-200);
      }
      .drawer-link:hover {
        background: var(--color-ink-800);
        color: var(--color-ignite-400);
      }
      #app-drawer {
        transform: translateX(-100%);
        transition: transform 0.3s var(--ease-spring);
      }
      #app-drawer.open {
        transform: translateX(0);
      }
    </style>

    <script>
      import { supabase, supabaseConfigured } from '../lib/supabase';
      import { esc, fmtDateTime } from '../lib/app';

      // ------- offline banner -------
      const banner = document.getElementById('offline-banner');
      const syncOnline = () => banner?.classList.toggle('hidden', navigator.onLine);
      addEventListener('online', syncOnline);
      addEventListener('offline', syncOnline);
      syncOnline();

      // ------- service worker -------
      if ('serviceWorker' in navigator) {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }

      // ------- install prompt -------
      let deferredPrompt: Event | null = null;
      const hint = document.getElementById('install-hint');
      const installBtn = document.getElementById('install-btn');
      const drawerInstall = document.getElementById('drawer-install');
      const dismissed = () => localStorage.getItem('ignyte-install-dismissed') === '1';
      const standalone =
        matchMedia('(display-mode: standalone)').matches ||
        (navigator as unknown as { standalone?: boolean }).standalone === true;

      addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        drawerInstall?.classList.remove('hidden');
        if (!dismissed() && !standalone) hint?.classList.remove('hidden');
      });
      const doInstall = () => {
        hint?.classList.add('hidden');
        (deferredPrompt as unknown as { prompt: () => void } | null)?.prompt();
      };
      installBtn?.addEventListener('click', doInstall);
      drawerInstall?.addEventListener('click', doInstall);
      document.getElementById('install-dismiss')?.addEventListener('click', () => {
        localStorage.setItem('ignyte-install-dismissed', '1');
        hint?.classList.add('hidden');
      });
      const isIos = /iphone|ipad|ipod/i.test(navigator.userAgent);
      if (isIos && !standalone && !dismissed()) {
        setTimeout(() => {
          const body = hint?.querySelector('p.text-xs');
          if (body) body.textContent = 'Tap the Share button in Safari, then "Add to Home Screen".';
          installBtn?.classList.add('hidden');
          hint?.classList.remove('hidden');
        }, 2500);
      }

      // ------- drawer -------
      const drawer = document.getElementById('app-drawer');
      const backdrop = document.getElementById('drawer-backdrop');
      const setDrawer = (open: boolean) => {
        drawer?.classList.toggle('open', open);
        backdrop?.classList.toggle('hidden', !open);
      };
      document.getElementById('drawer-btn')?.addEventListener('click', () => setDrawer(true));
      document.getElementById('drawer-close')?.addEventListener('click', () => setDrawer(false));
      backdrop?.addEventListener('click', () => setDrawer(false));

      // ------- auth-aware chrome + notifications -------
      if (document.getElementById('drawer-btn') && supabaseConfigured) {
        (async () => {
          const { data } = await supabase.auth.getSession();
          if (!data.session) {
            document.getElementById('signin-link')?.classList.remove('hidden');
            return;
          }
          const uid = data.session.user.id;
          const [{ data: profile }, { data: mships }] = await Promise.all([
            supabase.from('profiles').select('role, last_club_id').eq('id', uid).single(),
            supabase
              .from('club_members')
              .select('club_id, role, status, clubs(id, name, slug, status, plan, logo_path, accent_color)')
              .eq('profile_id', uid),
          ]);
          const isOwner = profile?.role === 'owner';
          type M = { club_id: string; role: string; status: string; clubs: { name: string; status: string; plan: string; accent_color: string | null } };
          const usable = ((mships ?? []) as unknown as M[]).filter(
            (m) => m.status === 'active' && m.clubs?.status === 'active'
          );
          const stored = localStorage.getItem('icm-active-club');
          const active =
            usable.find((m) => m.club_id === stored) ??
            usable.find((m) => m.club_id === profile?.last_club_id) ??
            (usable.length === 1 ? usable[0] : undefined);

          // role for nav = role in active club ('owner' opens everything)
          const role = isOwner ? 'owner' : (active?.role ?? (usable.length ? 'parent' : 'none'));

          // club branding in chrome
          const drawerClub = document.getElementById('drawer-club');
          if (active && drawerClub) drawerClub.textContent = active.clubs.name;
          if (active?.clubs.accent_color && active.clubs.plan !== 'free') {
            const root = document.documentElement;
            root.style.setProperty('--color-ignite-500', active.clubs.accent_color);
            root.style.setProperty('--color-ignite-600', active.clubs.accent_color);
            root.style.setProperty('--color-ignite-400', active.clubs.accent_color);
          }

          // switcher (2+ clubs, or owner)
          const switcher = document.getElementById('club-switcher');
          const swList = document.getElementById('club-switcher-list');
          if (switcher && swList && (usable.length > 1 || (isOwner && usable.length > 0))) {
            switcher.classList.remove('hidden');
            swList.innerHTML = usable
              .map(
                (m) => `
              <button data-switch="${m.club_id}" class="drawer-link w-full text-left ${m.club_id === active?.club_id ? 'text-ignite-400' : ''}">
                ${m.clubs.name} <span class="text-[0.65rem] text-mist-500">· ${m.role}</span>
              </button>`
              )
              .join('');
            swList.querySelectorAll<HTMLButtonElement>('[data-switch]').forEach((b) =>
              b.addEventListener('click', async () => {
                localStorage.setItem('icm-active-club', b.dataset.switch!);
                await supabase.from('profiles').update({ last_club_id: b.dataset.switch }).eq('id', uid);
                if ('caches' in window) {
                  const keys = await caches.keys();
                  await Promise.all(keys.filter((k) => k.startsWith('ignyte-data')).map((k) => caches.delete(k)));
                }
                location.href = '/dashboard';
              })
            );
          }

          document.getElementById('drawer-btn')?.classList.remove('hidden');
          document.getElementById('openapp-link')?.classList.remove('hidden');
          document.getElementById('notif-btn')?.classList.remove('hidden');
          drawer?.querySelectorAll<HTMLElement>('[data-roles]').forEach((el) => {
            const roles = (el.dataset.roles ?? '').split(',');
            if (roles.includes(role) || (role === 'owner' && !roles.includes('owner-only-never'))) {
              el.classList.remove('hidden');
            }
          });

          document.getElementById('signout-btn')?.addEventListener('click', async () => {
            await supabase.auth.signOut();
            location.href = '/';
          });

          // Notifications
          const dot = document.getElementById('notif-dot');
          const panel = document.getElementById('notif-panel');
          const list = document.getElementById('notif-list');
          const loadNotifs = async () => {
            const { data: notifs } = await supabase
              .from('notifications')
              .select('*')
              .order('created_at', { ascending: false })
              .limit(20);
            if (!notifs) return;
            dot?.classList.toggle('hidden', !notifs.some((n) => !n.read));
            if (list) {
              list.innerHTML = notifs.length
                ? notifs
                    .map(
                      (n) => `
                  <div class="px-3 py-2.5 rounded-lg hover:bg-ink-800 ${n.read ? 'opacity-60' : ''}">
                    <p class="text-sm font-semibold">${esc(n.title)}</p>
                    <p class="text-xs text-mist-400 mt-0.5">${esc(n.body)}</p>
                    <p class="text-[0.65rem] text-mist-500 mt-1">${fmtDateTime(n.created_at)}</p>
                  </div>`
                    )
                    .join('')
                : '<p class="px-3 py-4 text-sm text-mist-500">Nothing yet.</p>';
            }
          };
          loadNotifs();

          document.getElementById('notif-btn')?.addEventListener('click', async () => {
            const opening = panel?.classList.contains('hidden');
            panel?.classList.toggle('hidden');
            if (opening) {
              await loadNotifs();
              await supabase.from('notifications').update({ read: true }).eq('read', false);
              dot?.classList.add('hidden');
            }
          });
          document.addEventListener('click', (e) => {
            if (
              !panel?.classList.contains('hidden') &&
              !panel?.contains(e.target as Node) &&
              !document.getElementById('notif-btn')?.contains(e.target as Node)
            )
              panel?.classList.add('hidden');
          });
        })();
      }
    </script>
  </body>
</html>
