---
/**
 * Shell for every page: brand, the club you're working in, one chip per
 * portal you have access to (Ignyte HQ · Club · Coach · Family · Me), sign out.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import IgnyteMark from '../components/IgnyteMark.astro';

interface Props {
  title: string;
  /** Bare pages (sign in / sign up / offline) hide the chrome. */
  chrome?: boolean;
}
const { title, chrome = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Ignyte 1-2-1</title>
    <meta name="description" content="Private 1-2-1 lesson booking, coach notes and skill progress for cheer & dance clubs." />
    <meta name="theme-color" content="#07070b" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <linearGradient id="ignyte-flame-gradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffc23d"></stop>
          <stop offset="45%" stop-color="#ff6a1a"></stop>
          <stop offset="100%" stop-color="#ff1f8e"></stop>
        </linearGradient>
      </defs>
    </svg>

    <div id="offline-banner" class="hidden bg-charge-400/15 border-b border-charge-400/30 text-charge-400 text-center text-xs font-semibold py-1.5 px-4">
      You're offline — showing what loaded last. Booking needs a connection.
    </div>

    {
      chrome && (
        <header class="sticky top-0 z-40 border-b border-ink-700 bg-ink-950/85 backdrop-blur-md">
          <div class="container-app flex h-14 items-center gap-3">
            <a href="/dashboard" class="flex items-center gap-2 shrink-0">
              <IgnyteMark size={24} />
              <span class="font-display font-semibold tracking-tight text-mist-100 hidden sm:inline">Ignyte <span class="text-mist-400 font-normal">1-2-1</span></span>
            </a>
            <span id="chrome-club" class="text-sm text-mist-300 truncate min-w-0" />
            <nav id="portal-nav" class="ml-auto flex items-center gap-1 overflow-x-auto text-sm" />
            <button id="signout-btn" class="btn btn-ghost btn-sm hidden shrink-0" title="Sign out">⎋</button>
          </div>
          <div id="switcher" class="hidden border-t border-ink-700 bg-ink-900/95">
            <div class="container-app py-1.5 flex flex-wrap items-center gap-2 text-xs">
              <span class="text-mist-500">Your clubs:</span>
              <span id="switcher-list" class="flex flex-wrap gap-1.5" />
            </div>
          </div>
        </header>
      )
    }

    <main class="container-app py-6 pb-24">
      <slot />
    </main>

    <style>
      .portal-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        border: 1px solid var(--color-ink-600);
        color: var(--color-mist-300);
        font-weight: 500;
        white-space: nowrap;
        font-size: 0.8rem;
      }
      .portal-chip:hover { color: var(--color-ignite-400); border-color: var(--color-ignite-500); }
      .portal-chip.active { background: var(--color-ignite-500); color: #fff; border-color: var(--color-ignite-500); }
      #portal-nav::-webkit-scrollbar { display: none; }
    </style>

    <script>
      import { supabase, supabaseConfigured } from '../lib/supabase';
      import { loadCtx, portalsFor, setActiveClub, esc } from '../lib/app';

      const banner = document.getElementById('offline-banner');
      const syncOnline = () => banner?.classList.toggle('hidden', navigator.onLine);
      addEventListener('online', syncOnline);
      addEventListener('offline', syncOnline);
      syncOnline();
      if ('serviceWorker' in navigator) addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));

      const nav = document.getElementById('portal-nav');
      if (nav && supabaseConfigured) {
        (async () => {
          const ctx = await loadCtx();
          if (!ctx) return;
          const club = ctx.club;
          const clubEl = document.getElementById('chrome-club');
          if (clubEl) clubEl.textContent = club ? club.name : ctx.profile.is_platform_owner ? 'Ignyte HQ' : '';
          const portals = portalsFor(club, ctx.profile.is_platform_owner);
          const here = location.pathname.replace(/\/$/, '') || '/';
          nav.innerHTML = portals
            .map((p) => `<a href="${p.href}" class="portal-chip ${here === p.href || (p.href !== '/hq' && here.startsWith(p.href + '/')) ? 'active' : ''}">${p.label}</a>`)
            .join('');
          const so = document.getElementById('signout-btn');
          so?.classList.remove('hidden');
          so?.addEventListener('click', async () => {
            await supabase.auth.signOut();
            localStorage.removeItem('ignyte-club');
            location.href = '/';
          });
          if (ctx.clubs.length > 1) {
            const sw = document.getElementById('switcher');
            const list = document.getElementById('switcher-list');
            sw?.classList.remove('hidden');
            if (list) {
              list.innerHTML = ctx.clubs
                .map((c) => `<button data-club="${c.id}" class="portal-chip ${c.id === club?.id ? 'active' : ''}">${esc(c.name)}</button>`)
                .join('');
              list.querySelectorAll<HTMLButtonElement>('[data-club]').forEach((b) =>
                b.addEventListener('click', () => {
                  setActiveClub(b.dataset.club!);
                  location.href = '/dashboard';
                })
              );
            }
          }
        })();
      }
    </script>
  </body>
</html>
