---
/**
 * The Ignyte Club Manager brand mark — a calendar tile with a lightning bolt
 * struck through it (bookings + Ignyte energy), plus a small spark at the
 * corner. Same ink/ignite palette as the wider Ignyte family, deliberately
 * distinct from the Cheer & Dance flame: same umbrella, separate company.
 *
 * Uses the shared vertical flame gradient defined once in AppLayout
 * (#ignyte-flame-gradient: amber → orange → magenta). Pass gradient={false}
 * for a flat currentColor version and ember={false} to drop the spark.
 */
interface Props {
  class?: string;
  size?: number;
  gradient?: boolean;
  ember?: boolean;
}
const { class: className = '', size = 28, gradient = true, ember = true } = Astro.props;

// Geometry in a 0..100 box (kept in sync with scripts/generate-icons.mjs).
// Calendar body with the bolt as a true hole (fill-rule evenodd).
const BODY =
  'M26 20 H74 A16 16 0 0 1 90 36 V74 A16 16 0 0 1 74 90 H26 A16 16 0 0 1 10 74 V36 A16 16 0 0 1 26 20 Z';
const BOLT = 'M57 28 L35 60 L49 60 L43 84 L67 50 L53 50 Z';
// Binder rings overlap the body top so they read as one shape.
const RINGS =
  'M28 8 h6 a5 5 0 0 1 5 5 v6 a5 5 0 0 1 -5 5 h-6 a5 5 0 0 1 -5 -5 v-6 a5 5 0 0 1 5 -5 Z ' +
  'M66 8 h6 a5 5 0 0 1 5 5 v6 a5 5 0 0 1 -5 5 h-6 a5 5 0 0 1 -5 -5 v-6 a5 5 0 0 1 5 -5 Z';
// A little spark flicking off the top-right corner.
const SPARK = 'M91 4 L94 10.5 L91 17 L88 10.5 Z';
const fill = gradient ? 'url(#ignyte-flame-gradient)' : 'currentColor';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 100 100"
  class={className}
  aria-hidden="true"
  role="presentation"
>
  <path d={RINGS} fill={fill}></path>
  <path d={`${BODY} ${BOLT}`} fill-rule="evenodd" fill={fill}></path>
  {ember && <path d={SPARK} fill={fill} />}
</svg>
